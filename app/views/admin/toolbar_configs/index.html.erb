<div class="<%= style_main_header_container %>">
  <h1 class="<%= style_main_header %>">
    Configurazione Menu
  </h1>
</div>

<section class="<%= style_main_cnt %>">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg inline-block"><%= alert %></p>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <% @sections.each do |section| %>
      <div class="<%= style_main_card %>">
        <h3 class="<%= style_main_card_header %>">
          <span class="material-symbols-outlined"><%= section[:items].first&.dig(:icon) || 'menu' %></span>
          <%= section[:label] %>
        </h3>

        <div class="divide-y divide-slate-100 dark:divide-slate-700">
          <% section[:items].each do |item| %>
            <%= form_with url: admin_toolbar_config_path(item[:config_id]), method: :patch, data: { turbo_frame: "_top" }, class: "flex items-center justify-between py-2.5 px-1" do |f| %>
              <div class="flex items-center gap-3 min-w-0">
                <% if item[:icon] %>
                  <span class="material-symbols-outlined text-base text-slate-400 flex-shrink-0"><%= item[:icon] %></span>
                <% end %>
                <span class="text-sm text-slate-700 dark:text-slate-300"><%= item[:label] %></span>
                <% if item[:type] == :action %>
                  <span class="text-[10px] bg-accent/10 text-accent px-1.5 py-0.5 rounded-sm font-medium">azione</span>
                <% end %>
                <% if item[:custom] %>
                  <span class="text-[10px] bg-emerald-100 text-emerald-600 px-1.5 py-0.5 rounded-sm font-medium">custom</span>
                <% end %>
              </div>
              <div class="flex items-center gap-1">
                <label class="relative inline-flex items-center cursor-pointer">
                  <%= f.check_box :visible, checked: item[:visible], class: "sr-only peer",
                        onchange: "this.form.requestSubmit()" %>
                  <div class="w-9 h-5 bg-slate-300 dark:bg-slate-600 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-accent"></div>
                </label>
                <% if item[:custom] %>
                  <%= button_to admin_toolbar_config_path(item[:config_id]), method: :delete,
                        data: { turbo_confirm: "Rimuovere '#{item[:label]}'?" },
                        class: "p-1.5 text-slate-300 hover:text-red-500 rounded-sm hover:bg-slate-100 transition-colors" do %>
                    <span class="material-symbols-outlined text-sm">delete</span>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>

        <%# Add new custom item form %>
        <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-600">
          <details class="group">
            <summary class="text-xs text-slate-400 hover:text-accent cursor-pointer font-medium flex items-center gap-1 list-none">
              <span class="material-symbols-outlined text-sm">add_circle</span>
              Aggiungi voce personalizzata
            </summary>
            <%= form_with model: @new_config, url: admin_toolbar_configs_path, data: { turbo_frame: "_top" }, class: "mt-3 space-y-2" do |f| %>
              <%= f.hidden_field :section, value: section[:key] %>
              <div>
                <%= f.label :item_label, "Nome", class: "text-[10px] text-slate-500 uppercase tracking-wide block mb-0.5" %>
                <%= f.text_field :item_label, required: true, placeholder: "es. Report vendite", class: "w-full border border-slate-200 outline-none px-2 py-1 text-xs" %>
              </div>
              <div>
                <%= f.label :path, "Percorso", class: "text-[10px] text-slate-500 uppercase tracking-wide block mb-0.5" %>
                <%= f.text_field :path, required: true, placeholder: "es. /reports/sales", list: "path-suggestions", autocomplete: "off", class: "w-full border border-slate-200 outline-none px-2 py-1 text-xs" %>
                <datalist id="path-suggestions">
                  <% @suggested_paths.each do |p| %>
                    <option value="<%= p %>">
                  <% end %>
                </datalist>
              </div>
              <div class="flex gap-2">
                <div class="flex-1">
                  <%= f.label :icon, "Icona", class: "text-[10px] text-slate-500 uppercase tracking-wide block mb-0.5" %>
                  <%= f.text_field :icon, placeholder: "es. bar_chart", class: "w-full border border-slate-200 outline-none px-2 py-1 text-xs" %>
                </div>
                <div class="w-16">
                  <%= f.label :position, "Ordine", class: "text-[10px] text-slate-500 uppercase tracking-wide block mb-0.5" %>
                  <%= f.number_field :position, value: 0, class: "w-full border border-slate-200 outline-none px-2 py-1 text-xs" %>
                </div>
              </div>
              <%= f.submit "Aggiungi", class: "w-full py-1.5 bg-accent text-white text-xs font-medium rounded-sm cursor-pointer hover:opacity-90 transition" %>
            <% end %>
          </details>
        </div>
      </div>
    <% end %>
  </div>
</section>
