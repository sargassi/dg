<%# Mobile wizard location step — QR button inline with Magazzino/Ubica selects.
   # Once completed it collapses into a summary card (still visible on the page).
   # locals:
   #   step: step number label (e.g. "1")
   #   title: heading (e.g. "Dove")
   #   icon: material symbol name
   #   icon_class: text color for the icon
   #   container_class: card background color
   #   scan_btn_class: scan button background color
   #   wh_name / loc_name: select field names (default_/source_/dest_)
   #   target_prefix: defaults target prefix ("da"/"a"/nil)
   #   skip_propagate: bool (for the "A" step)
   #   default_wh / default_loc: preselected values
   #   show_back: bool %>
<div data-mobile-wizard-target="step" data-controller="defaults"
     <%= 'data-defaults-skip-propagate="true"' if skip_propagate %>
     <%= "data-defaults-target-prefix=\"#{target_prefix}\"" if target_prefix %>
     class="<%= container_class %> rounded-lg p-4 space-y-4">
  <div class="flex items-center gap-2">
    <span class="material-symbols-outlined text-xl <%= icon_class %>"><%= icon %></span>
    <span class="text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wide"><%= step %>. <%= title %></span>
  </div>

  <%# Collapsed summary (shown once the step is completed) %>
  <div data-mobile-wizard-target="stepSummary"
       class="hidden flex items-center justify-between gap-2 text-sm">
    <div class="min-w-0">
      <span data-mobile-wizard-target="summaryWh" class="font-semibold text-slate-800 dark:text-slate-100"></span>
      <span data-mobile-wizard-target="summaryLoc" class="text-slate-500 dark:text-slate-300"></span>
    </div>
    <button type="button" data-action="mobile-wizard#editStep"
            class="flex-shrink-0 w-9 h-9 flex items-center justify-center rounded-full bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-200 cursor-pointer"
            title="Modifica">
      <span class="material-symbols-outlined text-base">edit</span>
    </button>
  </div>

  <%# Active controls (full form) %>
  <div data-mobile-wizard-target="stepControls" class="space-y-4">
    <div class="flex items-start gap-2">
      <div class="flex flex-col items-center">
        <label class="text-xs text-slate-400 uppercase tracking-wide block mb-1">Dove</label>
        <button type="button" data-action="click->qr-scanner#scanWarehouseLoc"
                data-qr-label="<%= title %>"
                class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-lg <%= scan_btn_class %> text-white cursor-pointer"
                title="Scansiona QR">
          <span class="material-symbols-outlined text-lg">qr_code_scanner</span>
        </button>
      </div>
      <div class="flex-1 min-w-0">
        <label class="text-xs text-slate-400 uppercase tracking-wide block mb-1">Magazzino</label>
        <select name="<%= wh_name %>" data-defaults-target="warehouse" class="w-full border border-slate-300 outline-none px-3 py-3 text-sm bg-white rounded-lg">
          <option value="">Seleziona magazzino</option>
          <% @warehouses.each do |w| %>
            <option value="<%= w.id %>" <%= 'selected' if default_wh.to_s == w.id.to_s %>><%= w.code %></option>
          <% end %>
        </select>
      </div>
      <div class="flex-1 min-w-0">
        <label class="text-xs text-slate-400 uppercase tracking-wide block mb-1">Ubica</label>
        <select name="<%= loc_name %>" data-defaults-target="location" data-action="change->defaults#propagate" class="w-full border border-slate-300 outline-none px-3 py-3 text-sm bg-white rounded-lg" disabled>
          <option value="">Seleziona prima il magazzino</option>
          <% @locations.each do |l| %>
            <option value="<%= l.id %>" data-warehouse-id="<%= l.warehouse_id %>" <%= 'selected' if default_loc.to_s == l.id.to_s %>><%= l.code %></option>
          <% end %>
        </select>
      </div>
    </div>

    <div class="flex gap-2">
      <% if show_back %>
        <button type="button" data-action="mobile-wizard#back" class="w-1/3 py-3 rounded-lg bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-sm font-semibold cursor-pointer">
          Indietro
        </button>
      <% end %>
      <% if local_assigns[:final_label] %>
        <%= form.button final_label, class: "#{show_back ? 'flex-1' : 'w-full'} py-3 rounded-lg #{style_save_button} text-sm font-semibold cursor-pointer" %>
      <% else %>
        <button type="button" data-action="mobile-wizard#next" class="<%= show_back ? 'flex-1' : 'w-full' %> py-3 rounded-lg bg-slate-800 hover:bg-slate-900 text-white text-sm font-semibold flex items-center justify-center gap-2 cursor-pointer">
          Avanti
          <span class="material-symbols-outlined text-lg">arrow_forward</span>
        </button>
      <% end %>
    </div>
  </div>
</div>
