<tr data-nested-form-target="row">
  <td class="<%= style_table_td %> p-2 relative" data-controller="autocomplete"
      data-autocomplete-url-value="<%= autocomplete_inventories_path %>">
    <%= f.hidden_field :_destroy, value: "0" %>
    <%= f.hidden_field :item_id, data: { autocomplete_target: "hidden" } %>
    <%= f.hidden_field :collection_id, data: { autocomplete_target: "collectionId" } %>
    <%= f.hidden_field :operationtype_id, value: 2 %>
    <%= f.hidden_field :warehouse_id %>
    <%= f.hidden_field :location_id %>
    <div class="flex items-center gap-1">
      <button type="button"
              data-action="click->qr-scanner#scanRow"
              class="flex-shrink-0 w-10 h-10 flex items-center justify-center border border-transparent rounded-md bg-red-500 text-white hover:bg-red-600"
              title="Scansiona QR">
        <span class="material-symbols-outlined text-lg">qr_code_scanner</span>
      </button>
      <%= f.text_field :itemcode,
            data: { autocomplete_target: "input", qr_scanner_target: "input", action: "input->autocomplete#search blur->autocomplete#hideResults" },
            class: "w-full px-2 py-2 mt-0.5 text-xs border border-slate-300 outline-none focus:border-accent rounded-sm font-mono tracking-wider",
            autocomplete: "off",
            placeholder: "Codice articolo..." %>
    </div>
    <ul data-autocomplete-target="results"
        class="hidden absolute left-0 right-0 top-full mt-0.5 bg-white border border-slate-200 rounded-sm shadow-lg z-50 max-h-48 overflow-y-auto text-sm"></ul>
    <div class="flex gap-4 text-xs text-slate-500 mt-2 ml-12">
      <span><span class="font-medium text-slate-400">Mag:</span> <span class="wh-display font-medium">—</span></span>
      <span><span class="font-medium text-slate-400">Ubica:</span> <span class="loc-display font-medium">—</span></span>
    </div>
  </td>
  <td class="<%= style_table_td %> p-0.5 w-16">
    <%= f.number_field :qty, value: 1, min: 1, class: "w-full px-2 py-2 text-sm border border-slate-300 outline-none focus:border-accent rounded-sm text-center" %>
  </td>
  <td class="<%= style_table_td %> p-0.5 text-center w-10">
    <button type="button"
            data-action="nested-form#remove"
            class="text-red-500 hover:text-red-700 p-1">
      <span class="material-symbols-outlined text-lg">delete</span>
    </button>
  </td>
</tr>
