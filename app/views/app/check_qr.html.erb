<%= turbo_frame_tag 'success' do %>
<% alert = 'bg-red-400 text-white border border-red-400' %>
  <% alert = 'bg-green-600 text-white' if @output != 'xxx' %>
  <div class="mx-auto cont <%= alert %> shadow-lg">
  <table class="table w-full <%= alert %>">
    <tr>
    <th class="<%= style_table_th %> text-slate-800 border">
        Code
    </th>
    <th class="<%= style_table_th %> text-slate-800 border">
      Desc
    </th>
    <th class="<%= style_table_th %> text-slate-800 border">
        Cliente
    </th>
    <th class="<%= style_table_th %> text-slate-800 border">
        Note
    </th>
    <th class="<%= style_table_th %> text-slate-800 border">
        Status
    </th>
    </tr>
<% if @rows.size > 0 %>
  <% @rows.each do |x| %>
      <tr>
          <td class="<%= style_table_td %> bg-white text-slate-900 text-start font-normal">
              <%= comp_code(x.itemcode, x.fabricode, x.varcode) %>
          </td>
          <td class="<%= style_table_td %> bg-white text-slate-900 text-start font-normal">
              <%= x.description %>

          </td>
          <td class="<%= style_table_td %> bg-white text-slate-900 text-start font-normal">
              <%= x.code %>

          </td>
          <td class="<%= style_table_td %> bg-white text-slate-900 text-start font-normal">
              <%= x.note %>

          </td>
          <td class="<%= style_table_td %> <%= alert %> text-slate-900 text-start font-normal ">
            <% if @output != 'xxx' %>
              <span class="material-symbols-outlined  w-full text-center text-white font-bold">
              check_circle
              </span>
              <% else %>
              <span class="material-symbols-outlined  w-full text-center text-white font-bold">
              error
              </span>
              <% end %>
          </td>
      </tr>
  <% end %>
  <% end %>
  <tr>
      <td class="<%= style_table_td %> bg-white text-slate-900 text-start font-normal pt-16" colspan="5">
        <%= link_to app_sez_path(:place => @sez), class: style_main_btn, data: {turbo_frame: '_top'} do %>
            <span class="material-symbols-outlined">
            keyboard_return
            </span>
        <% end %>
      </td>
  </tr>
  </table>
  </div>
<% end %>
