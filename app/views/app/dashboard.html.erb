<% content_for :page_header do %>
  <%= render "application/breadcrumb", dashboard_path: app_dashboard_path, section_name: "App" %>
<% end %>

<section class="<%= style_main_cnt %> pt-8 space-y-8">
  <div class="flex items-center gap-2">
    <span class="material-symbols-outlined text-2xl text-slate-500">warehouse</span>
    <span class="text-xl font-semibold text-slate-800">Magazzino</span>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <%= link_to app_mobile_in_path, class: "bg-blue-50 p-4 card flex flex-col items-center justify-center text-center aspect-square shadow-md hover:bg-blue-100 transition" do %>
      <span class="material-symbols-outlined text-4xl text-blue-600 mb-2">download</span>
      <span class="text-lg font-semibold text-slate-700">IN</span>
      <p class="text-muted text-xs mt-1">Registra ingresso merce</p>
    <% end %>

    <%= link_to app_mobile_out_path, class: "bg-red-50 p-4 card flex flex-col items-center justify-center text-center aspect-square shadow-md hover:bg-red-100 transition" do %>
      <span class="material-symbols-outlined text-4xl text-red-600 mb-2">upload</span>
      <span class="text-lg font-semibold text-slate-700">OUT</span>
      <p class="text-muted text-xs mt-1">Registra uscita merce</p>
    <% end %>

    <%= link_to app_mobile_var_path, class: "bg-green-50 p-4 card flex flex-col items-center justify-center text-center aspect-square shadow-md hover:bg-green-100 transition" do %>
      <span class="material-symbols-outlined text-4xl text-green-600 mb-2">swap_horiz</span>
      <span class="text-lg font-semibold text-slate-700">VAR</span>
      <p class="text-muted text-xs mt-1">Spostamento tra location</p>
    <% end %>
  </div>

  <%= link_to app_dashboard_produzione_path, class: "block text-xl font-semibold text-slate-800 hover:text-accent transition" do %>
    Produzione
  <% end %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <%= link_to app_sez_path, class: "bg-amber-50 p-4 card flex flex-col items-center justify-center text-center aspect-square shadow-md hover:bg-amber-100 transition" do %>
      <span class="material-symbols-outlined text-4xl text-amber-600 mb-2">qr_code_scanner</span>
      <span class="text-lg font-semibold text-slate-700">Avanzamento</span>
      <p class="text-muted text-xs mt-1">Controllo passaggi produzione</p>
    <% end %>
  </div>
</section>
