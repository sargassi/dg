<% content_for :page_header do %>
  <%= render "application/breadcrumb", dashboard_path: app_dashboard_path, section_name: "App", page_title: "Stampa QR" %>
<% end %>

<%= form_with url: app_mobile_print_path, id: "mobile-print-form",
              data: {
                controller: "mobile-wizard qr-scanner",
                action: "submit->mobile-wizard#submit",
                mobile_wizard_operation_type_value: 1,
                mobile_wizard_scan_url_value: lookup_by_qr_inventories_path,
                mobile_wizard_wh_select_value: "print_warehouse_id",
                mobile_wizard_loc_select_value: "print_location_id",
                mobile_wizard_auto_prompt_value: false
              } do |form| %>

  <div class="<%= style_main_cnt %> space-y-4 max-w-lg mx-auto relative" id="mobile">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-slate-800 dark:text-slate-100">Stampa etichette QR</h2>
      <span data-mobile-wizard-target="progress" class="text-xs font-medium text-slate-400"></span>
    </div>

    <%# Single step: optional place + items %>
    <div data-mobile-wizard-target="step" class="space-y-4">

      <%# Optional place (defaults section "da" so autocomplete filters by it) %>
      <div class="rounded-lg p-4 space-y-4 bg-slate-50 dark:bg-slate-900/40"
           data-controller="defaults"
           data-defaults-target-prefix="da">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-xl text-slate-500">warehouse</span>
          <span class="text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wide">Posizione (opzionale)</span>
        </div>

        <div class="flex items-start gap-2">
          <div class="flex flex-col items-center">
            <label class="text-xs text-slate-400 uppercase tracking-wide block mb-1">Dove</label>
            <button type="button" data-action="click->qr-scanner#scanWarehouseLoc"
                    data-qr-label="Posizione"
                    class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-sm bg-slate-600 hover:bg-slate-700 text-white cursor-pointer"
                    title="Scansiona QR">
              <span class="material-symbols-outlined text-lg">qr_code_scanner</span>
            </button>
          </div>
          <div class="flex-1 min-w-0">
            <label class="text-xs text-slate-400 uppercase tracking-wide block mb-1">Magazzino</label>
            <select name="print_warehouse_id" data-defaults-target="warehouse" class="w-full border border-slate-300 outline-none px-3 py-3 text-sm bg-white rounded-lg">
              <option value="">Tutti i magazzini</option>
              <% @warehouses.each do |w| %>
                <option value="<%= w.id %>"><%= w.code %></option>
              <% end %>
            </select>
          </div>
          <div class="flex-1 min-w-0">
            <label class="text-xs text-slate-400 uppercase tracking-wide block mb-1">Ubica</label>
            <select name="print_location_id" data-defaults-target="location" data-action="change->defaults#propagate" class="w-full border border-slate-300 outline-none px-3 py-3 text-sm bg-white rounded-lg" disabled>
              <option value="">Tutte le ubiche</option>
              <% @locations.each do |l| %>
                <option value="<%= l.id %>" data-warehouse-id="<%= l.warehouse_id %>"><%= l.code %></option>
              <% end %>
            </select>
          </div>
        </div>
      </div>

      <%# Items autocomplete %>
      <div data-controller="autocomplete"
           data-autocomplete-url-value="<%= autocomplete_inventories_path %>"
           data-action="autocomplete:select->mobile-wizard#addSelected">
        <div class="flex gap-2">
          <div class="relative flex-1">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none">search</span>
            <input type="text"
                   data-autocomplete-target="input"
                   data-mobile-wizard-target="scanInput"
                   data-action="input->autocomplete#search blur->autocomplete#hideResults"
                   class="w-full border border-slate-300 outline-none px-3 py-3 pl-10 text-sm bg-white rounded-lg font-mono"
                   placeholder="Scansiona o digita codice..."
                   autocomplete="off">
          </div>
          <input type="hidden" data-autocomplete-target="hidden">
          <button type="button" data-action="mobile-wizard#startScan" class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-sm bg-slate-800 hover:bg-slate-900 text-white cursor-pointer" title="Scansiona QR">
            <span class="material-symbols-outlined text-lg">qr_code_scanner</span>
          </button>
        </div>
        <ul data-autocomplete-target="results" class="hidden absolute left-0 right-0 top-full mt-0.5 bg-white border border-slate-200 rounded-b-lg shadow-lg max-h-60 overflow-y-auto z-50 divide-y divide-slate-100"></ul>
      </div>

      <div data-mobile-wizard-target="cart" class="space-y-2"></div>

      <div class="flex gap-2">
        <%= form.button "Genera etichette", class: "w-full py-2 rounded-sm #{style_save_button} text-xs font-semibold cursor-pointer" %>
      </div>
    </div>

    <%# Hidden nested rows (filled by mobile-wizard) %>
    <div data-mobile-wizard-target="rows" class="hidden"></div>
    <template data-mobile-wizard-target="template">
      <div data-wizard-row>
        <input type="hidden" name="print[][item_id]">
        <input type="hidden" name="print[][itemcode]">
        <input type="hidden" name="print[][collection_id]">
        <input type="hidden" name="print[][operationtype_id]">
        <input type="hidden" name="print[][warehouse_id]">
        <input type="hidden" name="print[][location_id]">
        <input type="hidden" name="print[][qty]" value="1">
      </div>
    </template>

    <%= render "app/qr_scan_overlay", overlay: "qr-scanner", close_action: "click->qr-scanner#stop", video_id: "qr-print-loc-video", title: "Scansiona ubicazione", hint: "Inquadra un QR code ubicazione", manual_select: true %>

    <%= render "app/qr_scan_overlay", overlay: "mobile-wizard", close_action: "mobile-wizard#stopScan", video_id: "qr-print-item-video", title: "Scansiona articolo", hint: "Inquadra i QR articolo: si aggiungono in automatico", manual_select: true, continuous: true %>
  </div>
<% end %>