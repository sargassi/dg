<style>
  body { font-family: sans-serif; margin: 0; padding: 0; }
  .grid { display: flex; flex-wrap: wrap; gap: 2mm; }
  .card {
    width: 45mm; height: 45mm;
    border: 1px solid #ccc;
    padding: 2mm;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .card img { width: 28mm; height: 28mm; display: block; }
  .card .code { font-size: 6pt; margin-top: 1mm; word-break: break-all; }
</style>
<% qr = CreateQrService.new %>
<div class="grid">
  <% @entries.each do |entry| %>
    <% entry[:qty].times do %>
      <div class="card">
        <%= image_tag(qr.call(entry[:item].gencode).to_data_url, style: "width:28mm;height:28mm;") %>
        <div class="code"><%= entry[:item].gencode %></div>
      </div>
    <% end %>
  <% end %>
</div>