<% content_for :page_header do %>
  <%= render "application/breadcrumb", dashboard_path: app_dashboard_path, section_name: "App", page_title: "Riallocazione completata" %>
<% end %>

<section class="<%= style_main_cnt %> space-y-4">
  <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-lg p-6 text-center">
    <span class="material-symbols-outlined text-5xl text-emerald-600">swap_vert</span>
    <h2 class="text-xl font-semibold text-emerald-800 dark:text-emerald-200 mt-2">Riallocazione completata</h2>
    <p class="text-sm text-emerald-600 dark:text-emerald-300 mt-1"><%= pluralize(@stats[:moved_place].size, "articolo", plural: "articoli") %> spostati, <%= @stats[:moved] %> pz totali</p>
  </div>

  <div class="space-y-4">
    <% @stats[:moved_place].each do |gencode, moved| %>
      <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-lg px-4 py-3">
        <div class="flex items-center justify-between">
          <div class="font-mono text-sm font-semibold text-slate-800 dark:text-slate-200 truncate"><%= gencode %></div>
          <div class="text-right">
            <div class="text-sm font-bold text-emerald-600"><%= moved[:stock] %> pz</div>
            <div class="text-[11px] text-slate-400">inventari aggiornati: <%= moved[:inventories] %></div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @stats[:no_stock].any? %>
    <div class="rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 p-4 text-xs text-amber-800 dark:text-amber-200">
      Nessuna giacenza trovata in origine per: <%= @stats[:no_stock].join(", ") %>
    </div>
  <% end %>

  <div class="flex gap-2">
    <%= link_to app_mobile_reassign_path, class: "flex-1 py-3 rounded-lg bg-accent text-white text-sm font-semibold text-center cursor-pointer" do %>
      <span class="material-symbols-outlined text-base align-middle">add</span> Nuova riallocazione
    <% end %>
    <%= link_to app_dashboard_path, class: "flex-1 py-3 rounded-lg bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-sm font-semibold text-center" do %>
      <span class="material-symbols-outlined text-base align-middle">home</span> Dashboard
    <% end %>
  </div>
</section>
