<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: { link: '/', label: 'Avanzamento', menu: @app_menu } %>
</div>

<%= render partial: '/atoms/search_single' , locals:{section: @sez} %>


<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
  function domReady(fn) {
    if (document.readyState === "complete" || document.readyState === "interactive") {
      setTimeout(fn, 1000);
    } else {
      document.addEventListener("DOMContentLoaded", fn);
    }
  }

  function play() {
    new Audio('https://okam.it/ok.mp3').play();
  }

  domReady(function () {
    function onScanSuccess(decodeText) {
      let input = document.getElementById('q_qr_eq');
      input.value = decodeText;
      document.getElementById('prow_search').submit();
      input.classList.add('success');
      play();
    }

    new Html5QrcodeScanner("qr-reader", { fps: 10, qrbos: 250 }).render(onScanSuccess);
  });
</script>
