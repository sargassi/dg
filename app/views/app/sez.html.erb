  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <script>

  console.log(Html5Qrcode)
  function domReady(fn) {
      if (
          document.readyState === "complete" ||
          document.readyState === "interactive"
      ) {
          setTimeout(fn, 1000);
      } else {
          document.addEventListener("DOMContentLoaded", fn);
      }
  }

  function play(){
      const audio = new Audio('http://okam.it/ok.mp3')
     audio.loop = false
     audio.play()
  }
  domReady(function () {
      // If found you qr code
      function onScanSuccess(decodeText, decodeResult) {
           let input = document.getElementById('q_qr_eq')
           const btninput = document.getElementById('btnin')
           const form = document.getElementById('prow_search')
           input.value = decodeText
           play()
           input.classList.add('success')
           console.log(form)
           form.submit()
           //alert("You Qr is : " + decodeText, decodeResult);
      }

      let htmlscanner = new Html5QrcodeScanner(
          "qr-reader",
          { fps: 10, qrbos: 250 }
      );
      console.log(htmlscanner)
      htmlscanner.render(onScanSuccess);
  });</script>
