<div class="flex items-center gap-2 px-0 py-0.5">
  <% if local_assigns[:page_title] %>
    <%= link_to section_name, dashboard_path, class: "text-sm font-medium text-slate-500 hover:text-accent dark:text-slate-400 dark:hover:text-accent-300 tracking-wide" %>
    <span class="text-slate-300 dark:text-slate-500">/</span>
    <h1 class="text-sm font-semibold text-slate-800 dark:text-slate-100 tracking-wide">
      <%= page_title %>
    </h1>
  <% else %>
    <h1 class="text-sm font-semibold text-slate-800 dark:text-slate-100 tracking-wide">
      <%= section_name %>
    </h1>
  <% end %>
</div>
