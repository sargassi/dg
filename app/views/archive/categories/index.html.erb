<% content_for :page_header do %>
  <%= render "application/breadcrumb", dashboard_path: archive_dashboard_path, section_name: "Archivio", page_title: "Categorie" %>
<% end %>

<section class="<%= style_main_cnt %>">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 text-green-500 font-medium rounded-lg inline-block mb-5" id="notice"><%= notice %></p>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

    <div>
      <div class="<%= style_main_card %>">
        <h3 class="<%= style_main_card_header %>">
          <span class="material-symbols-outlined">category</span>
          Categorie
          <span class="<%= style_main_card_badge %>"><%= @categories.count %></span>
        </h3>

        <div id="categories" class="space-y-0">
          <% if @categories.any? %>
            <% @categories.each do |cat| %>
              <div id="<%= dom_id(cat) %>" class="flex items-center justify-between py-2.5 px-3 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors border-b border-slate-100 dark:border-slate-600 group">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="material-symbols-outlined text-slate-300 text-xl flex-shrink-0">folder</span>
                  <div class="min-w-0">
                    <div id="<%= dom_id(cat, :display) %>">
                      <span class="text-sm font-semibold text-slate-800 dark:text-slate-200"><%= cat.name %></span>
                      <% if cat.items.any? %>
                        <span class="<%= style_main_card_badge %> ml-2"><%= cat.items.count %> artic<%= cat.items.count == 1 ? 'olo' : 'oli' %></span>
                      <% end %>
                    </div>
                    <div id="<%= dom_id(cat, :edit) %>" class="hidden">
                      <%= form_with(model: cat, url: archive_category_path(cat), method: :patch, class: "flex items-center gap-2") do |f| %>
                        <%= f.text_field :name, value: cat.name, class: "border border-slate-300 dark:border-slate-600 outline-none px-2 py-1 text-sm w-36 dark:bg-slate-700 dark:text-slate-200", required: true %>
                        <%= f.submit "Salva", class: "px-3 py-1.5 #{style_save_button} tracking-wider rounded-sm text-xs cursor-pointer" %>
                        <button type="button" onclick="document.getElementById('<%= dom_id(cat, :edit) %>').classList.add('hidden'); document.getElementById('<%= dom_id(cat, :display) %>').classList.remove('hidden');" class="px-3 py-1.5 text-xs text-slate-500 hover:text-slate-700">Annulla</button>
                      <% end %>
                    </div>
                  </div>
                </div>
                <div class="flex gap-0.5 items-center">
                  <button type="button" onclick="document.getElementById('<%= dom_id(cat, :edit) %>').classList.remove('hidden'); document.getElementById('<%= dom_id(cat, :display) %>').classList.add('hidden');" class="p-1.5 text-slate-300 hover:text-accent rounded-sm hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                    <span class="material-symbols-outlined text-lg">edit</span>
                  </button>
                  <%= button_to archive_category_path(cat), method: :delete, data: { turbo_frame: "_top", turbo_confirm: cat.items.any? ? "Impossibile eliminare: ci sono articoli in questa categoria" : "Eliminare '#{cat.name}'?" }, class: "p-1.5 text-slate-300 hover:text-red-500 rounded-sm hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors" do %>
                    <span class="material-symbols-outlined text-lg">delete</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-sm text-slate-400 italic py-4">Nessuna categoria configurata</div>
          <% end %>
        </div>
      </div>
    </div>

    <div>
      <div class="<%= style_main_card %>">
        <h3 class="<%= style_main_card_header %>">
          <span class="material-symbols-outlined">add_box</span>
          Nuova categoria
        </h3>

        <%= form_with(model: @new_category, url: archive_categories_path, class: "contents") do |form| %>
          <% if @new_category.errors.any? %>
            <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium mb-4 border border-red-200 text-sm">
              <h2><%= pluralize(@new_category.errors.count, "error") %> impediscono il salvataggio:</h2>
              <ul class="mt-1 list-disc list-inside">
                <% @new_category.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid grid-cols-[1fr_auto] gap-3 items-end">
            <div>
              <%= form.label :name, "Nome categoria", class: "text-xs text-slate-400 tracking-wide block mb-1" %>
              <%= form.text_field :name, class: "border border-slate-300 dark:border-slate-600 outline-none px-3 py-2 w-full text-sm dark:bg-slate-700 dark:text-slate-200", placeholder: "Nome categoria", required: true %>
            </div>
            <div>
              <%= form.submit "Crea", class: "p-3 #{style_save_button} inline-block tracking-wider rounded-sm text-xs cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</section>
