<% content_for :page_header do %>
  <%= render "application/breadcrumb", dashboard_path: archive_dashboard_path, section_name: "Archivio" %>
<% end %>

<section class="<%= style_main_cnt %> space-y-8">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <%= link_to archive_items_path, class: "bg-indigo-50 dark:bg-indigo-900/20 p-4 card flex flex-col items-center justify-center text-center aspect-square shadow-md hover:bg-indigo-100 dark:hover:bg-indigo-900/40 transition" do %>
      <span class="material-symbols-outlined text-4xl text-indigo-600 dark:text-indigo-400 mb-2">archive</span>
      <span class="text-lg font-semibold text-slate-700 dark:text-slate-200">Ricerca Articoli</span>
      <p class="text-muted text-xs mt-1">Ricerca articoli in archivio</p>
    <% end %>

    <%= link_to archive_items_path(status: "in"), class: "bg-green-50 dark:bg-green-900/20 p-4 card flex flex-col items-center justify-center text-center aspect-square shadow-md hover:bg-green-100 dark:hover:bg-green-900/40 transition" do %>
      <span class="material-symbols-outlined text-4xl text-green-600 dark:text-green-400 mb-2">inventory_2</span>
      <span class="text-lg font-semibold text-slate-700 dark:text-slate-200">Presenti</span>
      <p class="text-muted text-xs mt-1"><%= @in_stock %> articoli presenti</p>
    <% end %>

    <%= link_to archive_items_path(status: "out"), class: "bg-red-50 dark:bg-red-900/20 p-4 card flex flex-col items-center justify-center text-center aspect-square shadow-md hover:bg-red-100 dark:hover:bg-red-900/40 transition" do %>
      <span class="material-symbols-outlined text-4xl text-red-600 dark:text-red-400 mb-2">logout</span>
      <span class="text-lg font-semibold text-slate-700 dark:text-slate-200">Fuori</span>
      <p class="text-muted text-xs mt-1"><%= @checked_out %> articoli in prestito</p>
    <% end %>
  </div>

  <div class="<%= style_main_card_grid %>">
    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined text-slate-400 dark:text-slate-500">archive</span>
        Archivio
      </h3>
      <div class="space-y-3">
        <%= link_to archive_items_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Tutti gli Articoli</span>
          <span class="material-symbols-outlined text-slate-300 dark:text-slate-400 text-base">arrow_forward_ios</span>
        <% end %>
        <%= link_to archive_items_path(status: "in"), class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">In Archivio</span>
          <span class="material-symbols-outlined text-slate-300 dark:text-slate-400 text-base">arrow_forward_ios</span>
        <% end %>
        <%= link_to archive_items_path(status: "out"), class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Fuori (in prestito)</span>
          <span class="material-symbols-outlined text-slate-300 dark:text-slate-400 text-base">arrow_forward_ios</span>
        <% end %>
      </div>
    </div>

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined text-slate-400 dark:text-slate-500">shelves</span>
        Categorie e Ubicazioni
      </h3>
      <div class="space-y-3">
        <%= link_to archive_categories_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Categorie (<%= @categories.size %>)</span>
          <span class="material-symbols-outlined text-slate-300 dark:text-slate-400 text-base">folder</span>
        <% end %>
        <%= link_to archive_locations_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Ubicazioni (<%= @locations.size %>)</span>
          <span class="material-symbols-outlined text-slate-300 dark:text-slate-400 text-base">shelves</span>
        <% end %>
      </div>
    </div>

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined text-slate-400 dark:text-slate-500">summarize</span>
        Riepilogo
      </h3>
      <div class="space-y-3">
        <div class="flex items-center justify-between px-3 py-2.5 bg-slate-50 dark:bg-slate-800/50 rounded-sm">
          <span class="text-sm text-slate-700 dark:text-slate-200">Totale articoli</span>
          <span class="text-sm font-bold text-slate-800 dark:text-slate-100"><%= @total_items %></span>
        </div>
        <div class="flex items-center justify-between px-3 py-2.5 bg-green-50 dark:bg-green-900/20 rounded-sm">
          <span class="text-sm text-green-700 dark:text-green-300">In archivio</span>
          <span class="text-sm font-bold text-green-800 dark:text-green-200"><%= @in_stock %></span>
        </div>
        <div class="flex items-center justify-between px-3 py-2.5 bg-red-50 dark:bg-red-900/20 rounded-sm">
          <span class="text-sm text-red-700 dark:text-red-300">Fuori</span>
          <span class="text-sm font-bold text-red-800 dark:text-red-200"><%= @checked_out %></span>
        </div>
      </div>
    </div>
  </div>

  <div class="<%= style_main_card %>">
    <h3 class="<%= style_main_card_header %>">
      <span class="material-symbols-outlined text-slate-400 dark:text-slate-500">history</span>
      Ultimi Movimenti
      <%= link_to archive_items_path, class: "ml-auto text-xs text-accent dark:text-accent-300 hover:text-accent-700 font-medium" do %>
        Vedi tutti
        <span class="material-symbols-outlined text-base align-middle">arrow_forward_ios</span>
      <% end %>
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 px-0">
      <div>
        <h4 class="text-xs font-semibold text-red-700 dark:text-red-400 tracking-wider mb-2 flex items-center gap-1">
          <span class="inline-block w-2 h-2 rounded-full bg-red-500"></span>
          Uscite (prestiti)
        </h4>
        <% if @latest_checkouts.any? %>
          <div class="divide-y divide-slate-100 border border-slate-200 rounded-lg overflow-hidden">
            <% @latest_checkouts.each do |tx| %>
              <div class="flex items-center justify-between px-3 py-2 hover:bg-red-50 dark:hover:bg-red-900/30 transition">
                <div class="flex-1 min-w-0">
                  <div class="text-xs text-slate-400 dark:text-slate-300"><%= tx.date.strftime("%d-%m-%Y") %></div>
                  <div class="text-sm font-medium text-slate-800 dark:text-slate-200 truncate"><%= tx.item&.code %> — <%= tx.item&.name %></div>
                  <% if tx.out_to.present? %>
                    <div class="text-[10px] text-slate-400 dark:text-slate-300">A: <%= tx.out_to %></div>
                  <% end %>
                </div>
                <div class="text-[10px] text-slate-500 dark:text-slate-300 ml-2 whitespace-nowrap font-bold"><%= tx.operator&.name %></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="flex items-center justify-center h-24 text-sm text-slate-400 dark:text-slate-300 bg-slate-50 dark:bg-slate-700 rounded-lg">
            Nessuna uscita recente
          </div>
        <% end %>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-emerald-700 dark:text-emerald-400 tracking-wider mb-2 flex items-center gap-1">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          Rientri
        </h4>
        <% if @latest_checkins.any? %>
          <div class="divide-y divide-slate-100 border border-slate-200 rounded-lg overflow-hidden">
            <% @latest_checkins.each do |tx| %>
              <div class="flex items-center justify-between px-3 py-2 hover:bg-emerald-50 dark:hover:bg-emerald-900/30 transition">
                <div class="flex-1 min-w-0">
                  <div class="text-xs text-slate-400 dark:text-slate-300"><%= tx.date.strftime("%d-%m-%Y") %></div>
                  <div class="text-sm font-medium text-slate-800 dark:text-slate-200 truncate"><%= tx.item&.code %> — <%= tx.item&.name %></div>
                  <% if tx.notes.present? %>
                    <div class="text-[10px] text-slate-400 dark:text-slate-300"><%= tx.notes %></div>
                  <% end %>
                </div>
                <div class="text-[10px] text-slate-500 dark:text-slate-300 ml-2 whitespace-nowrap font-bold"><%= tx.operator&.name %></div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="flex items-center justify-center h-24 text-sm text-slate-400 dark:text-slate-300 bg-slate-50 dark:bg-slate-700 rounded-lg">
            Nessun rientro recente
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
