<div class="<%= style_main_card %>">
  <div class="flex gap-4">
    <div class="flex-shrink-0">
      <% if item.pictures.attached? %>
        <%= image_tag item.pictures.first, class: "w-20 h-20 object-cover border border-slate-200 dark:border-slate-600 rounded-sm" %>
      <% else %>
        <div class="w-20 h-20 bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-sm flex items-center justify-center">
          <span class="material-symbols-outlined text-3xl text-slate-400">image</span>
        </div>
      <% end %>
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex items-start justify-between gap-2">
        <div>
          <h3 class="font-semibold text-slate-800 dark:text-slate-200 text-sm truncate"><%= item.name %></h3>
          <span class="text-xs font-mono text-blue-600 dark:text-blue-400"><%= item.code %></span>
        </div>
        <div class="flex-shrink-0 flex flex-col items-end gap-1.5">
          <% if item.status == "in" %>
            <span class="inline-block bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300 text-[10px] font-semibold px-2 py-0.5 rounded uppercase leading-tight">In archivio</span>
            <button type="button" onclick="document.getElementById('checkout-form-<%= item.id %>').classList.toggle('hidden')" class="inline-flex items-center gap-1 text-[10px] bg-amber-500 hover:bg-amber-600 text-white px-2 py-0.5 rounded font-medium">
              <span class="material-symbols-outlined text-sm">logout</span>
              Fuori
            </button>
          <% else %>
            <span class="inline-block bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300 text-[10px] font-semibold px-2 py-0.5 rounded uppercase leading-tight">Fuori</span>
            <%= button_to checkin_archive_item_path(item), method: :post, class: "inline-flex items-center gap-1 text-[10px] bg-green-600 hover:bg-green-700 text-white px-2 py-0.5 rounded font-medium", data: { turbo_frame: "_top" } do %>
              <span class="material-symbols-outlined text-sm">login</span>
              Rientro
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="flex flex-wrap gap-2 mt-2 text-xs text-slate-500 dark:text-slate-400">
        <% if item.category %>
          <span class="<%= style_main_card_badge %>"><%= item.category.name %></span>
        <% end %>
        <% if item.location %>
          <span class="<%= style_main_card_badge %>"><%= item.location.code %></span>
        <% end %>
        <% if item.source_item %>
          <span class="<%= style_main_card_badge %>">
            <%= link_to item_path(item.source_item), class: "text-accent hover:text-accent-700 font-mono", data: { turbo_frame: "_top" } do %>
              <%= item.source_item.itemcode %><%= item.source_item.fabricode %><%= item.source_item.varcode %>
            <% end %>
          </span>
        <% end %>
      </div>


    </div>
  </div>

  <div class="flex items-center gap-2 mt-4 pt-3 border-t border-slate-100 dark:border-slate-600">
    <%= link_to archive_item_path(item), class: "inline-flex items-center gap-1 text-xs text-accent hover:text-accent-700 font-medium", data: { turbo_frame: "item_modal" } do %>
      <span class="material-symbols-outlined text-base">visibility</span>
      Mostra
    <% end %>
    <%= link_to edit_archive_item_path(item), class: "inline-flex items-center gap-1 text-xs text-accent hover:text-accent-700 font-medium", data: { turbo_frame: "item_modal" } do %>
      <span class="material-symbols-outlined text-base">edit</span>
      Modifica
    <% end %>
    <%= button_to duplicate_archive_item_path(item), method: :post, class: "inline-flex items-center gap-1 text-xs text-accent hover:text-accent-700 font-medium", data: { turbo_frame: "_top" } do %>
      <span class="material-symbols-outlined text-base">content_copy</span>
      Duplica
    <% end %>

    <%= button_to archive_item_path(item), method: :delete, class: "inline-flex items-center gap-1 text-xs text-red-500 hover:text-red-700 font-medium", data: { turbo_confirm: "Eliminare #{item.name}?", turbo_frame: "_top" } do %>
      <span class="material-symbols-outlined text-base">delete</span>
      Elimina
    <% end %>
  </div>

  <% if item.status == "in" %>
    <div id="checkout-form-<%= item.id %>" class="hidden mt-3 pt-3 border-t border-slate-100 dark:border-slate-600">
      <%= form_with url: checkout_archive_item_path(item), method: :post, data: { turbo_frame: "_top" }, class: "space-y-2" do |f| %>
        <%= f.text_field :out_to, class: "border border-slate-300 dark:border-slate-600 outline-none px-2 py-1 text-xs w-full dark:bg-slate-700 dark:text-slate-200", placeholder: "A chi / dove", required: true %>
        <%= f.text_field :notes, class: "border border-slate-300 dark:border-slate-600 outline-none px-2 py-1 text-xs w-full dark:bg-slate-700 dark:text-slate-200", placeholder: "Motivo" %>
        <div class="flex gap-2">
          <%= f.submit "Conferma", class: "px-3 py-1 bg-amber-500 hover:bg-amber-600 text-white text-xs rounded-sm cursor-pointer" %>
          <button type="button" onclick="document.getElementById('checkout-form-<%= item.id %>').classList.add('hidden')" class="px-3 py-1 text-xs text-slate-500 hover:text-slate-700">Annulla</button>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
