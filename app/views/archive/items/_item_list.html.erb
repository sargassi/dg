<div class="flex items-center px-4 py-3.5 gap-3 border-b border-slate-100 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors group">
  <div class="w-14 flex-shrink-0">
    <% if item.pictures.attached? %>
      <%= link_to gallery_archive_item_path(item, index: 0), data: { turbo_frame: "item_modal" } do %>
        <div class="relative inline-block">
          <%= image_tag item.pictures.first, class: "w-14 h-14 object-cover border border-slate-200 dark:border-slate-600 rounded-sm" %>
          <% if item.pictures.count > 1 %>
            <span class="absolute -top-1.5 -right-1.5 bg-accent text-white text-[8px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none">+<%= item.pictures.count - 1 %></span>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="w-14 h-14 bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-sm flex items-center justify-center">
        <span class="material-symbols-outlined text-lg text-slate-400">image</span>
      </div>
    <% end %>
  </div>

  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2">
      <span class="text-xs font-mono text-blue-600 dark:text-blue-400"><%= item.code %></span>
      <span class="text-sm font-medium text-slate-800 dark:text-slate-200 truncate"><%= item.name %></span>
    </div>
    <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-400">
      <% if item.location %>
        <span><%= item.location.full_name %></span>
      <% end %>
      <% if item.source_item %>
        <span class="text-accent font-mono">
          · <%= link_to item_path(item.source_item), class: "hover:text-accent-700", data: { turbo_frame: "_top" } do %><%= item.source_item.itemcode %><%= item.source_item.fabricode %><%= item.source_item.varcode %><% end %>
        </span>
      <% end %>
    </div>
  </div>

  <div class="w-20 flex-shrink-0 text-center text-xs text-slate-500 dark:text-slate-400">
    <%= item.item_type&.name || "—" %>
  </div>

  <div class="w-20 flex-shrink-0 text-center text-xs text-slate-500 dark:text-slate-400">
    <%= item.category&.name || "—" %>
  </div>

  <div class="w-28 flex-shrink-0 flex items-center justify-end gap-1.5">
    <% if item.status == "in" %>
      <span class="text-[10px] font-semibold text-green-600 dark:text-green-400 uppercase">In archivio</span>
      <button type="button" onclick="document.getElementById('checkout-form-<%= item.id %>').classList.toggle('hidden')" class="inline-flex items-center gap-1 text-[10px] bg-amber-500 hover:bg-amber-600 text-white px-1.5 py-0.5 rounded font-medium">
        <span class="material-symbols-outlined text-xs">logout</span>
      </button>
    <% else %>
      <span class="text-[10px] font-semibold text-red-600 dark:text-red-400 uppercase">Fuori</span>
      <%= button_to checkin_archive_item_path(item), method: :post, form_class: "inline", class: "inline-flex items-center gap-1 text-[10px] bg-green-600 hover:bg-green-700 text-white px-1.5 py-0.5 rounded font-medium", data: { turbo_frame: "_top" } do %>
        <span class="material-symbols-outlined text-xs">login</span>
      <% end %>
    <% end %>
  </div>

  <div class="w-28 flex-shrink-0 flex items-center justify-end gap-0.5">
    <%= link_to archive_item_path(item), class: "p-1 text-slate-500 hover:text-accent rounded-sm hover:bg-slate-100 dark:hover:bg-slate-700", data: { turbo_frame: "item_modal" } do %>
      <span class="material-symbols-outlined text-sm">visibility</span>
    <% end %>
      <%= link_to edit_archive_item_path(item, page: params[:page]), class: "p-1 text-slate-500 hover:text-accent rounded-sm hover:bg-slate-100 dark:hover:bg-slate-700", data: { turbo_frame: "item_modal" } do %>
      <span class="material-symbols-outlined text-sm">edit</span>
    <% end %>
    <%= button_to duplicate_archive_item_path(item), method: :post, class: "p-1 text-slate-500 hover:text-accent rounded-sm hover:bg-slate-100 dark:hover:bg-slate-700", data: { turbo_frame: "_top" } do %>
      <span class="material-symbols-outlined text-sm">content_copy</span>
    <% end %>
    <%= button_to archive_item_path(item), method: :delete, class: "p-1 text-slate-500 hover:text-red-500 rounded-sm hover:bg-slate-100 dark:hover:bg-slate-700", data: { turbo_confirm: "Eliminare #{item.name}?", turbo_frame: "_top" } do %>
      <span class="material-symbols-outlined text-sm">delete</span>
    <% end %>
  </div>
</div>

<% if item.status == "in" %>
  <div id="checkout-form-<%= item.id %>" class="hidden px-4 py-2 bg-slate-50 dark:bg-slate-700/30 border-b border-slate-100 dark:border-slate-600">
    <%= form_with url: checkout_archive_item_path(item), method: :post, data: { turbo_frame: "_top" }, class: "flex items-center gap-2" do |f| %>
      <%= f.text_field :out_to, class: "border border-slate-300 dark:border-slate-600 outline-none px-2 py-1 text-xs flex-1 dark:bg-slate-700 dark:text-slate-200", placeholder: "A chi / dove", required: true %>
      <%= f.text_field :notes, class: "border border-slate-300 dark:border-slate-600 outline-none px-2 py-1 text-xs flex-1 dark:bg-slate-700 dark:text-slate-200", placeholder: "Motivo" %>
      <%= f.submit "Conferma", class: "px-3 py-1 #{style_save_button} text-xs rounded-sm cursor-pointer" %>
      <button type="button" onclick="document.getElementById('checkout-form-<%= item.id %>').classList.add('hidden')" class="px-3 py-1 text-xs text-slate-500 hover:text-slate-700">Annulla</button>
    <% end %>
  </div>
<% end %>
