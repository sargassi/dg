<style>
  body { font-family: Arial, sans-serif; margin: 0; padding: 0; }
  h1 { font-size: 16pt; color: #333; text-align: center; margin-bottom: 8mm; }
  .grid { display: flex; flex-wrap: wrap; }
  .card {
    width: 45mm; height: 50mm;
    border: 1px solid #ccc;
    padding: 3mm;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    page-break-inside: avoid;
    box-sizing: border-box;
  }
  .card img { width: 28mm; height: 28mm; display: block; }
  .card .code { font-size: 7pt; font-weight: bold; color: #444; margin-top: 1mm; }
  .card .desc { font-size: 6pt; color: #888; margin-top: 0.5mm; }
</style>

<% qr_service = CreateQrService.new %>

<h1>QR Ubicazioni Archivio</h1>

<div class="grid">
  <% @locations.each_with_index do |location, idx| %>
    <% if idx > 0 && idx % 24 == 0 %>
      </div><div class="grid" style="page-break-before: always;">
    <% end %>
    <div class="card">
      <%= image_tag(qr_service.call(location.gencode).to_data_url, style: "width:28mm;height:28mm;") %>
      <div class="code"><%= location.code %></div>
      <% if location.description.present? %>
        <div class="desc"><%= location.description.truncate(40) %></div>
      <% end %>
    </div>
  <% end %>
</div>
