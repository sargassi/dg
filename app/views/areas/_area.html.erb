<div id="<%= dom_id area %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= area.description %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this area", area, class: "#{style_btn(variant: :neutral)}" %>
    <%= link_to 'Edit this area', edit_area_path(area), class: "ml-2 #{style_btn(variant: :neutral)}" %>
    <hr class="mt-6">
  <% end %>
</div>
