<% defined?(redir) ? bck = redir : bck = '' %>

<div class="flex items-center gap-2 px-3 py-1 border-b border-slate-200 dark:border-slate-700">
 <% if defined? var %>
   <% case var %>
   <% when 'proformas' %>
      <h1 class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide">
        <%= link_to "Lancio #{@proforma.customer} del #{@proforma.data_in.strftime('%d/%m/%Y')}", '/production/proformas', data: { turbo_frame: "_top" }, class: "hover:text-accent dark:hover:text-accent-300" %>
      </h1>
   <% when 'prows' %>
      <h1 class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide">
        <%= link_to "Lancio #{back} / #{@prow.description }", "/production/proformas/#{back}", data: { turbo_frame: "_top" }, class: "hover:text-accent dark:hover:text-accent-300" %>
      </h1>
  <% else %>
  <% end %>
 <% end %>
 <% if defined?(pdf) && pdf == 'prof' %>
   <div class="link_to_pdf w-40 ">
    <%= link_to "QR Codes", production_proforma_path(:id => @proforma.id, :format => :pdf), target: "_blank", class: style_action_pdf %>
   </div>
 <% end %>
 <% if defined?(note) && note != '' %>
    <div class="note grow">
        <%= note %>
    </div>
    <div class="text-end fltrs grow">
        <%= render partial: "/atoms/ux/fltrs" %>
    </div>
 <% end %>

 <div class="grow text-end flex gap-4">

  <% delete_base = var == 'proformas' ? production_proformas_path : "/#{var}" %>
  <%= button_to "#{delete_base}/#{target.id}?bck=#{bck}", method: :delete, class: style_actions_linx, data: {turbo_frame: '_top'} do %>
     <span class="material-symbols-outlined">
     delete
     </span>
 <% end %>
 <div class="grow text-end">
      <a href="<%= (params[:back_url].presence || production_proformas_path) %>#prow-<%= target.id %>" class="<%= style_actions_linx %>" data-turbo-frame="_top"><span class="material-symbols-outlined">close_small</span></a>
 </div>
</div>


</div>
