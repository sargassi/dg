<% defined?(redir) ? bck = redir : bck = '' %>
<div class="flex gap-8">

 <a href="/<%= bck %>" class="<%= style_actions_linx %>">Indietro</a>

 <%= button_to "Elimina", "/#{var}/#{target.id}?bck=#{bck}", method: :delete, class: style_actions_linx, data: {turbo_frame: '_top'} %>


 <% if defined?(pdf) && pdf == 'prof' %>
   <div class="link_to_pdf">
   <%= link_to "QR Codes", proforma_path(:id => @proforma.id, :format => :pdf), target: "_blank", class: style_action_pdf %>
   </div>
 <% end %>


</div>
