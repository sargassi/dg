<% defined?(redir) ? bck = redir : bck = '' %>
<div class="flex gap-8">

 <a href="/<%= bck %>" class="<%= style_actions_linx %>" data-turbo-frame="_top"><span class="material-symbols-outlined">
 close_small
 </span></a>

 <%= button_to "/#{var}/#{target.id}?bck=#{bck}", method: :delete, class: style_actions_linx, data: {turbo_frame: '_top'} do %>
     <span class="material-symbols-outlined">
     delete
     </span>
 <% end %>


 <% if defined?(pdf) && pdf == 'prof' %>
   <div class="link_to_pdf">
   <%= link_to "QR Codes", proforma_path(:id => @proforma.id, :format => :pdf), target: "_blank", class: style_action_pdf %>
   </div>
 <% end %>
 <% if defined?(note) && note != '' %>
    <div class="note">
        <%= note %>
    </div>
    <div class="text-end fltrs">
        <%= render partial: "/atoms/ux/fltrs" %>
    </div>
 <% end %>

</div>
