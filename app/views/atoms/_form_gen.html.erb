<section class="<%= style_import_form %>">
  <div class="flex items-center gap-3">
    <%= form_with url:"/utilities/etilgenimp", class: "flex items-center gap-2 flex-1" do |f| %>
      <%= f.hidden_field :dategroup, :value => @working_date %>
      <%= hidden_field_tag :etigen, nil, :value => 'y' %>
      <%= f.hidden_field :group, :value => @group %>
      <%= f.number_field :pages, class: "#{style_main_input} w-54 py-1", required: true, placeholder: 'Num pagine' %>
      <%= f.submit "Crea", target: "_blank", class: style_import_btn %>
    <% end %>
    <% if pdf.present? && pdf == 'y' %>
      <%= link_to "PDF", etigens_etichette_path(:format => :pdf), target: "_blank", class: "#{style_import_pdf_small} ml-auto" %>
    <% end %>
  </div>
</section>

<%# END FILE UPLOAD %>

<hr>
