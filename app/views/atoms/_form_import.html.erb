<%# FILE UPLOAD %>
<section class="<%= style_import_form %>">
  <div class="<%= style_form_row %>">
    <%= form_for prods, url: (defined?(form_url) ? form_url : prods), html: { class: "flex items-center gap-2 flex-1" } do |f| %>
      <% if defined?(customer) && customer == 'y' %>
        <%= f.text_field :customer, class: style_main_input, :required => true, placeholder: 'Inserisci nuovo lancio' %>
        <% date = Date.today %>
        <%= f.date_field :data_in, class: style_main_input, :required => true, :value => date %>
      <% end %>
      <%= f.file_field :file, class: "#{style_import_field} !w-auto", :required => true %>
      <%= f.submit "Importa", target: "_blank", class: "px-5 py-2 tracking-wider rounded-sm uppercase text-xs cursor-pointer transition-colors #{style_action_btn}" %>
    <% end %>
    <% if pdf.present? && pdf == 'y' %>
      <%= link_to "PDF", products_etichette_path(:format => :pdf), target: "_blank", class: "#{style_import_pdf_small} ml-auto" %>
    <% end %>
  </div>
  <% if params[:note].present? %>
    <div class="xl:w-1/3 mt-3">
      <%= render partial: 'atoms/ux/pagy' %>
    </div>
  <% end %>
</section>

<%# END FILE UPLOAD %>

<hr>
