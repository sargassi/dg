<%# FILE UPLOAD %>
<section class="<%= style_import_form %>" >
  <%= form_for prods, url: (defined?(form_url) ? form_url : prods) do |f| %>
    <div class="w-full flex gap-2 items-center">
    <% if defined?(customer) && customer == 'y' %>

        <%= f.text_field :customer, class: style_main_input, :required => true, placeholder: 'Inserisci nuovo lancio' %>
        <% date = Date.today %>

        <%= f.date_field :data_in, class: style_main_input, :required => true, :value => date %>

    <% end %>
    <%= f.file_field :file, class: style_import_field, :required => true %>
    <%= f.submit "Importa", target: "_blank", class: style_import_btn %>
  </div>
<% end %>
  <% if pdf.present? && pdf == 'y' %>
  <div class="link_to_pdf">
    <%= link_to "PDF", products_etichette_path(:format => :pdf), target: "_blank", class: style_import_pdf_small %>
  </div>
<% end %>
<% if params[:note].present? %>
<div class="xl:w-1/3">
  <%= render partial: 'atoms/ux/pagy' %>
</div>
<% end %>

</section>

<%# END FILE UPLOAD %>

<hr>
