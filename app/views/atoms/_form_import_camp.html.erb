<%# FILE UPLOAD %>
<section class="<%= style_import_form %>" data-controller="autosub">
  <div class="<%= style_form_row %>">
    <%= form_with url:"/utilities/eticampimp", class: "flex items-center gap-2" do |f| %>
      <%= hidden_field_tag :import, nil, :value => 'y' %>
      <%= f.file_field :file, class: "#{style_import_field} !w-auto", :required => true %>
      <%= f.text_field :season, class: "#{style_import_field} w-80", :required => true, :placeholder => 'Descrizione' %>
      <%= f.submit "Importa", target: "_blank", class: "px-4 py-1.5 tracking-wider rounded-sm uppercase text-xs cursor-pointer transition-colors #{style_action_btn}" %>
    <% end %>

    <form action="#" class="flex items-center ml-4">
      <select name="group" id="group" class="<%= style_select_class %> w-64">
        <% @search.compact.each_with_index do |x, i| %>
          <% break unless i < 5 %>
          <option value="<%= x[1].first.group %>">
            <%= x[1].first.group %> <%= x[1].first.created_at.strftime("%d-%m | %H:%m") %>
          </option>
        <% end %>
      </select>
    </form>

    <% if pdf.present? && pdf == 'y' %>
      <%= link_to "PDF", eticamps_etichette_path(:format => :pdf), target: "_blank", class: "#{style_import_pdf_small} ml-auto" %>
    <% end %>
  </div>
</section>

<%# END FILE UPLOAD %>

<hr>
