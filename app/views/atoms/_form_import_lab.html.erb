<%# FILE UPLOAD %>
<section class="<%= style_import_form %>" >
  <%= form_with url:"/utilities/etilabimp" do |f| %>

    <%= hidden_field_tag :import, nil, :value => 'y' %>

  <%= f.file_field :file, class: style_import_field, :required => true %>
  <%= f.submit "Importa", target: "_blank", class: style_import_btn %>
<% end %>
  <select name="group" id="group" class="<%= style_select_class %>">
    <% @etigroup.compact.each_with_index do |x, i| %>
      <% if i < 5 %>
      <option value="<%= x[1].first.group %>">
       <%= x[1].first.created_at.strftime("%d-%m-%y | %H:%m") %>
      </option>
      <% i = i + 1 %>
      <% end %>
    <% end %>
  </select>

  <% if pdf.present? && pdf == 'y' %>
<div class="link_to_pdf">
<%= link_to "PDF", etilabs_etichette_path(:format => :pdf), target: "_blank", class: style_import_pdf_small %>
</div>
<% end %>

</section>

<%# END FILE UPLOAD  %>

<hr>
