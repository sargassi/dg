<h1 class="<%= style_main_header %> flex-none">
  <a href="<%= link %>" class="font-semibold" data-turbo-frame="_top">
    <%= label %>
  </a>
</h1>
<% if local_assigns[:menu] && menu.any? %>
  <nav class="<%= style_header_nav %>">
    <% menu.select { |item| item[:can].nil? || current_user.can?(item[:can]) }.each do |item| %>
      <%= link_to item[:path],
            class: style_header_nav_link(active: item[:active]),
            data: { turbo_frame: "_top" } do %>
        <% if item[:icon] %><span class="material-symbols-outlined text-base"><%= item[:icon] %></span><% end %>
        <%= item[:label] %>
      <% end %>
    <% end %>
    <% if current_user.has_role?(:pedone) %>
      <%= link_to destroy_user_session_path, data: { turbo_method: :delete, turbo_frame: "_top" }, class: style_header_nav_link(active: false) do %>
        <span class="material-symbols-outlined text-base">logout</span>
        Logout
      <% end %>
    <% end %>
  </nav>
<% end %>
<hr class="<%= style_hr %>">
