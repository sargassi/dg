<h1 class="<%= style_main_header %> flex-none">
  <a href="<%= link %>" class="font-semibold" data-turbo-frame="_top">
    <%= label %>
  </a>
</h1>
<% if local_assigns[:menu] && menu.any? %>
  <nav class="flex items-center gap-1 ml-auto">
    <% menu.select { |item| item[:can].nil? || current_user.can?(item[:can]) }.each do |item| %>
      <%= link_to item[:path],
            class: "#{item[:active] ? 'bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-slate-200 font-semibold' : 'text-slate-500 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-slate-700 dark:hover:text-slate-100'} px-3 py-1.5 text-xs lowercase rounded-none transition flex items-center gap-1",
            data: { turbo_frame: "_top" } do %>
        <% if item[:icon] %><span class="material-symbols-outlined text-base"><%= item[:icon] %></span><% end %>
        <%= item[:label] %>
      <% end %>
    <% end %>
  </nav>
<% end %>
<hr class="border-slate-300 dark:border-slate-600">
