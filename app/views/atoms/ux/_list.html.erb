<ul class="<%= style_agenda_ul %>">
  <% data.each do |li| %>
      <li class="<%= style_agenda_li %>">
          <span class="font-semibold capitalize  w-1/2">
          <%= link_to operator_path(li.id), data: {turbo_frame: 'insidejoke'} do %>
              <%= "#{li.name} #{li.lastname} " %>
          <% end %>
          </span>
          <span class="text-slate-400 ml-8"><%= li.role %></span>
      </li>
  <% end %>
</ul>
