<%= form_with(model: collection, data: { turbo_frame: "_top" }) do |form| %>
  <% if collection.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-sm mt-3">
      <h2><%= t("errors.template.header", count: collection.errors.count, model: "collezione") %>:</h2>

      <ul class="list-disc ml-6">
        <% collection.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label 'Descrizione' %>
    <%= form.text_field :description, class: ["block shadow rounded-sm border outline-none px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": collection.errors[:description].none?, "border-red-400 focus:outline-red-600": collection.errors[:description].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "rounded-sm px-3.5 py-2.5 bg-accent hover:bg-accent-600 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
