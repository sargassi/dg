<% content_for :page_header do %>
<div class="flex items-center gap-2 px-0 py-0.5">
  <h1 class="text-sm font-semibold text-slate-500 dark:text-slate-400 tracking-wide">
    Collezioni
  </h1>
</div>
<% end %>

<section class="<%= style_main_cnt %>">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

    <div>
      <div class="<%= style_main_card %>">
        <h3 class="<%= style_main_card_header %>">
          <span class="material-symbols-outlined">collections_bookmark</span>
          Collezioni
          <span class="<%= style_main_card_badge %>"><%= @collections.count %></span>
        </h3>
        <div id="collections" class="space-y-0" data-controller="sortable" data-sortable-url-value="<%= reorder_collections_path %>">
          <%= render @collections %>
          <% if @collections.empty? %>
            <div class="text-sm text-slate-400 italic py-4">Nessuna collezione configurata</div>
          <% end %>
        </div>
      </div>
    </div>

    <div>
      <div class="<%= style_main_card %>">
        <h3 class="<%= style_main_card_header %>">
          <span class="material-symbols-outlined">add</span>
          Nuova Collezione
        </h3>

        <%= form_with(model: @collection, class: "contents") do |form| %>
          <% if @collection.errors.any? %>
            <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium mb-4 border border-red-200 text-sm">
              <h2><%= pluralize(@collection.errors.count, "error") %> impediscono il salvataggio:</h2>
              <ul class="mt-1 list-disc list-inside">
                <% @collection.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid grid-cols-[1fr_auto] gap-6 items-end mb-4">
            <div>
              <%= form.label 'Descrizione collezione', class: "text-xs text-slate-400 tracking-wide block mb-1" %>
              <%= form.text_field :description, class: "border border-slate-300 outline-none px-3 py-2 w-full text-sm", placeholder: "Descrizione collezione", required: true %>
            </div>
            <div>
              <%= form.submit "Crea Collezione", class: "p-3 #{style_save_button} inline-block tracking-wider rounded-sm text-xs cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-6 flex justify-end gap-3">
        <%= link_to merge_collections_path, class: "inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-sm transition-colors" do %>
          <span class="material-symbols-outlined text-base">merge</span>
          Unisci collezioni
        <% end %>
      </div>

      <%= turbo_frame_tag "collection_modal" %>
    </div>

  </div>
</section>