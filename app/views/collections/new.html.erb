<%= turbo_frame_tag "collection_modal" do %>
  <div class="fixed inset-0 bg-black/30 backdrop-blur-sm z-50 flex items-start justify-center pt-32"
       data-controller="insertevent"
       data-action="click->insertevent#closeModal">
    <div class="bg-white border border-slate-200 shadow-lg w-full max-w-sm mx-4"
         data-action="click->insertevent#stopPropagation">
      <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-700">Nuova Collezione</h2>
        <%= link_to mainware_import_path,
              class: "text-slate-400 hover:text-slate-600 transition",
              data: { turbo_frame: "_top" } do %>
          <span class="material-symbols-outlined text-lg">close</span>
        <% end %>
      </div>
      <div class="p-4">
        <%= render "form", collection: @collection %>
      </div>
    </div>
  </div>
<% end %>
