<% content_for :title, "Showing collection" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-sm inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing collection</h1>

  <%= render @collection %>

  <%= link_to "Edit this collection", edit_collection_path(@collection), class: "mt-2 #{style_btn(variant: :neutral)}" %>
  <%= link_to "Back to collections", collections_path, class: "ml-2 #{style_btn(variant: :neutral)}" %>
  <div class="inline-block ml-2">
    <%= button_to "Destroy this collection", @collection, method: :delete, class: "mt-2 #{style_btn(variant: :danger)}" %>
  </div>
</div>
