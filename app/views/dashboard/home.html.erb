<section class="home">

  <% if current_user.has_role?(:ufficio) %>

    <div class="grid lg:grid-cols-2 gap-6 items-start">

        <div class="flex flex-col gap-5">

          <%= render partial: '/atoms/home/card', locals: {:title => 'QR x Produzione', :subtitle => 'Inserisci nuova proforma', :link => '/production/proformas'} %>

          <%= render partial: '/atoms/home/card', locals: {:title => 'Ricerca x articolo', :subtitle => 'Stato avanzamento - Ricerca per articolo', :link => '/production/research'} %>

          <%= render partial: '/atoms/home/card', locals: {:title => 'Ricerca x QR', :subtitle => 'Stato avanzamento - Ricerca per QR code', :link => '/production/research_qr'} %>

        </div>

        <div class="flex flex-col gap-5">

          <%= render partial: '/atoms/home/card', locals: {:title => 'Stampa Etichette Proforma', :subtitle => 'Prepara pdf pronti per stampa etichette adesive 7x3.6cm', :link => '/utilities/etichette'} %>

          <%= render partial: '/atoms/home/card', locals: {:title => 'Stampa Etichette Laboratorio', :subtitle => 'Prepara pdf pronti per stampa etichette adesive 7x3.6cm', :link => '/utilities/etichette_lab'} %>

        </div>

      </div>

    <% elsif current_user.has_role?(:lab) %>

        <div class="grid lg:grid-cols-2 gap-6 items-start max-w-3xl">

          <div class="flex flex-col gap-5">
            <%= render partial: '/atoms/home/card', locals: {:title => 'Stampa Etichette', :subtitle => 'Prepara pdf pronti per stampa etichette adesive 7x3.6cm', :link => '/utilities/etichette_lab'} %>
          </div>

        </div>

    <% end %>

</section>