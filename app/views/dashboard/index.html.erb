<% content_for :page_header do %>
<div class="flex items-center gap-2 px-0 py-0.5">
  <h1 class="text-base font-semibold tracking-tight text-slate-700 dark:text-slate-100">
    ok'am srl
  </h1>
</div>
<% end %>

<section class="p-6 lg:p-8">
  <% if current_user.godlike? %>
    <%= render 'dashboard/portal' %>
  <% elsif current_user.has_role?(:ufficio) %>
    <%= render partial: 'dashboard/atoms/ufficio' %>
  <% elsif current_user.has_role?(:lab) %>
    <%= render partial: 'dashboard/atoms/lab' %>
  <% end %>
</section>
