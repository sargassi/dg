<% menu = [{ label: 'Home', path: '/', active: true, icon: 'home' }] %>
<% if current_user.godlike? %>
  <% menu << { label: 'Utilità', path: utilities_dashboard_path, active: false, icon: 'description', can: 'manage_utilities_labels' } %>
<% end %>
<% if current_user.godlike? %>
  <% menu << { label: 'Produzione', path: production_dashboard_path, active: false, icon: 'checklist_rtl', can: 'view_production' } %>
<% end %>
<% if current_user.godlike? %>
  <% menu << { label: 'Main', path: mainware_dashboard_path, active: false, icon: 'shelf_position', can: 'manage_mainware' } %>
<% end %>
<% if current_user.godlike? %>
  <% menu << { label: 'Magazzino', path: inventories_dashboard_path, active: false, icon: 'inventory_2', can: 'manage_inventory' } %>
<% end %>
<% if current_user.godlike? %>
  <% menu << { label: 'Rubrica', path: directory_path, active: false, icon: 'contact_page', can: 'manage_directory' } %>
<% end %>
<% if current_user.godlike? %>
  <% menu << { label: 'Admin', path: admin_users_path, active: false, icon: 'admin_panel_settings' } %>
<% end %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: { link: '/', label: "ok'am srl", menu: menu } %>
</div>

<section class="<%= style_main_cnt %> space-y-8">
  <% if current_user.godlike? || current_user.has_role?(:ufficio) %>
    <%= render partial: 'dashboard/atoms/ufficio' %>
  <% elsif current_user.has_role?(:lab) %>
    <%= render partial: 'dashboard/atoms/lab' %>
  <% end %>
</section>
