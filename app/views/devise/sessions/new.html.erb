<div class="w-full max-w-sm">
  <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 shadow-sm px-8 py-10">
    <div class="text-center mb-8">
      <img src="/favicon-32x32.png" class="block w-8 h-8 mx-auto mb-2" />
      <h1 class="text-lg font-semibold text-slate-800 dark:text-slate-200">Ok'am Srl</h1>
      <p class="text-xs text-slate-400 dark:text-slate-300 mt-1">Sign in to your account</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-5">
        <%= f.label :email, class: "text-xs text-slate-400 dark:text-slate-300 uppercase tracking-wide block mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full border border-slate-300 outline-none px-3 py-2 text-sm focus:border-accent focus:ring-1 focus:ring-accent transition-colors dark:bg-slate-700 dark:text-slate-200 dark:border-slate-600 dark:focus:border-accent-300" %>
      </div>

      <div class="mb-5">
        <%= f.label :password, class: "text-xs text-slate-400 dark:text-slate-300 uppercase tracking-wide block mb-1.5" %>
        <%= f.password_field :password, autocomplete: "password",
              class: "w-full border border-slate-300 outline-none px-3 py-2 text-sm focus:border-accent focus:ring-1 focus:ring-accent transition-colors dark:bg-slate-700 dark:text-slate-200 dark:border-slate-600 dark:focus:border-accent-300" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-6 flex items-center gap-2">
          <%= f.check_box :remember_me, class: "rounded border-slate-300 text-accent focus:ring-accent dark:border-slate-600 dark:text-accent-300 dark:focus:ring-accent-300" %>
          <%= f.label :remember_me, class: "text-xs text-slate-500 dark:text-slate-300" %>
        </div>
      <% end %>

      <%= f.submit "Log in",
            class: "w-full py-2.5 bg-accent dark:bg-accent-600 text-white tracking-wider text-xs rounded-sm inline-block cursor-pointer text-center uppercase hover:bg-accent-700 dark:hover:bg-accent-700 transition-colors" %>
    <% end %>

    <div class="mt-6 text-center">
      <%- if devise_mapping.recoverable? %>
        <%= link_to "Forgot your password?", new_password_path(resource_name),
              class: "text-xs text-accent dark:text-accent-300 hover:underline" %>
      <% end %>
    </div>
  </div>
</div>
  </div>
</div>
