<div class="w-full max-w-sm">
  <div class="bg-white border border-slate-200 shadow-sm px-8 py-10">
    <div class="text-center mb-8">
      <span class="material-symbols-outlined text-accent text-3xl mb-2">lock</span>
      <h1 class="text-lg font-semibold text-slate-800">Ok'am Srl</h1>
      <p class="text-xs text-slate-400 mt-1">Sign in to your account</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-5">
        <%= f.label :email, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full border border-slate-300 outline-none px-3 py-2 text-sm focus:border-accent focus:ring-1 focus:ring-accent transition-colors" %>
      </div>

      <div class="mb-5">
        <%= f.label :password, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1.5" %>
        <%= f.password_field :password, autocomplete: "password",
              class: "w-full border border-slate-300 outline-none px-3 py-2 text-sm focus:border-accent focus:ring-1 focus:ring-accent transition-colors" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-6 flex items-center gap-2">
          <%= f.check_box :remember_me, class: "rounded border-slate-300 text-accent focus:ring-accent" %>
          <%= f.label :remember_me, class: "text-xs text-slate-500" %>
        </div>
      <% end %>

      <%= f.submit "Log in",
            class: "w-full py-2.5 bg-accent text-white tracking-wider text-xs rounded-sm inline-block cursor-pointer text-center uppercase hover:bg-accent-700 transition-colors" %>
    <% end %>
  </div>
</div>
