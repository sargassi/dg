<% menu = [
  { label: 'Dashboard', path: directory_dashboard_path, active: true, icon: 'dashboard', can: 'manage_directory' },
  { label: 'Anagrafiche', path: directory_path, active: false, icon: 'contact_page', can: 'manage_directory' },
  { label: 'Calendario', path: directory_events_path, active: false, icon: 'calendar_month', can: 'manage_events_calendar' },
] %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: {link: '/', label: 'Anagrafiche', menu: menu} %>
</div>

<section class="<%= style_main_cnt %>">
  <div class="<%= style_main_card_grid %>">

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">contact_page</span>
        Anagrafiche
      </h3>
      <div class="space-y-3">
        <%= link_to directory_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Anagrafiche</span>
          <span class="<%= style_main_card_badge %>"><%= @users_count %></span>
        <% end %>
      </div>
    </div>

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">calendar_month</span>
        Calendario
      </h3>
      <div class="space-y-3">
        <%= link_to directory_events_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Calendario Eventi</span>
          <span class="<%= style_main_card_badge %>"><%= @events_count %></span>
        <% end %>
      </div>
    </div>

  </div>
</section>
