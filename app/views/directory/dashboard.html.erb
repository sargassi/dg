<% menu = [
  { label: 'Dashboard', path: directory_dashboard_path, active: true, icon: 'dashboard', can: 'manage_directory' },
  { label: 'Anagrafiche', path: directory_path, active: false, icon: 'contact_page', can: 'manage_directory' },
  { label: 'Calendario', path: directory_events_path, active: false, icon: 'calendar_month', can: 'manage_events_calendar' },
  { label: 'Cerca Eventi', path: search_directory_events_path, active: false, icon: 'search', can: 'manage_events_calendar' },
] %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: {link: '/', label: 'Anagrafiche', menu: menu} %>
</div>

<section class="<%= style_main_cnt %>">
  <div class="<%= style_main_card_grid %>">

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">contact_page</span>
        Anagrafiche
      </h3>
      <div class="space-y-3">
        <%= link_to directory_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Anagrafiche</span>
          <span class="<%= style_main_card_badge %>"><%= @users_count %></span>
        <% end %>
      </div>
    </div>

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">calendar_month</span>
        Calendario
      </h3>
      <div class="space-y-3">
        <%= link_to directory_events_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Calendario Eventi</span>
          <span class="<%= style_main_card_badge %>"><%= @events_count %></span>
        <% end %>
        <%= link_to search_directory_events_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Cerca Eventi</span>
          <span class="material-symbols-outlined text-base text-slate-400 dark:text-slate-500">search</span>
        <% end %>
      </div>
    </div>

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">upcoming</span>
        Prossimi Eventi
      </h3>
      <div class="space-y-2">
        <% if @upcoming_events.any? %>
          <% @upcoming_events.each do |event| %>
            <%= link_to edit_directory_event_path(event, start_date: event.start_time, selected_date: event.start_time),
                  class: "flex items-center gap-2 px-2 py-1.5 rounded text-sm hover:bg-slate-50 dark:hover:bg-slate-700/50 transition group",
                  data: { turbo_frame: "event_modal" } do %>
              <div class="w-2 h-2 rounded-full flex-shrink-0" style="background: <%= event.display_color %>"></div>
              <span class="flex-1 min-w-0 truncate text-slate-700 dark:text-slate-200"><%= event.name %></span>
              <span class="text-xs text-slate-400 dark:text-slate-500 font-mono flex-shrink-0"><%= l(event.start_time, format: '%d/%m') %></span>
            <% end %>
          <% end %>
        <% else %>
          <p class="text-sm text-slate-400 dark:text-slate-500 italic">Nessun evento in arrivo</p>
        <% end %>
      </div>
    </div>

  </div>
</section>
