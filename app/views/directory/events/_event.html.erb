<div id="<%= dom_id event %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Name:</strong>
    <%= event.name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Start time:</strong>
    <%= event.start_time %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">End time:</strong>
    <%= event.end_time %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Eventype:</strong>
    <%= event.eventype_id %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this event", directory_event_path(event), class: "#{style_btn(variant: :neutral)}" %>
    <%= link_to "Edit this event", edit_directory_event_path(event), class: "ml-2 #{style_btn(variant: :neutral)}" %>
    <hr class="mt-6">
  <% end %>
</div>
