<% menu = [
  { label: 'Calendario', path: directory_events_path, active: false, icon: 'calendar_month', can: 'manage_events_calendar' },
  { label: 'Cerca', path: search_directory_events_path, active: true, icon: 'search', can: 'manage_events_calendar' },
] %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: {link: '/', label: 'Eventi', menu: menu} %>
</div>

<section class="<%= style_main_cnt %> flex flex-col" style="height: calc(100vh - 140px);" data-controller="search-filter">
  <div class="flex gap-4 items-center mb-4 flex-none">
    <%= form_with url: search_directory_events_path, method: :get,
                  data: { search_filter_target: "form", turbo_frame: "events-table" },
                  class: "flex items-center gap-3" do |f| %>
      <div class="relative">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 text-base pointer-events-none">search</span>
        <%= f.search_field :q,
              value: params[:q],
              placeholder: "Cerca per nome o descrizione",
              class: "#{style_search_input} rounded-lg pl-10 font-mono text-blue-600 dark:text-blue-400",
              data: { action: "input->search-filter#filter", search_filter_target: "input" } %>
      </div>
      <%= f.collection_select :eventype_id, @eventypes, :id, :name,
            { include_blank: "-", selected: params[:eventype_id] },
            class: "border border-accent-100 outline-none p-2 text-xs bg-white dark:bg-slate-700 dark:text-slate-200 dark:border-slate-600 rounded-lg shadow-sm w-40",
            data: { action: "change->search-filter#filter" } %>
      <%= f.date_field :date_from,
            value: params[:date_from],
            class: "border border-accent-100 outline-none p-2 text-xs bg-white dark:bg-slate-700 dark:text-slate-200 dark:border-slate-600 rounded-lg shadow-sm w-36",
            data: { action: "change->search-filter#filter" } %>
      <%= f.date_field :date_to,
            value: params[:date_to],
            class: "border border-accent-100 outline-none p-2 text-xs bg-white dark:bg-slate-700 dark:text-slate-200 dark:border-slate-600 rounded-lg shadow-sm w-36",
            data: { action: "change->search-filter#filter" } %>
    <% end %>
    <span class="text-sm font-bold text-slate-700 dark:text-slate-200 whitespace-nowrap border border-slate-300 dark:border-slate-600 dark:bg-slate-700 rounded-full px-3 py-1" data-search-filter-target="count"><%= @pagy.count %> eventi</span>
  </div>

  <style>
    turbo-frame#events-table[busy] .events-table-content { display: none; }
    turbo-frame#events-table[busy] .events-table-loader { display: flex; }
  </style>
  <%= turbo_frame_tag "events-table", class: "flex flex-col flex-1 min-h-0", data: { action: "turbo:frame-load->search-filter#onFrameLoad" } do %>
    <div class="events-table-content flex flex-col flex-1 min-h-0">
      <span hidden data-filtered-count><%= @pagy.count %></span>
      <div class="overflow-x-auto flex-1 min-h-0 overflow-y-auto">
        <table class="min-w-full">
          <thead>
            <tr>
              <% %w[Nome Eventype Inizio Fine Ricorrenza Utente Abilitato Azioni].each do |h| %>
                <th class="<%= style_table_th %> sticky top-0 z-10"><%= h %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @events.each do |event| %>
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50">
                <td class="<%= style_table_td %> font-medium text-slate-900 dark:text-slate-100">
                  <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full flex-shrink-0" style="background: <%= event.display_color %>"></div>
                    <%= event.name %>
                  </div>
                </td>
                <td class="<%= style_table_td %> text-slate-600 dark:text-slate-400"><%= event.eventype&.name %></td>
                <td class="<%= style_table_td %> font-mono text-xs"><%= event.start_time&.strftime("%d/%m/%Y") %></td>
                <td class="<%= style_table_td %> font-mono text-xs"><%= event.end_time&.strftime("%d/%m/%Y") %></td>
                <td class="<%= style_table_td %>">
                  <% if event.recurrent_yearly? %>
                    <span class="text-xs bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 px-2 py-0.5 rounded-full">Annuale</span>
                  <% elsif event.recurrent_monthly? %>
                    <span class="text-xs bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 px-2 py-0.5 rounded-full">Mensile</span>
                  <% elsif event.recurrent_weekly? %>
                    <span class="text-xs bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300 px-2 py-0.5 rounded-full">Settimanale</span>
                  <% elsif event.recurrent_daily? %>
                    <span class="text-xs bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 px-2 py-0.5 rounded-full">Giornaliero</span>
                  <% else %>
                    <span class="text-xs text-slate-400 dark:text-slate-500">-</span>
                  <% end %>
                </td>
                <td class="<%= style_table_td %>"><%= event.user ? [event.user.name, event.user.lastname].compact.join(' ') : "-" %></td>
                <td class="<%= style_table_td %>">
                  <%= button_to toggle_enabled_directory_event_path(event, start_date: params[:start_date] || event.start_time, selected_date: params[:selected_date] || Date.today),
                        method: :patch,
                        class: "inline-flex items-center gap-1 px-2 py-1 rounded text-xs border transition",
                        data: { turbo_frame: "events-table" },
                        title: event.enabled? ? "Disabilita" : "Abilita" do %>
                    <% if event.enabled? %>
                      <span class="material-symbols-outlined text-sm text-green-600 dark:text-green-400">visibility</span>
                      <span class="text-green-700 dark:text-green-300">Sì</span>
                    <% else %>
                      <span class="material-symbols-outlined text-sm text-red-400 dark:text-red-300">visibility_off</span>
                      <span class="text-red-500 dark:text-red-400">No</span>
                    <% end %>
                  <% end %>
                </td>
                <td class="<%= style_table_td %> whitespace-nowrap align-middle">
                  <div class="flex items-center gap-1">
                    <%= link_to edit_directory_event_path(event, start_date: event.start_time, selected_date: event.start_time),
                          class: "p-1.5 rounded text-accent dark:text-accent-300 hover:text-accent-700 dark:hover:text-accent-200 hover:bg-accent-50 dark:hover:bg-accent-900/30 transition border border-accent-200 dark:border-accent-600",
                          data: { turbo_frame: "event_modal" } do %>
                      <span class="material-symbols-outlined text-lg">edit</span>
                    <% end %>
                    <%= button_to directory_event_path(event), method: :delete,
                          class: "p-1.5 rounded text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 hover:bg-red-50 dark:hover:bg-red-900/30 transition border border-red-200 dark:border-red-600",
                          data: { turbo_confirm: "Eliminare questo evento?", turbo_frame: "_top" } do %>
                      <span class="material-symbols-outlined text-lg">delete</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
            <% if @events.empty? %>
              <tr>
                <td colspan="8" class="<%= style_table_td %> text-center text-slate-400 dark:text-slate-500 italic py-8">Nessun evento trovato</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="mt-4 flex items-center gap-0.5 justify-end">
          <% if @pagy.prev %>
            <a href="<%= pagy_url_for(@pagy, @pagy.prev) %>"
               data-turbo-frame="events-table"
               class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
              <span class="material-symbols-outlined text-base">chevron_left</span>
            </a>
          <% else %>
            <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-300 dark:text-slate-500 pointer-events-none">
              <span class="material-symbols-outlined text-base">chevron_left</span>
            </span>
          <% end %>

          <% @pagy.series.each do |item| %>
            <% if item.is_a?(Integer) %>
              <a href="<%= pagy_url_for(@pagy, item) %>"
                 data-turbo-frame="events-table"
                 class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                <%= item %>
              </a>
            <% elsif item == :gap %>
              <span class="px-1 text-slate-400 dark:text-slate-500 text-xs">…</span>
            <% elsif item == @pagy.page %>
              <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm bg-accent text-white font-medium">
                <%= item %>
              </span>
            <% end %>
          <% end %>

          <% if @pagy.next %>
            <a href="<%= pagy_url_for(@pagy, @pagy.next) %>"
               data-turbo-frame="events-table"
               class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
              <span class="material-symbols-outlined text-base">chevron_right</span>
            </a>
          <% else %>
            <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-300 dark:text-slate-500 pointer-events-none">
              <span class="material-symbols-outlined text-base">chevron_right</span>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="events-table-loader hidden justify-center items-center py-12">
      <svg class="animate-spin h-10 w-10 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="ml-3 text-slate-600 dark:text-slate-300">Ricerca in corso...</span>
    </div>
  <% end %>
</section>

<%= turbo_frame_tag "event_modal" %>