<div id="<%= dom_id eticamp %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Itemcode:</strong>
    <%= eticamp.itemcode %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Fabricode:</strong>
    <%= eticamp.fabricode %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Varcode:</strong>
    <%= eticamp.varcode %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Season:</strong>
    <%= eticamp.season %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Group:</strong>
    <%= eticamp.group %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this eticamp", eticamp, class: "#{style_btn(variant: :neutral)}" %>
    <%= link_to "Edit this eticamp", edit_eticamp_path(eticamp), class: "ml-2 #{style_btn(variant: :neutral)}" %>
    <hr class="mt-6">
  <% end %>
</div>
