  </div>

  <div class="my-5">
    <%= form.label :cspediti %>
    <%= form.text_field :cspediti, class: ["block shadow rounded-sm border outline-none px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": eticheck.errors[:cspediti].none?, "border-red-400 focus:outline-red-600": eticheck.errors[:cspediti].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "#{style_btn(variant: :success)}" %>
  </div>
<% end %>
