  </div>

  <div class="my-5">
    <%= form.label :materiale %>
    <%= form.text_field :materiale, class: ["block shadow rounded-sm border outline-none px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": eticheck.errors[:materiale].none?, "border-red-400 focus:outline-red-600": eticheck.errors[:materiale].any?}] %>
