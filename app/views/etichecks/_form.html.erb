<%= form_with(model: eticheck, class: "contents") do |form| %>
  <% if eticheck.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-sm mt-3">
      <h2><%= pluralize(eticheck.errors.count, "error") %> prohibited this eticheck from being saved:</h2>

      <ul class="list-disc ml-6">
        <% eticheck.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :itemcode %>
    <%= form.text_field :itemcode, class: ["block shadow rounded-sm border outline-none px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": eticheck.errors[:itemcode].none?, "border-red-400 focus:outline-red-600": eticheck.errors[:itemcode].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :fabricode %>
    <%= form.text_field :fabricode, class: ["block shadow rounded-sm border outline-none px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": eticheck.errors[:fabricode].none?, "border-red-400 focus:outline-red-600": eticheck.errors[:fabricode].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :varcode %>
    <%= form.text_field :varcode, class: ["block shadow rounded-sm border outline-none px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": eticheck.errors[:varcode].none?, "border-red-400 focus:outline-red-600": eticheck.errors[:varcode].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :group %>
    <%= form.number_field :group, class: ["block shadow rounded-sm border outline-none px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": eticheck.errors[:group].none?, "border-red-400 focus:outline-red-600": eticheck.errors[:group].any?}] %>
  </div>

  <div class="my-5">
