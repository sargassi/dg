    <%= form.text_field :tg, class: ["block shadow rounded-sm border outline-none px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": eticheck.errors[:tg].none?, "border-red-400 focus:outline-red-600": eticheck.errors[:tg].any?}] %>
  </div>

  <div class="my-5">
