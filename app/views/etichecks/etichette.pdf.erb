<div id="lab">
        <% counter = 0 %>
        <% i = 0 %>
       <% @products.each do |iz, val| %>
        <% if i == 0 %>
          <% val.sort.each do |product| %>
             <% qty = product.qt.to_i %>
             <% cqty  = 0 %>
              <% qty.times do %>
                  <div class="cell sm" style="border: 1px solid; padding: 2mm 4mm">
                    <div class="sub" style="height:32mm">
                    <p class="sm" style="border-bottom: 1px dashed #ccc; padding-bottom:.35mm; font-size: 8pt!important; height: 12mm">
                        <span style="font-weight:bold">articolo:</span> <%= product.itemcode %> <%= product.fabricode %> <%= product.varcode %>

                      <%= raw(product.description.gsub(/\R+/, '<br/>')) %> <%= product.materiale %> <%= product.fabric  %>
                   tg <%= product.tg %></p>

                 <% cqty = cqty + 1 %>

                <p class="sm" style="border-bottom: 1px dashed #ccc; padding-bottom:.35mm; padding-top:.5mm; font-size: 8pt!important">
                <span style="font-weight:bold; margin-right: 1mm">cliente:</span><%= product.chi %>
                <% if qty > 1 %>
                  <%= cqty %> / <%= qty %>
                  <% end %>
                </p>

                <p class="sm" style="border-bottom: 1px dashed #ccc; padding-bottom:.35mm; padding-top:.5mm; font-size: 8pt!important">
                <span style="font-weight:bold; margin-right: 1mm">tagliato da:</span>
                </p>
                <p class="sm" style="border-bottom: 1px dashed #ccc; padding-bottom:.35mm; padding-top:.5mm; font-size: 8pt!important">
                <span style="font-weight:bold; margin-right: 1mm">cucito da:</span>
                </p>
                <p class="sm" style="border-bottom: 1px dashed #ccc; padding-bottom:.35mm; padding-top:.5mm; font-size: 8pt!important">
                <span style="font-weight:bold; margin-right: 1mm">lavato da:</span>
                </p>
                <p class="sm" style="border-bottom: 1px dashed #ccc; padding-bottom:.35mm; padding-top:.5mm; font-size: 8pt!important">
                <span style="font-weight:bold; margin-right: 1mm">controllato da:</span>
                </p>

            </div>

                <% counter = counter + 1 %>
                </div>
              <% if counter.modulo(24) == 0 %>
              <div style="clear:both; page-break-after: always;"></div>
              <% end %>
            <% end %>

          <% end %>

        <% i += 1 %>
    <% end %>
    <% end %>
</div>
