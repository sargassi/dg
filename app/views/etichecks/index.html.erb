<% content_for :title, "Etichecks" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-sm inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Etichecks</h1>
    <%= link_to "New eticheck", new_eticheck_path, class: "#{style_btn(variant: :primary)}" %>
  </div>

  <div id="etichecks" class="min-w-full">
    <% if @etichecks.any? %>
      <% @etichecks.each do |eticheck| %>
        <%= render eticheck %>
        <p>
          <%= link_to "Show this eticheck", eticheck, class: "ml-2 #{style_btn(variant: :neutral)}" %>
        </p>
      <% end %>
    <% else %>
      <p class="text-center my-10">No etichecks found.</p>
    <% end %>
  </div>
</div>
