<% content_for :title, "Showing eticheck" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-sm inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing eticheck</h1>

  <%= render @eticheck %>

  <%= link_to "Edit this eticheck", edit_eticheck_path(@eticheck), class: "mt-2 rounded-sm px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to etichecks", etichecks_path, class: "ml-2 rounded-sm px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <div class="inline-block ml-2">
    <%= button_to "Destroy this eticheck", @eticheck, method: :delete, class: "mt-2 rounded-sm px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium" %>
  </div>
</div>
