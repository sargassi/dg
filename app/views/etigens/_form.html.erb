<%= form_with(model: etigen, class: "contents") do |form| %>

    <div class="flex justify-between">
        <span class="leading-tight h-8 block grow relative">

            <%= form.text_field riga,  class: "w-full p-0 m-0 leading-tight border-0 bg-slate-50  shadow-xl w-4/5 absolute p-2" %>
            <%= hidden_field_tag :src, nil, :value => 'num' %>
        </span>
        <%= form.submit 'Ok', class:"no-pdf text-center text-xs uppercase cursor-pointer w-12 bg-green-100 h-8" %>
    </div>


<% end %>
