<%= form_with(model: etigen, class: "contents") do |form| %>

    <div class="flex justify-between">
        <span class="leading-tight h-8 block grow relative">

        <%= form.number_field :qty, class: " p-0 m-0 leading-tight border-0 bg-slate-50  shadow-xl w-10   p-1 pb-2 rounded-l-full text-center" %>
        <%= hidden_field_tag :src, nil, :value => 'qty' %>
        </span>
        <%= form.submit 'Ok', class:"no-pdf text-center text-xs uppercase cursor-pointer w-10 bg-green-100 h-8 ", data:{turbo_frame:"_top"}%>
    </div>


<% end %>
