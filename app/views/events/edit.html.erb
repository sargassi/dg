<%= turbo_frame_tag "event_modal" do %>
  <div class="fixed inset-0 bg-black/30 backdrop-blur-sm z-50 flex items-start justify-center pt-20" data-controller="insertevent" data-action="click->insertevent#closeModal">
    <div class="bg-white border border-slate-200 shadow-lg w-full max-w-md mx-4" data-action="click->insertevent#stopPropagation">
      <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-700">Modifica Evento</h2>
        <%= link_to events_path(start_date: params[:start_date] || @event.start_time, selected_date: params[:selected_date]),
              class: "text-slate-400 hover:text-slate-600 transition",
              data: { turbo_frame: "_top" } do %>
          <span class="material-symbols-outlined text-lg">close</span>
        <% end %>
      </div>
      <div class="p-4">
        <%= render "form", event: @event %>

        <div class="flex justify-end mt-4 pt-4 border-t border-slate-200">
          <%= button_to event_path(@event), method: :delete,
                class: "p-3 inline-flex items-center gap-1.5 tracking-wider rounded-sm uppercase text-xs cursor-pointer text-red-500 border border-red-500 hover:bg-red-50 transition",
                data: { turbo_confirm: "Eliminare questo evento?" } do %>
            <span class="material-symbols-outlined text-sm leading-none">delete</span>
            Elimina
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>