<% first_day = @date.beginning_of_month.beginning_of_week(:monday) %>
<% last_day = @date.end_of_month.end_of_week(:sunday) %>
<% days = (first_day..last_day).to_a %>
<% today = Date.today %>

<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: {link: '/', label: 'Calendario'} %>
</div>

<section class="<%= style_main_cnt %>">
  <%= turbo_frame_tag "calendar", data: { controller: "insertevent" } do %>

    <div class="flex gap-8">

      <div class="grow min-w-0">

        <%= render 'calendar_header', start_date: @date, selected_date: @todate %>

        <div class="overflow-x-auto">
          <div class="grid grid-cols-7 border-t border-l border-slate-200 min-w-[560px]">
            <% calendar_weekdays_short.each do |wd| %>
              <div class="border-r border-b border-slate-200 px-1.5 py-2 text-center text-[11px] font-semibold text-slate-500 uppercase tracking-wide">
                <%= wd %>
              </div>
            <% end %>

            <% days.each do |day| %>
              <div class="<%= calendar_cell_classes(day, today, @todate) %> cursor-pointer"
                   data-action="click->insertevent#selectDay"
                   data-date="<%= day %>">
                <div class="flex flex-col items-center">
                  <span class="<%= calendar_day_wrapper_classes(day, @todate) %>">
                    <span class="<%= calendar_day_classes(day, today, @todate) %>"><%= day.day %></span>
                  </span>
                  <% if day == today %>
                    <div class="w-1 h-1 rounded-full bg-red-400 mt-0.5"></div>
                  <% end %>
                </div>
                <% events_today_cell = calendar_events_for_day(day, @events) %>
                <% if events_today_cell.any? %>
                  <div class="mt-2 space-y-0.5">
                    <% events_today_cell.first(5).each do |event| %>
                      <div class="flex items-center gap-1 px-0.5">
                        <div class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background: <%= event.display_color %>"></div>
                        <span class="text-[10px] text-slate-600 truncate"><%= event.name %></span>
                      </div>
                    <% end %>
                    <% if events_today_cell.size > 5 %>
                      <span class="text-[10px] text-slate-400 pl-2">+<%= events_today_cell.size - 5 %> more</span>
                    <% end %>
                  </div>
                <% end %>
                <% if day == @todate %>
                  <%= link_to new_event_path(start_date: day, selected_date: day),
                        class: "absolute bottom-0 right-0 text-blue-500 hover:text-blue-700 transition",
                        data: { turbo_frame: "event_modal" } do %>
                    <span class="material-symbols-outlined text-base">add_circle</span>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

      </div>

      <div class="w-96 flex-shrink-0 border-l border-slate-100 p-6 relative  ">
          <div class="flex gap-4 items-center mb-8 mt-1">
        <h4 class="text-slate-700 capitalize  px-2 py-2 border-b grow  border-slate-200">
          <%= l(@todate, format: '%A, %d %B %Y') %>
        </h4>

        <%= link_to new_event_path(start_date: @todate, selected_date: @todate),
              class: "flex flex-col w-16  items-center justify-center gap-1  p-2  bg-blue-500 tracking-wider  uppercase text-xs cursor-pointer text-white",
              data: { turbo_frame: "event_modal" } do %>
          <span class="material-symbols-outlined text-base">add</span>
        <% end %>
          </div>
        <% if @day_events.any? %>
          <div class="space-y-2">
            <% @day_events.each do |event| %>
              <%= link_to edit_event_path(event, start_date: @date, selected_date: @todate),
                    class: "flex flex-col px-3 py-2 border-b border-slate-100 hover:bg-slate-50 transition rounded-sm",
                    data: { turbo_frame: "event_modal" } do %>
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 rounded-full flex-shrink-0" style="background: <%= event.display_color %>"></div>
                  <span class="text-sm text-slate-800"><%= event.name %></span>
                  <span class="text-xxs text-slate-400 ml-auto uppercase"><%= event.eventype&.name %></span>
                </div>
                <% if event.description.present? %>
                  <span class="text-xs text-slate-400 mt-0.5 ml-6 line-clamp-1"><%= event.description %></span>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-slate-400 italic py-4 text-center">Nessun evento per questo giorno</p>
        <% end %>

        <% if @week_events.any? %>


          <div class="space-y-3">
            <% ((@todate + 1)..@end_of_week).each do |day| %>
              <% events_for_day = calendar_events_for_day(day, @week_events) %>
              <% if events_for_day.any? %>
                <div class="mt-8 px-2">
                  <p class="text-[10px] font-medium text-slate-500 mb-0.5"><%= l(day, format: '%A %d') %></p>
                  <div class="space-y-0.5">
                    <% events_for_day.each do |event| %>
                      <%= link_to edit_event_path(event, start_date: @date, selected_date: @todate),
                            class: "flex items-center gap-1.5 px-1.5 py-0.5 hover:bg-slate-50 transition rounded-sm",
                            data: { turbo_frame: "event_modal" } do %>
                        <div class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background: <%= event.display_color %>"></div>
                        <span class="text-[11px] text-slate-400 truncate"><%= event.name %></span>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>

      </div>

    </div>

  <% end %>
</section>

<%= turbo_frame_tag "event_modal" %>
<%= turbo_frame_tag "quick_eventype_modal" %>
