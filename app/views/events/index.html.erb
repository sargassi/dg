<div class="<%= style_main_header_container %>">
    <%= render partial: 'atoms/header', locals: {link: '/', label: 'Calendario'} %>
</div>
<section class="<%= style_main_cnt %> flex gap-8">
    <div class="<%= style_main_lists_sub %> grow p-2">
       <%= render partial: 'atoms/ux/cal' %>
    </div>
    <div class="<%= style_main_lists_sub %> w-1/4">
    <h4 class="font-semibold text-slate-500 mt-2 mb-4 border-b border-t p-2 capitalize"> <%= @todate.strftime('%A, %d-%m-%Y') %></h4>
    <div class="p-2">
       <%= link_to new_event_path(:start_date => params[:start_date]), class: style_main_btn  do %>
           <span class="material-symbols-outlined">
           event
           </span>
         <% end %>
       <% if !@evx.empty? %>
         <%= render partial: 'event_detail', locals: {section: 'side'} %>
       <% end %>
    </div>
    </div>
</section>
