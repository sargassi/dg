<div id="<%= dom_id eventype %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Name:</strong>
    <%= eventype.name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Enabled:</strong>
    <%= eventype.enabled %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this eventype", eventype, class: "#{style_btn(variant: :neutral)}" %>
    <%= link_to "Edit this eventype", edit_eventype_path(eventype), class: "ml-2 #{style_btn(variant: :neutral)}" %>
    <hr class="mt-6">
  <% end %>
</div>
