<div id="<%= dom_id eventype %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Name:</strong>
    <%= eventype.name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Enabled:</strong>
    <%= eventype.enabled %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this eventype", eventype, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to "Edit this eventype", edit_eventype_path(eventype), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
