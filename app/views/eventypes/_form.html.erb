<%= form_with(model: eventype, class: "contents") do |form| %>
  <% if eventype.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3">
      <h2><%= pluralize(eventype.errors.count, "error") %> prohibited this eventype from being saved:</h2>

      <ul>
        <% eventype.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: "block shadow rounded-sm border border-slate-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :color, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
    <div class="flex gap-3 items-center">
      <%= form.color_field :color, class: "h-8 w-12 border border-slate-300 cursor-pointer" %>
      <%= form.text_field :color, class: "border border-slate-300 outline-none px-3 py-2 w-32 text-xs font-mono" %>
    </div>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.check_box :enabled, class: "h-4 w-4" %>
    <%= form.label :enabled, class: "text-xs text-slate-500" %>
  </div>

  <div>
    <%= form.submit class: "p-3 my-4 bg-accent inline-block tracking-wider rounded-sm uppercase text-xs cursor-pointer text-white" %>
  </div>
<% end %>
