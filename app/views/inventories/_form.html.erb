<%= form_with(model: inventory, class: "contents") do |form| %>
  <% if inventory.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3">
      <h2><%= pluralize(inventory.errors.count, "error") %> prohibited this inventory from being saved:</h2>

      <ul>
        <% inventory.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :qtyavailable %>
    <%= form.number_field :qtyavailable, class: "block shadow rounded-sm border border-slate-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :minstock %>
    <%= form.number_field :minstock, class: "block shadow rounded-sm border border-slate-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :maxstock %>
    <%= form.number_field :maxstock, class: "block shadow rounded-sm border border-slate-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :warehouse_id %>
    <%= form.text_field :warehouse_id, class: "block shadow rounded-sm border border-slate-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :location_id %>
    <%= form.text_field :location_id, class: "block shadow rounded-sm border border-slate-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :itemcode %>
    <%= form.text_field :itemcode, class: "block shadow rounded-sm border border-slate-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :operationtype_id %>
    <%= form.text_field :operationtype_id, class: "block shadow rounded-sm border border-slate-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :itemins_id %>
    <%= form.text_field :itemins_id, class: "block shadow rounded-sm border border-slate-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :itemouts_id %>
    <%= form.text_field :itemouts_id, class: "block shadow rounded-sm border border-slate-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :enabled %>
    <%= form.check_box :enabled, class: "block mt-2 h-5 w-5" %>
  </div>

  <div class="inline">
    <%= form.submit class: "rounded-lg py-3 px-5 #{style_save_button} inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
