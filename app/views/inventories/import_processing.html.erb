<% content_for :page_header do %>
<%= render "application/breadcrumb", dashboard_path: inventories_dashboard_path, section_name: "Magazzino", page_title: "Import / Elaborazione" %>
<% end %>

<section class="<%= style_main_cnt %>" data-controller="import-progress"
         data-import-progress-url-value="<%= inventories_import_status_path %>">
  <div class="max-w-md mx-auto bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg p-8 text-center">
    <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-6">Elaborazione file in corso...</h2>

    <div class="mb-4">
      <div class="flex justify-between text-sm text-slate-600 dark:text-slate-300 mb-2">
        <span data-import-progress-target="label">Lettura del file</span>
        <span data-import-progress-target="percent">0%</span>
      </div>
      <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-4 overflow-hidden">
        <div data-import-progress-target="bar"
             class="bg-blue-600 h-full rounded-full transition-all duration-500"
             style="width: 0%"></div>
      </div>
    </div>

    <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
      Il file può essere di grandi dimensioni: l'elaborazione può richiedere diversi minuti.
      Puoi tenere questa pagina aperta.
    </p>

    <div data-import-progress-target="spinner" class="flex justify-center mb-6">
      <svg class="animate-spin h-8 w-8 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </div>

    <div data-import-progress-target="done" class="hidden">
      <p class="text-green-600 font-semibold mb-4">Elaborazione completata</p>
      <%= link_to "Vai all'anteprima", inventories_import_path,
            class: "#{style_btn(variant: :success)}" %>
    </div>

    <div data-import-progress-target="error" class="hidden">
      <p class="text-red-600 font-semibold mb-2">Errore durante l'elaborazione</p>
      <p class="text-sm text-slate-600 dark:text-slate-400 mb-4" data-import-progress-target="errorMessage"></p>
      <%= link_to "Torna all'import", inventories_import_path,
            class: "#{style_btn(variant: :neutral)}" %>
    </div>
  </div>
</section>