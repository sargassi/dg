<% menu = [
  { label: 'Dashboard', path: inventories_dashboard_path, active: false, icon: 'dashboard', can: 'manage_inventory' },
  { label: 'Ricerca magazzino', path: inventories_path, active: true, icon: 'inventory_2', can: 'manage_inventory' },
  { label: 'Movimenti', path: inventories_movements_path, active: false, icon: 'swap_vert', can: 'manage_itemins' },
  { label: 'Magazzini e ubiche', path: warehouses_path, active: false, icon: 'warehouse', can: 'manage_warehouses' },
] %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: {link: '/', label: 'Ricerca', menu: menu} %>
</div>

<section class="<%= style_main_cnt %> flex flex-col" style="height: calc(100vh - 140px);" data-controller="search-filter">
  <div class="flex gap-4 items-center mb-4 flex-none">
    <%= form_with url: inventories_path, method: :get,
                  data: { search_filter_target: "form", turbo_frame: "inventories-table" },
                  class: "flex items-center gap-3" do |f| %>
      <div class="relative">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 text-base pointer-events-none">search</span>
        <%= f.search_field :q,
              value: params[:q],
              placeholder: "Cerca articolo",
              class: "#{style_search_input} rounded-lg pl-10 font-mono text-blue-600",
              data: { action: "input->search-filter#filter", search_filter_target: "input" } %>
      </div>
      <%= f.date_field :date,
            value: @date,
            class: "border border-slate-300 outline-none px-2 py-1.5 text-xs rounded-lg dark:bg-slate-700 dark:text-slate-200 dark:border-slate-600 dark:[color-scheme:dark]",
            data: { action: "change->search-filter#filter" } %>
      <%= f.select :collection_id,
            options_from_collection_for_select(@collections, :id, :description, params[:collection_id]),
            { include_blank: "Tutte le collezioni" },
            class: "border border-slate-300 outline-none px-4 py-2 text-xs rounded-lg min-w-[180px] dark:border-slate-600 bg-white dark:bg-slate-700 dark:text-slate-200",
            data: { action: "change->search-filter#filter", search_filter_target: "select", search_filter_active_class: "bg-blue-400 dark:bg-blue-600 text-white dark:text-white", search_filter_inactive_class: "bg-white dark:bg-slate-700 dark:text-slate-200" } %>
      <%= f.select :warehouse_id,
            options_from_collection_for_select(@warehouses, :id, :code, params[:warehouse_id]),
             { include_blank: "TUTTI I MAGAZZINI" },
            class: "border border-slate-300 outline-none px-4 py-2 text-xs rounded-lg min-w-[180px] uppercase dark:border-slate-600 bg-white dark:bg-slate-700 dark:text-slate-200",
            data: { action: "change->search-filter#filter", search_filter_target: "select", search_filter_active_class: "bg-blue-400 dark:bg-blue-600 text-white dark:text-white", search_filter_inactive_class: "bg-white dark:bg-slate-700 dark:text-slate-200" } %>
      <label class="relative inline-flex items-center gap-2 cursor-pointer">
        <%= f.check_box :show_zero, checked: params[:show_zero] == "1", class: "sr-only peer", data: { action: "change->search-filter#filter", search_filter_target: "input" } %>
        <div class="w-9 h-5 bg-slate-200 dark:bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white dark:after:bg-slate-300 after:border-slate-300 dark:after:border-slate-600 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-accent"></div>
        <span class="text-xs text-slate-400 dark:text-slate-300 uppercase tracking-wide select-none">Mostra zero</span>
      </label>
    <% end %>
    <span class="text-sm font-bold text-slate-700 whitespace-nowrap border border-slate-300 rounded-full px-3 py-1 dark:text-slate-200 dark:border-slate-600 dark:bg-slate-700" data-search-filter-target="count"><%= @pagy.count %> articoli</span>
    <%= link_to export_xlsx_inventories_path(q: params[:q], date: params[:date], collection_id: params[:collection_id], warehouse_id: params[:warehouse_id], show_zero: params[:show_zero], format: :xlsx),
                target: "_blank",
                data: { turbo: false },
                class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg border border-green-600 text-green-600 hover:bg-green-50 dark:border-green-500 dark:text-green-400 dark:hover:bg-green-900/20 ml-auto" do %>
      <span class="material-symbols-outlined text-base">file_download</span>
      Esporta Excel
    <% end %>
  </div>

  <style>
    turbo-frame#inventories-table[busy] .inventories-table-content { display: none; }
    turbo-frame#inventories-table[busy] .inventories-table-loader { display: flex; }
  </style>
  <%= turbo_frame_tag "inventories-table", class: "flex flex-col flex-1 min-h-0", data: { action: "turbo:frame-load->search-filter#onFrameLoad" } do %>
    <div class="inventories-table-content flex flex-col flex-1 min-h-0">
      <span hidden data-filtered-count><%= @pagy.count %></span>
      <div class="overflow-x-auto flex-1 min-h-0 overflow-y-auto">
        <table class="min-w-full">
          <thead>
            <tr>
              <% %w[Codice Collezione Descrizione].each do |h| %>
                <th class="<%= style_table_th %> sticky top-0 z-10"><%= h %></th>
              <% end %>
              <th class="<%= style_table_th %> sticky top-0 z-10 whitespace-nowrap">
                QTA <span class="text-[9px] text-slate-500 ml-1 font-normal dark:text-slate-300">al <span class="font-bold"><%= @date.strftime("%d-%m-%Y") %></span></span>
              </th>
              <% %w[Movimenti Immagine Azioni].each do |h| %>
                <th class="<%= style_table_th %> sticky top-0 z-10"><%= h %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @inventories.each do |inv| %>
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 <%= 'bg-red-50 dark:bg-red-900/10' if (inv.respond_to?(:current_qty) ? inv.current_qty : inv.net_qty.to_i) <= 0 %>">
                <td class="<%= style_table_td %> font-mono whitespace-nowrap">
                  <% item = @items_by_gencode[inv.gencode] %>
                  <%= item.itemcode %><%= item.fabricode %><%= item.varcode %>
                </td>
                <td class="<%= style_table_td %> text-xs font-bold uppercase"><%= @collection_by_gencode[inv.gencode] %></td>
                <td class="<%= style_table_td %> text-xs max-w-[400px] truncate"><%= @items_by_gencode[inv.gencode]&.description %></td>
                <td class="<%= style_table_td %> font-mono font-bold text-lg <%= inv.respond_to?(:current_qty) ? (inv.current_qty >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400') : (inv.net_qty.to_i >= 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400') %>"><%= inv.respond_to?(:current_qty) ? inv.current_qty : inv.net_qty.to_i %></td>
                <td class="<%= style_table_td %> p-0">
                  <table class="w-full text-xs border-collapse table-fixed">
                    <colgroup>
                      <col>
                      <col>
                      <col>
                      <col>
                      <col>
                    </colgroup>
                    <tbody data-controller="spostamenti-toggle">
                       <% (@history_by_gencode[inv.gencode] || {}).each do |wh_id, loc_groups| %>
                           <tr>
                             <td colspan="5" class="px-3 py-2.5 font-bold text-slate-800 bg-slate-100 border border-slate-200 border-l-4 border-l-accent text-sm dark:text-slate-200 dark:bg-slate-700 dark:border-slate-600">
                             <%= loc_groups.values.flatten.first.warehouse&.code || wh_id %>
                             <span class="font-mono text-slate-500 ml-2 dark:text-slate-400">
                               (<%= loc_groups.values.flatten.sum { |r| r.operationtype_id == 1 ? r.qtyavailable.to_i : -r.qtyavailable.to_i } %>)
                             </span>
                             <button type="button" data-action="click->spostamenti-toggle#toggleWh" data-wh-group="<%= wh_id %>" class="inline-flex items-center justify-center float-right text-slate-600 dark:text-slate-300 hover:text-slate-800 dark:hover:text-white bg-transparent p-0.5">
                               <span class="material-symbols-outlined text-lg leading-none">visibility</span>
                             </button>
                           </td>
                         </tr>
                           <% loc_groups.each do |loc_id, records| %>
                             <% non_moves, moves = records.partition { |r| !r.itemmovement_id } %>
                             <tr>
                                <td colspan="5" class="pl-8 pr-1 py-1.5 font-semibold text-slate-600 bg-slate-100 border-l-2 border-l-slate-300 border-b border-slate-300 text-xs uppercase tracking-wider dark:text-slate-300 dark:bg-slate-800/50 dark:border-l-slate-600 dark:border-slate-600">
                                  <button type="button" data-action="click->spostamenti-toggle#toggle" data-group="<%= wh_id %>-<%= loc_id %>" class="inline-flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-white bg-transparent p-0.5 -ml-5 align-middle">
                                    <span class="material-symbols-outlined text-lg leading-none">list</span>
                                  </button>
                                  <%= records.first.location&.code || "—" %> <span class="font-mono text-slate-400 dark:text-slate-500">(<%= records.sum { |r| r.operationtype_id == 1 ? r.qtyavailable.to_i : -r.qtyavailable.to_i } %>)</span>
                             </tr>
                            <tr class="hidden italic bg-white dark:bg-slate-800" data-spostamenti-group="<%= wh_id %>-<%= loc_id %>" data-spostamenti-wh-group="<%= wh_id %>">
                             <td colspan="5" class="p-0">
                               <table class="w-full text-xs border border-slate-300 dark:border-slate-600 border-collapse">
                                 <colgroup>
                                   <col class="w-20">
                                   <col class="w-80">
                                   <col>
                                   <col class="w-12">
                                   <col class="w-16">
                                   <col class="w-14">
                                 </colgroup>
                                  <tbody>
                                    <% non_moves.group_by { |h| [h.operationtype_id, h.itemins_id || h.itemouts_id] }.each do |(op_type, _), group| %>
                                      <% total_qty = group.sum { |h| h.qtyavailable.to_i } %>
                                      <% first = group.first %>
                                      <% if op_type == 1 %>
                                        <% itemin = @itemins_by_id[first.itemins_id] %>
                                        <% date = itemin&.indate %>
                                        <% operator = itemin&.operator %>
                                        <tr class="border-b border-slate-300 dark:border-slate-600 last:border-b-0">
                                          <td class="px-2 py-1.5 whitespace-nowrap text-slate-500 dark:text-slate-400 border-r border-slate-300 dark:border-slate-600"><%= date&.strftime("%d-%m-%Y") %></td>
                                          <td class="px-2 py-1.5 border-r border-slate-300 dark:border-slate-600 text-[10px]"><span class="inline-block bg-green-100 text-green-700 px-1.5 py-0.5 rounded font-semibold leading-tight dark:bg-green-900/30 dark:text-green-300">Entrata</span></td>
                                          <td class="px-2 py-1.5 text-slate-500 dark:text-slate-400 border-r border-slate-300 dark:border-slate-600 text-[10px]"><%= itemin&.notes.presence || "—" %></td>
                                          <td class="px-2 py-1.5 text-right font-mono font-bold text-green-600 dark:text-green-400 border-r border-slate-300 dark:border-slate-600"><%= total_qty %></td>
                                          <td class="px-2 py-1.5 text-slate-500 dark:text-slate-400 border-r border-slate-300 dark:border-slate-600"><%= operator&.name %></td>
                                          <td class="px-2 py-1.5 font-mono text-slate-400 dark:text-slate-500 whitespace-nowrap"><%= "##{first.itemins_id}" %></td>
                                        </tr>
                                      <% else %>
                                        <% itemout = @itemouts_by_id[first.itemouts_id] %>
                                        <% date = itemout&.indate %>
                                        <% operator = itemout&.operator %>
                                        <tr class="border-b border-slate-300 dark:border-slate-600 last:border-b-0">
                                          <td class="px-2 py-1.5 whitespace-nowrap text-slate-500 dark:text-slate-400 border-r border-slate-300 dark:border-slate-600"><%= date&.strftime("%d-%m-%Y") %></td>
                                          <td class="px-2 py-1.5 border-r border-slate-300 dark:border-slate-600 text-[10px]"><span class="inline-block bg-red-100 text-red-700 px-1.5 py-0.5 rounded font-semibold leading-tight dark:bg-red-900/30 dark:text-red-300">Uscita</span></td>
                                          <td class="px-2 py-1.5 text-slate-500 dark:text-slate-400 border-r border-slate-300 dark:border-slate-600 text-[10px]"><%= itemout&.notes.presence || "—" %></td>
                                          <td class="px-2 py-1.5 text-right font-mono font-bold text-red-600 dark:text-red-400 border-r border-slate-300 dark:border-slate-600"><%= "-#{total_qty}" %></td>
                                          <td class="px-2 py-1.5 text-slate-500 dark:text-slate-400 border-r border-slate-300 dark:border-slate-600"><%= operator&.name %></td>
                                          <td class="px-2 py-1.5 font-mono text-slate-400 dark:text-slate-500 whitespace-nowrap"><%= "##{first.itemouts_id}" %></td>
                                        </tr>
                                      <% end %>
                                    <% end %>
                                    <% moves.each do |h| %>
                                     <% mov = @itemmovements_by_id[h.itemmovement_id] %>
                                     <% next unless mov %>
                                     <% da_match = mov.source_location_id == loc_id %>
                                     <tr class="border-b border-slate-300 dark:border-slate-600 last:border-b-0">
                                       <td class="px-2 py-1.5 whitespace-nowrap text-slate-500 dark:text-slate-400 border-r border-slate-300 dark:border-slate-600"><%= mov.indate.strftime("%d-%m-%Y") %></td>
                                        <td class="px-2 py-1.5 text-slate-500 dark:text-slate-400 border-r border-slate-300 dark:border-slate-600 text-[10px]"><span class="inline-block bg-orange-100 text-orange-700 px-1.5 py-0.5 rounded font-semibold leading-tight dark:bg-orange-900/30 dark:text-orange-300 text-[10px]">Variazione</span><br>Da: <%= mov.source_warehouse&.code || "?" %> <%= mov.source_location&.code || "-" %> &nbsp; A: <%= mov.dest_warehouse&.code || "?" %> <%= mov.dest_location&.code || "-" %></td>
                                       <td class="px-2 py-1.5 text-slate-500 dark:text-slate-400 border-r border-slate-300 dark:border-slate-600"><%= mov.notes.presence || "—" %></td>
                                       <td class="px-2 py-1.5 text-right font-mono font-bold text-slate-500 dark:text-slate-400 border-r border-slate-300 dark:border-slate-600"><%= da_match ? "-#{h.qtyavailable}" : h.qtyavailable %></td>
                                       <td class="px-2 py-1.5 text-slate-500 dark:text-slate-400 border-r border-slate-300 dark:border-slate-600"><%= mov.operator&.name %></td>
                                       <td class="px-2 py-1.5 font-mono text-slate-400 dark:text-slate-500 whitespace-nowrap"><%= "#M#{mov.id}" %></td>
                                     </tr>
                                   <% end %>
                                 </tbody>
                               </table>
                             </td>
                            </tr>
                       <% end %>
                     <% end %>
                     </tbody>
                  </table>
                </td>
                <% item = @items_by_gencode[inv.gencode] %>
                <td class="<%= style_table_td %>" style="width:120px">
                  <% if item&.pictures&.attached? %>
                    <%= link_to gallery_item_path(item, index: 0, q: params[:q], return_to: inventories_path(q: params[:q], date: params[:date], warehouse_id: params[:warehouse_id])), data: { turbo_frame: "item_modal" } do %>
                      <div class="relative inline-block">
                        <%= image_tag item.pictures.first, class: "w-[100px] h-[100px] object-cover border border-slate-200 dark:border-slate-600 block" %>
                        <% if item.pictures.count > 1 %>
                          <span class="absolute -top-1.5 -right-1.5 bg-accent text-white text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center leading-none">+<%= item.pictures.count - 1 %></span>
                        <% end %>
                      </div>
                    <% end %>
                  <% end %>
                </td>
                <td class="<%= style_table_td %> whitespace-nowrap">
                  <% if item %>
                    <%= link_to edit_item_path(item, q: params[:q], collection_id: params[:collection_id], return_to: inventories_path(q: params[:q], date: params[:date], warehouse_id: params[:warehouse_id])),
                                class: "inline-flex items-center text-accent hover:text-accent-700",
                                data: { turbo_frame: "item_modal" } do %>
                      <span class="material-symbols-outlined text-lg">edit</span>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="flex-none flex items-center gap-0.5 justify-end pt-3 pb-1">
          <% if @pagy.prev %>
             <a href="<%= pagy_url_for(@pagy, @pagy.prev) %>"
               data-turbo-frame="inventories-table"
               class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 hover:bg-slate-100 transition-colors dark:text-slate-200 dark:hover:bg-slate-700">
               <span class="material-symbols-outlined text-base">chevron_left</span>
             </a>
          <% else %>
             <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-300 dark:text-slate-500 pointer-events-none">
               <span class="material-symbols-outlined text-base">chevron_left</span>
             </span>
          <% end %>

          <% @pagy.series.each do |item| %>
            <% if item.is_a?(Integer) %>
               <a href="<%= pagy_url_for(@pagy, item) %>"
                  data-turbo-frame="inventories-table"
                  class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 hover:bg-slate-100 transition-colors dark:text-slate-200 dark:hover:bg-slate-700">
                 <%= item %>
               </a>
            <% elsif item == :gap %>
              <span class="px-1 text-slate-400 dark:text-slate-500 text-xs">…</span>
            <% elsif item == @pagy.page %>
              <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm bg-accent text-white font-medium">
                <%= item %>
              </span>
            <% end %>
          <% end %>

          <% if @pagy.next %>
             <a href="<%= pagy_url_for(@pagy, @pagy.next) %>"
                data-turbo-frame="inventories-table"
                class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 hover:bg-slate-100 transition-colors dark:text-slate-200 dark:hover:bg-slate-700">
               <span class="material-symbols-outlined text-base">chevron_right</span>
             </a>
          <% else %>
             <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-300 dark:text-slate-500 pointer-events-none">
               <span class="material-symbols-outlined text-base">chevron_right</span>
             </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="inventories-table-loader hidden justify-center items-center py-12">
      <svg class="animate-spin h-10 w-10 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="ml-3 text-slate-600 dark:text-slate-300">Ricerca in corso...</span>
    </div>
  <% end %>
</section>

<%= turbo_frame_tag "item_modal" %>
