<% menu = [
  { label: 'Dashboard', path: inventories_dashboard_path, active: false, icon: 'dashboard' },
  { label: 'Ricerca magazzino', path: inventories_path, active: true, icon: 'inventory_2' },
  { label: 'Magazzino e ubiche', path: warehouses_path, active: false, icon: 'warehouse' },
] %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: {link: '/', label: 'Inventario / Ricerca magazzino', menu: menu} %>
</div>

<section class="<%= style_main_cnt %> flex flex-col" style="height: calc(100vh - 140px);" data-controller="search-filter">
  <div class="flex gap-4 items-center mb-4 flex-none">
    <%= form_with url: inventories_path, method: :get,
                  data: { search_filter_target: "form", turbo_frame: "inventories-table" },
                  class: "flex items-center gap-3" do |f| %>
      <div class="relative">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none">search</span>
        <%= f.search_field :q,
              value: params[:q],
              placeholder: "Cerca in tutte le colonne",
              class: "#{style_search_input} rounded-lg pl-10 font-mono text-blue-600",
              data: { action: "input->search-filter#filter", search_filter_target: "input" } %>
      </div>
    <% end %>
    <span class="text-sm font-bold text-slate-700 whitespace-nowrap border border-slate-300 rounded-full px-3 py-1" data-search-filter-target="count"><%= @pagy.count %> articoli</span>
    <%= link_to "Nuovo Movimento", new_inventory_path, class: "#{style_import_btn} ml-auto" %>
  </div>

  <style>
    turbo-frame#inventories-table[busy] .inventories-table-content { display: none; }
    turbo-frame#inventories-table[busy] .inventories-table-loader { display: flex; }
  </style>
  <%= turbo_frame_tag "inventories-table", class: "flex flex-col flex-1 min-h-0", data: { action: "turbo:frame-load->search-filter#onFrameLoad" } do %>
    <div class="inventories-table-content flex flex-col flex-1 min-h-0">
      <span hidden data-filtered-count><%= @pagy.count %></span>
      <div class="overflow-x-auto flex-1 min-h-0 overflow-y-auto">
        <table class="min-w-full">
          <thead>
            <tr>
              <% %w[ID Itemcode QTA Min Max Magazzino Posizione Operazione Creato Azioni].each do |h| %>
                <th class="<%= style_table_th %> sticky top-0 z-10"><%= h %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @inventories.each do |inv| %>
              <tr class="hover:bg-slate-50">
                <td class="<%= style_table_td %> text-xs font-mono text-blue-600"><%= inv.id %></td>
                <td class="<%= style_table_td %>"><%= inv.itemcode %></td>
                <td class="<%= style_table_td %>"><%= inv.qtyavailable %></td>
                <td class="<%= style_table_td %>"><%= inv.minstock %></td>
                <td class="<%= style_table_td %>"><%= inv.maxstock %></td>
                <td class="<%= style_table_td %>"><%= inv.warehouse&.description || inv.warehouse_id %></td>
                <td class="<%= style_table_td %>"><%= inv.location&.description || inv.location_id %></td>
                <td class="<%= style_table_td %>"><%= inv.operationtype&.description || inv.operationtype_id %></td>
                <td class="<%= style_table_td %> text-xs"><%= inv.created_at&.strftime('%d-%m-%Y') %></td>
                <td class="<%= style_table_td %> whitespace-nowrap align-middle">
                  <div class="flex flex-col items-center gap-0.5">
                    <%= link_to edit_inventory_path(inv, q: params[:q]),
                          class: "p-2 rounded text-accent hover:text-accent-700 hover:bg-accent-50 transition border border-accent-200",
                          data: { turbo_frame: "inventory_modal" } do %>
                      <span class="material-symbols-outlined text-2xl">edit</span>
                    <% end %>
                    <%= button_to inventory_path(inv, q: params[:q]), method: :delete,
                          class: "p-2 rounded text-red-600 hover:text-red-800 hover:bg-red-50 transition border border-red-200",
                          data: { turbo_confirm: "Eliminare questo articolo?", turbo_frame: "_top" } do %>
                      <span class="material-symbols-outlined text-2xl">delete</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="mt-4 flex items-center gap-0.5 justify-end">
          <% if @pagy.prev %>
            <a href="<%= pagy_url_for(@pagy, @pagy.prev) %>"
               data-turbo-frame="inventories-table"
               class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 hover:bg-slate-100 transition-colors">
              <span class="material-symbols-outlined text-base">chevron_left</span>
            </a>
          <% else %>
            <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-300 pointer-events-none">
              <span class="material-symbols-outlined text-base">chevron_left</span>
            </span>
          <% end %>

          <% @pagy.series.each do |item| %>
            <% if item.is_a?(Integer) %>
              <a href="<%= pagy_url_for(@pagy, item) %>"
                 data-turbo-frame="inventories-table"
                 class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 hover:bg-slate-100 transition-colors">
                <%= item %>
              </a>
            <% elsif item == :gap %>
              <span class="px-1 text-slate-400 text-xs">…</span>
            <% elsif item == @pagy.page %>
              <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm bg-accent text-white font-medium">
                <%= item %>
              </span>
            <% end %>
          <% end %>

          <% if @pagy.next %>
            <a href="<%= pagy_url_for(@pagy, @pagy.next) %>"
               data-turbo-frame="inventories-table"
               class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 hover:bg-slate-100 transition-colors">
              <span class="material-symbols-outlined text-base">chevron_right</span>
            </a>
          <% else %>
            <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-300 pointer-events-none">
              <span class="material-symbols-outlined text-base">chevron_right</span>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="inventories-table-loader hidden justify-center items-center py-12">
      <svg class="animate-spin h-10 w-10 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="ml-3 text-slate-600">Ricerca in corso...</span>
    </div>
  <% end %>
</section>

<%= turbo_frame_tag "inventory_modal" %>
