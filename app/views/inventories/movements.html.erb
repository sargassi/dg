<% menu = [
  { label: 'Dashboard', path: inventories_dashboard_path, active: false, icon: 'dashboard' },
  { label: 'Ricerca magazzino', path: inventories_path, active: false, icon: 'inventory_2' },
  { label: 'Movimenti', path: inventories_movements_path, active: true, icon: 'swap_vert' },
  { label: 'Magazzini e ubiche', path: warehouses_path, active: false, icon: 'warehouse' },
] %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: { link: '/', label: 'Inventario / Movimenti', menu: menu } %>
</div>

<section class="<%= style_main_cnt %> flex flex-col" style="height: calc(100vh - 140px);" data-controller="search-filter">
  <div class="flex gap-4 items-center mb-4 flex-none">
    <%= form_with url: inventories_movements_path, method: :get,
                  data: { search_filter_target: "form", turbo_frame: "movements-table" },
                  class: "flex items-center gap-3" do |f| %>
      <div class="relative">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none">search</span>
        <%= f.search_field :q,
              value: params[:q],
              placeholder: "Cerca articolo",
              class: "#{style_search_input} rounded-lg pl-10 font-mono text-blue-600",
              data: { action: "input->search-filter#filter", search_filter_target: "input" } %>
      </div>
      <%= f.select :operationtype_id,
            options_from_collection_for_select(@operationtypes, :id, :description, params[:operationtype_id]),
            { include_blank: "Tutte le operazioni" },
            class: "border border-accent-100 outline-none p-2 text-xs rounded-lg shadow-sm min-w-[170px] uppercase #{params[:operationtype_id].present? ? 'bg-blue-400 text-white' : 'bg-white'}",
            data: { action: "change->search-filter#filter", search_filter_target: "select" } %>
      <%= f.date_field :date_from,
            value: params[:date_from],
            class: "border border-accent-100 outline-none p-2 text-xs rounded-lg shadow-sm #{params[:date_from].present? ? 'bg-blue-200' : 'bg-white'}",
            data: { action: "change->search-filter#filter" } %>
      <%= f.date_field :date_to,
            value: params[:date_to],
            class: "border border-accent-100 outline-none p-2 text-xs rounded-lg shadow-sm #{params[:date_to].present? ? 'bg-blue-200' : 'bg-white'}",
            data: { action: "change->search-filter#filter" } %>
      <%= f.select :operator_id,
            options_from_collection_for_select(@operators, :id, :name, params[:operator_id]),
            { include_blank: "Tutti gli operatori" },
            class: "border border-accent-100 outline-none p-2 text-xs rounded-lg shadow-sm uppercase min-w-[160px] #{params[:operator_id].present? ? 'bg-blue-400 text-white' : 'bg-white'}",
            data: { action: "change->search-filter#filter", search_filter_target: "select" } %>
    <% end %>
    <span class="text-sm font-bold text-slate-700 whitespace-nowrap border border-slate-300 rounded-full px-3 py-1" data-search-filter-target="count"><%= @pagy.count %> movimenti</span>
  </div>

  <style>
    turbo-frame#movements-table[busy] .movements-table-content { display: none; }
    turbo-frame#movements-table[busy] .movements-table-loader { display: flex; }
  </style>
  <%= turbo_frame_tag "movements-table", class: "flex flex-col flex-1 min-h-0", data: { action: "turbo:frame-load->search-filter#onFrameLoad" } do %>
    <div class="movements-table-content flex flex-col flex-1 min-h-0">
      <span hidden data-filtered-count><%= @pagy.count %></span>
      <div class="overflow-x-auto flex-1 min-h-0 overflow-y-auto">
        <table class="min-w-full">
          <thead>
            <tr>
              <% %w[Tipo Data Articolo Magazzino/Ublica QTA Operatore Documento].each do |h| %>
                <th class="<%= style_table_th %> sticky top-0 z-10"><%= h %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @movements.each do |mov, type| %>
              <% is_itemin = type == :itemin %>
              <% details = is_itemin ? mov.itemins_details : mov.itemouts_details %>
              <tr class="<%= is_itemin ? 'bg-green-50/30' : 'bg-red-50/30' %>">
                <td class="<%= style_table_td %>">
                  <% if is_itemin %>
                    <span class="inline-block bg-green-100 text-green-700 px-1.5 py-0.5 rounded text-[10px] font-semibold leading-tight">Entrata</span>
                  <% else %>
                    <span class="inline-block bg-red-100 text-red-700 px-1.5 py-0.5 rounded text-[10px] font-semibold leading-tight">Uscita</span>
                  <% end %>
                </td>
                <td class="<%= style_table_td %> font-mono text-xs"><%= mov.indate.strftime("%d-%m-%Y") %></td>
                <td class="<%= style_table_td %> p-0">
                  <table class="w-full text-[11px]">
                    <% details.each do |d| %>
                      <tr>
                        <td class="px-2 py-0.5 font-mono"><%= d.item&.gencode.presence || d.itemcode || "—" %></td>
                      </tr>
                    <% end %>
                  </table>
                </td>
                <td class="<%= style_table_td %> p-0">
                  <table class="w-full text-[11px]">
                    <% details.each do |d| %>
                      <tr>
                        <td class="px-2 py-0.5 text-xs"><%= d.warehouse&.code %> / <%= d.location&.code %></td>
                      </tr>
                    <% end %>
                  </table>
                </td>
                <td class="<%= style_table_td %> p-0">
                  <table class="w-full text-[11px]">
                    <% details.each do |d| %>
                      <tr>
                        <td class="px-2 py-0.5 text-right font-mono font-bold"><%= d.qty %></td>
                      </tr>
                    <% end %>
                  </table>
                </td>
                <td class="<%= style_table_td %> text-xs text-blue-400 uppercase font-bold"><%= mov.operator&.name %></td>
                <td class="<%= style_table_td %> font-mono text-xs text-blue-600 whitespace-nowrap"><%= link_to "##{mov.id}", is_itemin ? itemin_path(mov) : itemout_path(mov), class: "hover:underline" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="mt-4 flex items-center gap-0.5 justify-end">
          <% if @pagy.prev %>
            <a href="<%= pagy_url_for(@pagy, @pagy.prev) %>"
               data-turbo-frame="movements-table"
               class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 hover:bg-slate-100 transition-colors">
              <span class="material-symbols-outlined text-base">chevron_left</span>
            </a>
          <% else %>
            <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-300 pointer-events-none">
              <span class="material-symbols-outlined text-base">chevron_left</span>
            </span>
          <% end %>

          <% @pagy.series.each do |item| %>
            <% if item.is_a?(Integer) %>
              <a href="<%= pagy_url_for(@pagy, item) %>"
                 data-turbo-frame="movements-table"
                 class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 hover:bg-slate-100 transition-colors">
                <%= item %>
              </a>
            <% elsif item == :gap %>
              <span class="px-1 text-slate-400 text-xs">…</span>
            <% elsif item == @pagy.page %>
              <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm bg-accent text-white font-medium">
                <%= item %>
              </span>
            <% end %>
          <% end %>

          <% if @pagy.next %>
            <a href="<%= pagy_url_for(@pagy, @pagy.next) %>"
               data-turbo-frame="movements-table"
               class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 hover:bg-slate-100 transition-colors">
              <span class="material-symbols-outlined text-base">chevron_right</span>
            </a>
          <% else %>
            <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-300 pointer-events-none">
              <span class="material-symbols-outlined text-base">chevron_right</span>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="movements-table-loader hidden justify-center items-center py-12">
      <svg class="animate-spin h-10 w-10 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="ml-3 text-slate-600">Ricerca in corso...</span>
    </div>
  <% end %>
</section>
