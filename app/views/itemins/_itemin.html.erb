<div id="<%= dom_id itemin %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Indate:</strong>
    <%= itemin.indate %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this itemin", itemin, class: "#{style_btn(variant: :neutral)}" %>
    <%= link_to "Edit this itemin", edit_itemin_path(itemin), class: "ml-2 #{style_btn(variant: :neutral)}" %>
    <hr class="mt-6">
  <% end %>
</div>
