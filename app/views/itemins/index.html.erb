<% menu = [
  { label: 'Dashboard', path: inventories_dashboard_path, active: false, icon: 'dashboard' },
  { label: 'Ricerca magazzino', path: inventories_path, active: false, icon: 'inventory_2' },
  { label: 'Magazzino e ubiche', path: warehouses_path, active: false, icon: 'warehouse' },
] %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: { link: '/', label: 'Inventario / Carichi', menu: menu } %>
</div>

<section class="<%= style_main_cnt %>">
  <div class="<%= style_main_card %>">
    <div class="flex items-center justify-between mb-4">
      <h3 class="<%= style_main_card_header %> !mb-0">
        <span class="material-symbols-outlined text-slate-400">inbound</span>
        Elenco Carichi
      </h3>
      <%= link_to new_itemin_path, class: "px-4 py-2 text-xs bg-accent text-white rounded-sm hover:bg-accent-700 transition-colors flex items-center gap-1" do %>
        <span class="material-symbols-outlined text-base">add</span>
        Nuovo carico
      <% end %>
    </div>

    <div id="itemins">
      <table class="min-w-full">
        <thead>
          <tr>
            <th class="<%= style_table_th %>">ID</th>
            <th class="<%= style_table_th %>">Data</th>
            <th class="<%= style_table_th %>">Articoli</th>
            <th class="<%= style_table_th %>">Note</th>
            <th class="<%= style_table_th %> w-24"></th>
          </tr>
        </thead>
        <tbody>
          <% @itemins.each do |itemin| %>
            <tr class="hover:bg-slate-50 border-b border-slate-100">
              <td class="<%= style_table_td %> font-mono text-xs"><%= itemin.id %></td>
              <td class="<%= style_table_td %>"><%= itemin.indate %></td>
              <td class="<%= style_table_td %>"><%= itemin.itemins_details.size %></td>
              <td class="<%= style_table_td %> text-xs text-slate-400 max-w-[200px] truncate"><%= itemin.notes.presence || "-" %></td>
              <td class="<%= style_table_td %> text-right">
                <%= link_to "Dettaglio", itemin_path(itemin), class: "text-xs text-accent hover:text-accent-700" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
