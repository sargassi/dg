<tr data-nested-form-target="row">
  <td class="<%= style_table_td %> p-1 relative" data-controller="autocomplete"
      data-autocomplete-url-value="<%= autocomplete_inventories_path %>">
    <%= f.hidden_field :_destroy, value: "0" %>
    <%= f.hidden_field :item_id, data: { autocomplete_target: "hidden" } %>
    <%= f.hidden_field :collection_id, data: { autocomplete_target: "collectionId" } %>
    <%= f.text_field :itemcode,
          data: { autocomplete_target: "input", action: "input->autocomplete#search blur->autocomplete#hideResults" },
          class: "w-full px-2 py-1 text-xs border border-slate-200 outline-none focus:border-accent rounded-sm",
          autocomplete: "off" %>
    <ul data-autocomplete-target="results"
        class="hidden absolute left-0 right-0 top-full mt-0.5 bg-white border border-slate-200 rounded-sm shadow-lg z-50 max-h-48 overflow-y-auto"></ul>
  </td>
  <td class="<%= style_table_td %> p-1 w-20">
    <%= f.number_field :qty, value: 1, min: 1, class: "w-full px-2 py-1 text-xs border border-slate-200 outline-none focus:border-accent rounded-sm" %>
  </td>
  <td class="<%= style_table_td %> p-1 w-32">
    <%= f.hidden_field :warehouse_id %>
    <%= f.collection_select :warehouse_id, @warehouses, :id, :code,
          { include_blank: "Mag." },
          disabled: true,
          class: "w-full px-1 py-1 text-xs border border-slate-200 outline-none rounded-sm bg-gray-100 cursor-not-allowed" %>
  </td>
  <td class="<%= style_table_td %> p-1 w-28">
    <%= f.hidden_field :location_id %>
    <%= f.collection_select :location_id, @locations, :id, :code,
          { include_blank: "-" },
          disabled: true,
          class: "w-full px-1 py-1 text-xs border border-slate-200 outline-none rounded-sm bg-gray-100 cursor-not-allowed" %>
  </td>
  <%= f.hidden_field :operationtype_id, value: 2 %>
  <td class="<%= style_table_td %> p-1 text-center w-10">
    <button type="button"
            data-action="nested-form#remove"
            class="text-red-500 hover:text-red-700">
      <span class="material-symbols-outlined text-base">delete</span>
    </button>
  </td>
</tr>
