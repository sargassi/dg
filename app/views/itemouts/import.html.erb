<% menu = [
  { label: 'Uscite', path: itemouts_path, active: false, icon: 'output', can: 'manage_itemouts' },
  { label: 'Import uscite', path: import_itemouts_path, active: true, icon: 'file_upload', can: 'manage_itemouts' },
] %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: {link: '/', label: 'Import uscite da Excel', menu: menu} %>
</div>

<section class="<%= style_main_cnt %> overflow-y-auto min-w-0" style="height: calc(100vh - 140px);">
  <% if @data.present? %>

    <h2 class="<%= style_main_sub_header %>">
      Anteprima importazione (<span id="import-count"><%= @data[:rows].size %></span> righe)
    </h2>

    <% valid_count = @data[:rows].count { |r| r[:_valid] }
       invalid_count = @data[:rows].count { |r| !r[:_valid] } %>
    <div id="import-summary" class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-4 mb-4 text-sm">
      <div class="grid grid-cols-3 gap-4">
        <div>
          <div class="text-xs text-slate-400 uppercase tracking-wide mb-1">Totale righe</div>
          <div class="font-semibold"><%= @data[:rows].size %></div>
        </div>
        <div>
          <div class="text-xs text-slate-400 uppercase tracking-wide mb-1">Valide</div>
          <div class="font-semibold text-green-600"><%= valid_count %></div>
        </div>
        <div>
          <div class="text-xs text-slate-400 uppercase tracking-wide mb-1">Non valide</div>
          <div class="font-semibold text-red-600"><%= invalid_count %></div>
        </div>
      </div>
    </div>

    <div class="overflow-x-auto mb-4">
      <table class="min-w-full">
        <thead>
          <tr>
            <th class="<%= style_table_th %> sticky top-0 z-10 w-16 text-center">Riga</th>
            <th class="<%= style_table_th %> sticky top-0 z-10 w-40">Item</th>
            <th class="<%= style_table_th %> sticky top-0 z-10 w-28">Data uscita</th>
            <th class="<%= style_table_th %> sticky top-0 z-10 w-20 text-right">Qt.</th>
            <th class="<%= style_table_th %> sticky top-0 z-10">Destinazione</th>
            <th class="<%= style_table_th %> sticky top-0 z-10 w-40">Stato</th>
          </tr>
        </thead>
        <tbody>
          <% @data[:rows].each do |row| %>
            <tr class="<%= 'bg-red-50 dark:bg-red-900/10' unless row[:_valid] %> hover:bg-slate-50 dark:hover:bg-slate-700/50">
              <td class="<%= style_table_td %> text-center text-xs text-slate-400"><%= row[:_index] %></td>
              <td class="<%= style_table_td %> text-xs font-mono text-blue-600 dark:text-blue-400"><%= row[:_gencode] || row['Item Code:'] %></td>
              <td class="<%= style_table_td %> text-xs"><%= row[:_date]&.strftime('%d/%m/%Y') %></td>
              <td class="<%= style_table_td %> text-xs text-right font-mono"><%= row[:_qty] %></td>
              <td class="<%= style_table_td %> text-xs"><%= row[:_destinazione] %></td>
              <td class="<%= style_table_td %> text-xs">
                <% if row[:_valid] %>
                  <span class="text-green-600">OK</span>
                <% else %>
                  <span class="text-red-600"><%= row[:_error] %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="flex gap-4">
      <%= form_with url: import_confirm_itemouts_path, method: :post do %>
        <button type="submit" class="<%= style_import_btn %> bg-green-600">
          Conferma importazione (<span id="import-count-btn"><%= valid_count %></span>)
        </button>
      <% end %>

      <%= button_to "Annulla", import_cancel_itemouts_path, method: :delete, class: "#{style_import_btn} bg-gray-400" %>
    </div>

  <% else %>

    <section class="bg-accent-50 dark:bg-slate-800 p-6" data-controller="loader">
      <div data-loader-target="form">
        <%= form_with url: import_parse_itemouts_path, method: :post, multipart: true, local: true,
                     data: { action: "submit->loader#show" } do |f| %>

          <div class="flex flex-wrap items-end gap-4">
            <div class="w-72">
              <label class="text-xs text-slate-400 uppercase tracking-wide block mb-1">File Excel</label>
              <%= f.file_field :file, class: style_import_field, required: true %>
            </div>
            <%= f.submit "Carica",
                class: style_import_btn %>
          </div>
        <% end %>
      </div>

      <div data-loader-target="spinner" class="hidden justify-center items-center py-12">
        <svg class="animate-spin h-10 w-10 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="ml-3 text-slate-600">Caricamento in corso...</span>
      </div>
    </section>

  <% end %>
</section>
