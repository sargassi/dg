<% content_for :page_header do %>
<div class="flex items-center gap-2 px-0 py-0.5">
  <%= link_to inventories_dashboard_path, class: "text-sm font-semibold text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300 tracking-wide" do %>
    Magazzino
  <% end %>
  <span class="text-slate-300 dark:text-slate-600">/</span>
  <h1 class="text-sm font-semibold text-slate-500 dark:text-slate-400 tracking-wide">
    Uscite
  </h1>
</div>
<% end %>

<section class="<%= style_main_cnt %>">
  <div class="<%= style_main_card %>">
    <div class="flex items-center justify-between mb-4">
      <h3 class="<%= style_main_card_header %> !mb-0">
        <span class="material-symbols-outlined text-slate-400">outbound</span>
        Elenco Scarichi
      </h3>
      <%= link_to new_itemout_path, class: "px-4 py-2 text-xs bg-accent text-white rounded-sm hover:bg-accent-700 transition-colors flex items-center gap-1" do %>
        <span class="material-symbols-outlined text-base">add</span>
        Nuovo scarico
      <% end %>
    </div>

    <div id="itemouts">
      <table class="min-w-full">
        <thead>
          <tr>
            <th class="<%= style_table_th %>">ID</th>
            <th class="<%= style_table_th %>">Data</th>
            <th class="<%= style_table_th %>">Articoli</th>
            <th class="<%= style_table_th %>">Note</th>
            <th class="<%= style_table_th %> w-24"></th>
          </tr>
        </thead>
        <tbody>
          <% @itemouts.each do |itemout| %>
            <tr class="hover:bg-slate-50 border-b border-slate-100">
              <td class="<%= style_table_td %> font-mono text-xs"><%= itemout.id %></td>
              <td class="<%= style_table_td %>"><%= itemout.indate %></td>
              <td class="<%= style_table_td %>"><%= itemout.itemouts_details.size %></td>
              <td class="<%= style_table_td %> text-xs text-slate-400 max-w-[200px] truncate"><%= itemout.notes.presence || "-" %></td>
              <td class="<%= style_table_td %> text-right">
                <%= link_to "Dettaglio", itemout_path(itemout), class: "text-xs text-accent hover:text-accent-700" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
