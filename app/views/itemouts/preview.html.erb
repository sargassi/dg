<% content_for :page_header do %>
<div class="flex items-center gap-2 px-0 py-0.5">
  <%= link_to inventories_dashboard_path, class: "text-sm font-semibold text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300 tracking-wide" do %>
    Magazzino
  <% end %>
  <span class="text-slate-300 dark:text-slate-600">/</span>
  <h1 class="text-sm font-semibold text-slate-500 dark:text-slate-400 tracking-wide">
    Anteprima uscita
  </h1>
</div>
<% end %>

<section class="<%= style_main_cnt %> max-w-5xl mx-auto">
  <div class="<%= style_main_card %> mb-6">
    <h3 class="<%= style_main_card_header %>">
      <span class="material-symbols-outlined text-slate-400">description</span>
      Riepilogo Scarico
    </h3>

    <div class="grid grid-cols-3 gap-4 text-sm mb-6">
      <div>
        <span class="text-xs text-slate-400 block">Data</span>
        <span class="font-medium"><%= @params[:indate] %></span>
      </div>
      <div>
        <span class="text-xs text-slate-400 block">Operatore</span>
        <span class="font-medium"><%= User.find_by(id: @params[:operator_id])&.name || @params[:operator_id] %></span>
      </div>
      <div>
        <span class="text-xs text-slate-400 block">Note</span>
        <span class="font-medium"><%= @params[:notes].presence || "-" %></span>
      </div>
    </div>

    <h4 class="text-sm font-semibold text-slate-700 mb-3">
      Articoli da scaricare (<%= @details.size %>)
    </h4>

    <table class="min-w-full">
      <thead>
        <tr>
          <th class="<%= style_table_th %>">Codice</th>
          <th class="<%= style_table_th %> w-20 text-right">Q.tà</th>
          <th class="<%= style_table_th %> w-32">Magazzino</th>
          <th class="<%= style_table_th %> w-28">Ubica</th>
          <th class="<%= style_table_th %> w-36">Operazione</th>
        </tr>
      </thead>
      <tbody>
        <% @details.each do |detail| %>
          <% wh = Warehouse.find_by(id: detail[:warehouse_id]) %>
          <% loc = Location.find_by(id: detail[:location_id]) %>
          <% op = Operationtype.find_by(id: detail[:operationtype_id]) %>
          <tr class="hover:bg-slate-50">
            <td class="<%= style_table_td %>"><%= detail[:itemcode] %></td>
            <td class="<%= style_table_td %> text-right font-mono text-blue-600"><%= detail[:qty] %></td>
            <td class="<%= style_table_td %>"><%= wh&.code || "-" %></td>
            <td class="<%= style_table_td %>"><%= loc&.code || "-" %></td>
            <td class="<%= style_table_td %>"><%= op&.description || "-" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="flex gap-4">
    <%= form_with url: confirm_itemouts_path, method: :post do %>
      <button type="submit" class="<%= style_import_btn %> bg-green-600">
        Conferma e Salva (<%= @details.size %> articoli)
      </button>
    <% end %>

    <%= link_to "Annulla", new_itemout_path, class: "#{style_import_btn} bg-gray-400 text-center" %>
  </div>
</section>
