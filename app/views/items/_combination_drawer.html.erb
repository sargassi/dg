<div data-drawer-target="root" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/30 backdrop-blur-sm" data-action="click->drawer#close"></div>
  <aside data-drawer-target="panel"
         class="absolute right-0 top-0 bottom-0 w-full max-w-2xl bg-white dark:bg-slate-800 border-l border-slate-200 dark:border-slate-700 shadow-2xl translate-x-full transition-transform duration-300 flex flex-col">
    <header class="flex items-center justify-between px-5 py-3 bg-slate-800 dark:bg-slate-900 flex-none">
      <h3 class="text-sm font-semibold text-white tracking-wide uppercase">Nuova combinazione</h3>
      <button type="button"
              data-action="click->drawer#close"
              class="<%= style_close_btn %>">
        <span class="material-symbols-outlined">close</span>
      </button>
    </header>
    <div class="flex-1 overflow-y-auto p-5">
      <%= turbo_frame_tag "combination_drawer_content" %>
    </div>
  </aside>
</div>