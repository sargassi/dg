<% form_url = item.persisted? ? item_path(item, q: params[:q], collection_id: params[:collection_id], return_to: params[:return_to]) : items_path(q: params[:q], collection_id: params[:collection_id], return_to: params[:return_to]) %>
<% form_data = { turbo_frame: "_top", controller: "camera-capture", action: "submit->loader#show", item_clone_target: "form" } %>
<%= form_with(model: item, url: form_url, data: form_data, multipart: true) do |form| %>
  <% if item.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium mb-4 border border-red-200 text-sm">
      <h2><%= pluralize(item.errors.count, "error") %> impediscono il salvataggio:</h2>
      <ul class="mt-1 list-disc list-inside">
        <% item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-3">
    <div class="flex gap-3">
      <% [{ field: "itemcode", hint: "Codice articolo", show_all: false, title: "codice articolo" },
          { field: "fabricode", hint: "Codice tessuto", show_all: true, title: "tessuti" },
          { field: "varcode", hint: "Codice colore", show_all: true, title: "colori" }].each do |cfg| %>
      <div class="flex-1 relative" data-controller="list-autocomplete"
           data-list-autocomplete-url-value="<%= distinct_values_items_path %>"
           data-list-autocomplete-field-value="<%= cfg[:field] %>"
           data-list-autocomplete-value-info-url-value="<%= value_info_items_path %>">
        <%= form.label cfg[:field], class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
        <div class="relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none">search</span>
          <%= form.text_field cfg[:field],
                data: { list_autocomplete_target: "input", action: "focus->list-autocomplete#search input->list-autocomplete#search blur->list-autocomplete#hideResults keydown.enter->list-autocomplete#preventEnter" },
                class: "flex-1 min-w-0 border border-slate-300 outline-none pl-9 #{cfg[:show_all] ? 'pr-40' : 'pr-24'} py-2 w-full text-sm",
                autocomplete: "off" %>
          <div class="absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center gap-2">
            <% if cfg[:show_all] %>
            <button type="button"
                    data-action="mousedown->list-autocomplete#preventBlur click->list-autocomplete#showAll"
                    data-list-autocomplete-target="showAllBtn"
                    title="Mostra tutti i <%= cfg[:title] %>"
                    class="inline-flex items-center gap-1 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-accent-700 dark:hover:text-accent-300 hover:underline cursor-pointer">
              <span class="material-symbols-outlined text-sm">unfold_more</span>
              Tutti
            </button>
            <% end %>
            <button type="button"
                    data-action="mousedown->list-autocomplete#preventBlur click->list-autocomplete#toggleNew"
                    title="Crea nuovo <%= cfg[:field] == "itemcode" ? "codice articolo" : (cfg[:field] == "fabricode" ? "codice tessuto" : "codice colore") %>"
                    class="inline-flex items-center gap-1 text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-accent-700 dark:hover:text-accent-300 hover:underline cursor-pointer">
              <span class="material-symbols-outlined text-sm">add</span>
              Crea nuovo
            </button>
          </div>
        </div>
        <ul data-list-autocomplete-target="results"
            class="hidden absolute left-0 right-0 top-full mt-0.5 bg-white border border-slate-200 rounded-b-lg shadow-lg z-50 max-h-48 overflow-y-auto text-sm"></ul>
        <div data-list-autocomplete-target="newForm"
             class="hidden fixed inset-0 z-[60] bg-black/40 items-center justify-center p-4"
             data-action="click->list-autocomplete#backdropClick keydown.esc->list-autocomplete#stop keydown.esc->list-autocomplete#cancelNew">
          <div class="bg-white dark:bg-slate-800 w-full max-w-md border border-slate-200 dark:border-slate-700 shadow-2xl rounded-sm overflow-hidden"
               data-action="click->list-autocomplete#stop">
            <header class="flex items-center justify-between px-4 py-2.5 bg-slate-800 dark:bg-slate-900">
              <h4 class="text-xs font-bold uppercase tracking-wide text-white">Nuovo <%= cfg[:field] == "itemcode" ? "codice articolo" : (cfg[:field] == "fabricode" ? "codice tessuto" : "codice colore") %></h4>
              <button type="button"
                      data-action="list-autocomplete#cancelNew"
                      class="inline-flex items-center justify-center h-7 w-7 text-slate-400 hover:text-white transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-base">close</span>
              </button>
            </header>
            <div class="p-4 space-y-3">
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none">search</span>
                <input type="text"
                       placeholder="Scrivi per vedere i suggerimenti..."
                       autocomplete="off"
                       data-list-autocomplete-target="newInput"
                       data-action="keydown.enter->list-autocomplete#preventEnter keydown.enter->list-autocomplete#confirmNew input->list-autocomplete#searchNew"
                       class="w-full border border-slate-300 dark:border-slate-600 outline-none pl-9 pr-3 py-2 text-sm bg-white dark:bg-slate-700 focus:border-accent dark:focus:border-accent">
                <ul data-list-autocomplete-target="newResults"
                    class="hidden absolute left-0 right-0 top-full mt-0.5 bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-b-sm shadow-lg z-50 max-h-48 overflow-y-auto text-sm"></ul>
              </div>
              <div data-list-autocomplete-target="newStatus" class="hidden text-xs font-medium"></div>
              <div class="flex gap-2 pt-1">
                <button type="button"
                        data-action="list-autocomplete#confirmNew"
                        class="px-4 py-1.5 text-xs font-semibold uppercase tracking-wider rounded-sm bg-accent text-white hover:opacity-90 cursor-pointer">
                  Crea
                </button>
                <button type="button"
                        data-action="list-autocomplete#useAnyway"
                        data-list-autocomplete-target="useAnyway"
                        class="hidden inline-flex items-center gap-1 text-xs font-semibold text-amber-700 dark:text-amber-400 hover:underline cursor-pointer">
                  <span class="material-symbols-outlined text-sm">warning</span>
                  Usa comunque
                </button>
                <button type="button"
                        data-action="list-autocomplete#cancelNew"
                        class="ml-auto px-3 py-1.5 text-xs font-medium uppercase tracking-wider rounded-sm bg-slate-200 dark:bg-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-300 dark:hover:bg-slate-500 cursor-pointer">
                  Annulla
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% end %>
    </div>

    <div>
      <%= form.label :description, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
      <%= form.text_field :description,
            class: "border border-slate-300 outline-none px-3 py-2 w-full text-sm" %>
    </div>

    <div class="flex gap-3">
      <div class="flex-1">
        <%= form.label :tg, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
        <%= form.text_field :tg,
              class: "border border-slate-300 outline-none px-3 py-2 w-full text-sm" %>
      </div>
      <div class="flex-[2]">
        <%= form.label :fabric, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
        <%= form.text_field :fabric,
              class: "border border-slate-300 outline-none px-3 py-2 w-full text-sm" %>
      </div>
      <div class="flex-1">
        <%= form.label :colour, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
        <%= form.text_field :colour,
              class: "border border-slate-300 outline-none px-3 py-2 w-full text-sm" %>
      </div>
      <% if false %>
      <div class="flex-1">
        <%= form.label :unit_price, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
        <%= form.text_field :unit_price, class: "border border-slate-300 outline-none px-3 py-2 w-full text-sm" %>
      </div>
      <% end %>
      <div class="flex-1">
        <%= form.label :materiale, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
        <%= form.text_field :materiale,
              class: "border border-slate-300 outline-none px-3 py-2 w-full text-sm" %>
      </div>
    </div>

    <div class="flex gap-3">
      <div class="flex-1">
        <%= form.label :collection_id, "Collezione *", class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
        <%= form.collection_select :collection_id, @collections || [], :id, :description,
              { include_blank: "-" },
              class: "border border-slate-300 outline-none px-3 py-2 w-full text-sm bg-white" %>
      </div>
      <div class="flex-[2]">
        <%= form.label :note, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
        <%= form.text_area :note, rows: 1, class: "border border-slate-300 outline-none px-3 py-2 w-full text-sm resize-none" %>
      </div>
    </div>
  </div>

  <div class="mt-4 pt-4 border-t border-slate-200" data-controller="image-preview">
    <h3 class="text-xs text-slate-400 uppercase tracking-wide mb-2">Immagini</h3>
    <% if item.persisted? %>
    <div class="flex flex-wrap gap-2 mb-3" data-image-preview-target="existing">
      <% item.pictures.each do |pic| %>
        <div class="relative group" data-signed-id="<%= pic.signed_id %>">
          <%= image_tag pic, class: "w-20 h-20 object-cover rounded-sm border border-slate-200" %>
          <button type="button" data-action="image-preview#removeExisting"
                class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-red-500 text-white rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition text-xs leading-none cursor-pointer">
            <span class="material-symbols-outlined text-xs leading-none">close</span>
          </button>
          <%= hidden_field_tag "item[pictures][]", pic.signed_id, id: dom_id(pic), data: { image_preview_target: "hidden" } %>
        </div>
      <% end %>
    </div>
    <% end %>

    <div class="flex items-center gap-3 mb-2">
      <button type="button"
              data-action="camera-capture#open"
              class="flex items-center justify-center gap-2 px-4 py-2 rounded-sm border border-dashed border-accent-300 text-accent-700 bg-accent-50 hover:bg-accent-100 transition text-xs font-bold whitespace-nowrap">
        <span class="material-symbols-outlined text-lg">camera_alt</span>
        Scatta foto
      </button>
      <div class="flex-1">
        <%= hidden_field_tag "item[pictures][]", "", id: nil %>
        <%= form.file_field :pictures, multiple: true, direct_upload: true,
              data: { image_preview_target: "input", camera_capture_target: "input", action: "change->image-preview#preview" },
              class: "#{style_upload_field} #{style_upload_field_btn}" %>
      </div>
      <div class="flex gap-1.5" data-image-preview-target="preview"></div>
    </div>

    <div data-camera-capture-target="summary"
         class="hidden flex flex-wrap gap-2 p-2 bg-accent-50 border border-accent-200 rounded-sm">
    </div>

    <!-- Camera modal -->
    <div data-camera-capture-target="modal"
         class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center">
      <div class="relative bg-white dark:bg-slate-800 rounded-xl p-4 w-full max-w-lg mx-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Scatta foto</h3>
          <button type="button"
                  data-action="camera-capture#close"
                  class="<%= style_close_btn %>">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <div class="relative">
          <video data-camera-capture-target="video"
                 class="w-full aspect-square bg-black rounded-lg object-cover"
                 autoplay playsinline></video>
          <div data-camera-capture-target="flash"
               class="hidden absolute inset-0 bg-white/80 rounded-lg pointer-events-none"></div>
        </div>
        <div data-camera-capture-target="preview"
             class="flex flex-wrap gap-2 mt-2 min-h-0">
        </div>
        <div data-camera-capture-target="counter"
             class="text-center text-xs text-slate-500 dark:text-slate-400 mt-2 min-h-[1.25rem]"></div>
        <div class="flex gap-3 mt-3 justify-center">
          <button type="button"
                  data-action="camera-capture#shoot"
                  class="flex items-center justify-center gap-2 px-4 py-2 rounded-sm bg-accent text-white text-xs font-semibold hover:opacity-90 transition">
            <span class="material-symbols-outlined text-lg">camera</span>
            Scatta
          </button>
          <button type="button"
                  data-camera-capture-target="confirmBtn"
                  data-action="camera-capture#confirm"
                  class="hidden px-4 py-2 rounded-sm bg-emerald-600 text-white text-xs font-semibold hover:bg-emerald-700 transition">
            Conferma foto
          </button>
          <button type="button"
                  data-action="camera-capture#close"
                  class="px-4 py-2 rounded-sm bg-slate-200 dark:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-medium hover:bg-slate-300 dark:hover:bg-slate-500 transition">
            Chiudi
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="flex gap-2 mt-4 pt-4 border-t border-slate-200 items-center">
    <%= form.submit "Modifica", class: "px-4 py-1.5 #{style_save_button} inline-block tracking-wider rounded-sm uppercase text-xs cursor-pointer" %>
    <%= link_to safe_return_to_path(mainware_index_path(q: params[:q], collection_id: params[:collection_id])),
          class: "px-4 py-1.5 #{style_cancel_button} inline-block tracking-wider rounded-sm uppercase text-xs cursor-pointer",
          data: { turbo_frame: "_top" } do %>
      Annulla
    <% end %>
    <% if item.persisted? %>
      <%= button_to item_path(item), method: :delete,
            class: "ml-auto p-3 inline-flex items-center gap-1.5 tracking-wider rounded-sm uppercase text-xs cursor-pointer text-red-500 border border-red-500 hover:bg-red-50 transition",
            data: { turbo_confirm: "Eliminare questo articolo?" } do %>
        <span class="material-symbols-outlined text-sm leading-none">delete</span>
        Elimina
      <% end %>
    <% end %>
  </div>
<% end %>
