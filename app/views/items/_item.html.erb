<div id="<%= dom_id item %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Itemcode:</strong>
    <%= item.itemcode %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Fabricode:</strong>
    <%= item.fabricode %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Varcode:</strong>
    <%= item.varcode %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= item.description %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Tg:</strong>
    <%= item.tg %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Note:</strong>
    <%= item.note %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Fabric:</strong>
    <%= item.fabric %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Colour:</strong>
    <%= item.colour %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Unit price:</strong>
    <%= item.unit_price %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Materiale:</strong>
    <%= item.materiale %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this item", item, class: "#{style_btn(variant: :neutral)}" %>
    <%= link_to "Edit this item", edit_item_path(item), class: "ml-2 #{style_btn(variant: :neutral)}" %>
    <hr class="mt-6">
  <% end %>
</div>
