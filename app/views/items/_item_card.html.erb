<div class="<%= style_main_card %>">
  <div class="flex items-start justify-between gap-6 pb-6 mb-6 border-b border-slate-100 dark:border-slate-600">
    <div class="min-w-0 flex-1">
      <p class="text-xs uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-1 font-medium">gencode</p>
      <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 font-mono break-all"><%= item.gencode %></h2>
      <% if item.description.present? %>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1.5"><%= item.description %></p>
      <% end %>
    </div>
    <div class="flex-shrink-0">
      <% if item.qrcode_svg.present? %>
        <span class="inline-block w-20 h-20"><%= item.qrcode_svg.html_safe %></span>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
    <div>
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined text-base text-slate-400">qr_code</span>
        Codici
      </h3>
      <div class="space-y-3">
        <div>
          <p class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Itemcode</p>
          <p class="text-sm font-medium text-slate-800 dark:text-slate-200 font-mono"><%= item.itemcode %></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Fabricode</p>
          <p class="text-sm font-medium text-slate-800 dark:text-slate-200 font-mono"><%= item.fabricode %></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Varcode</p>
          <p class="text-sm font-medium text-slate-800 dark:text-slate-200 font-mono"><%= item.varcode %></p>
        </div>
      </div>
    </div>

    <div>
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined text-base text-slate-400">description</span>
        Descrizione
      </h3>
      <div class="space-y-3">
        <div>
          <p class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Tessuto</p>
          <p class="text-sm font-medium text-slate-800 dark:text-slate-200"><%= item.fabric %></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Colore</p>
          <p class="text-sm font-medium text-slate-800 dark:text-slate-200"><%= item.colour %></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">TG</p>
          <p class="text-sm font-medium text-slate-800 dark:text-slate-200"><%= item.tg %></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Materiale</p>
          <p class="text-sm font-medium text-slate-800 dark:text-slate-200"><%= item.materiale %></p>
        </div>
      </div>
    </div>

    <div class="md:col-span-2">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined text-base text-slate-400">info</span>
        Dettagli
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <p class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Collezione</p>
          <p class="text-sm font-medium text-slate-800 dark:text-slate-200"><%= item.collection&.description %></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Prezzo unitario</p>
          <p class="text-sm font-medium text-slate-800 dark:text-slate-200"><%= number_to_currency(item.unit_price, unit: "€", precision: 2) if item.unit_price %></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Creato il</p>
          <p class="text-sm font-medium text-slate-800 dark:text-slate-200"><%= l(item.created_at, format: :long) if item.created_at %></p>
        </div>
      </div>
      <% if item.note.present? %>
        <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-600">
          <p class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-1">Note</p>
          <p class="text-sm text-slate-700 dark:text-slate-300 whitespace-pre-wrap"><%= item.note %></p>
        </div>
      <% end %>
    </div>
  </div>

  <% if item.pictures.any? %>
    <div class="mt-6 pt-6 border-t border-slate-100 dark:border-slate-600">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined text-base text-slate-400">image</span>
        Immagini
      </h3>
      <div class="flex flex-wrap gap-3">
        <% item.pictures.each do |pic| %>
          <%= link_to gallery_item_path(item, index: item.pictures.index(pic)), data: { turbo_frame: "item_modal" } do %>
            <%= image_tag pic, class: "w-24 h-24 object-cover rounded-sm border border-slate-200 dark:border-slate-600 hover:opacity-80 transition-opacity" %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if local_assigns[:show_actions] %>
    <div class="mt-6 pt-6 border-t border-slate-100 dark:border-slate-600 flex flex-wrap items-center gap-3">
      <%= link_to edit_item_path(item),
            class: "inline-flex items-center gap-1.5 px-4 py-2 bg-accent text-white text-xs uppercase tracking-wider rounded-sm hover:opacity-90 transition-opacity" do %>
        <span class="material-symbols-outlined text-base">edit</span>
        Modifica
      <% end %>

      <%= button_to item_path(item), method: :delete,
            class: "inline-flex items-center gap-1.5 px-4 py-2 border border-red-400 text-red-500 text-xs uppercase tracking-wider rounded-sm hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors",
            data: { turbo_confirm: "Eliminare questo articolo?" } do %>
        <span class="material-symbols-outlined text-base">delete</span>
        Elimina
      <% end %>

      <%= link_to mainware_index_path,
            class: "inline-flex items-center gap-1.5 px-4 py-2 text-slate-500 dark:text-slate-400 text-xs uppercase tracking-wider rounded-sm hover:text-slate-700 dark:hover:text-slate-200 transition-colors" do %>
        <span class="material-symbols-outlined text-base">arrow_back</span>
        Torna agli articoli
      <% end %>
    </div>
  <% end %>
</div>
