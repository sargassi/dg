<%= turbo_frame_tag "item_modal" do %>
  <div class="fixed inset-0 bg-black/30 backdrop-blur-sm z-50 flex items-start justify-center pt-20" data-controller="insertevent" data-action="click->insertevent#closeModal">
    <div class="bg-white border border-slate-200 shadow-lg w-full max-w-lg mx-4" data-action="click->insertevent#stopPropagation">
      <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
        <h2 class="text-sm font-semibold text-slate-700">Modifica Articolo</h2>
        <%= link_to mainware_index_path,
              class: "text-slate-400 hover:text-slate-600 transition",
              data: { turbo_frame: "_top" } do %>
          <span class="material-symbols-outlined text-lg">close</span>
        <% end %>
      </div>
      <div class="p-4">
        <%= render "form", item: @item %>

        <div class="mt-4 pt-4 border-t border-slate-200">
          <%= button_to "Elimina", item_path(@item), method: :delete,
                class: "text-xs text-red-500 hover:text-red-700 transition",
                data: { turbo_confirm: "Eliminare questo articolo?" } %>
        </div>
      </div>
    </div>
  </div>
<% end %>
