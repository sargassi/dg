<%= turbo_frame_tag "item_modal" do %>
  <div class="fixed inset-0 bg-black/30 backdrop-blur-sm z-50 flex items-center justify-center p-6" data-controller="insertevent" data-action="click->insertevent#closeModal">
    <div class="bg-white border border-slate-200 shadow-lg w-full max-w-4xl mx-4 relative" data-controller="loader" data-action="click->insertevent#stopPropagation">
      <%# Spinner overlay %>
      <div data-loader-target="spinner" class="hidden absolute inset-0 bg-white/80 z-20 flex-col items-center justify-center gap-2">
        <svg class="animate-spin h-8 w-8 text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="text-xs text-slate-500 uppercase tracking-wider">Caricamento...</span>
      </div>
      <%# Dim header with riepilogo articolo %>
      <div data-loader-target="form" class="bg-slate-800 px-6 py-4">
        <div class="flex items-center gap-4">
          <div>
            <span class="text-xxs uppercase tracking-wider text-slate-400 block leading-none mb-0.5">Itemcode</span>
            <span class="text-sm font-mono text-slate-100"><%= @item.itemcode %></span>
          </div>
          <span class="text-slate-600 select-none text-xs">|</span>
          <div>
            <span class="text-xxs uppercase tracking-wider text-slate-400 block leading-none mb-0.5">Fabricode</span>
            <span class="text-sm font-mono text-slate-100"><%= @item.fabricode %></span>
          </div>
          <span class="text-slate-600 select-none text-xs">|</span>
          <div>
            <span class="text-xxs uppercase tracking-wider text-slate-400 block leading-none mb-0.5">Varcode</span>
            <span class="text-sm font-mono text-slate-100"><%= @item.varcode %></span>
          </div>
          <% if @item.description.present? %>
            <span class="w-px h-8 bg-slate-700"></span>
            <span class="text-xs text-slate-300 truncate max-w-48"><%= @item.description %></span>
          <% end %>
          <span class="w-px h-8 bg-slate-700"></span>
          <span class="text-xs text-slate-300 whitespace-nowrap font-medium">Collezione: <%= @item.collection&.description || "—" %></span>
          <%= link_to mainware_index_path,
                class: "text-slate-500 hover:text-slate-300 transition shrink-0 ml-auto",
                data: { turbo_frame: "_top" } do %>
            <span class="material-symbols-outlined text-lg">close</span>
          <% end %>
        </div>
      </div>
      <%# Form content %>
      <div data-loader-target="form" class="p-5">
        <%= render "form", item: @item %>
      </div>
    </div>
  </div>
<% end %>
