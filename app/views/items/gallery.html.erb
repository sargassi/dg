<%= turbo_frame_tag "item_modal" do %>
  <div class="fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-6">
    <div class="relative bg-white rounded-sm shadow-lg">
      <% return_to = params[:return_to].presence || mainware_index_path %>
      <%= link_to return_to,
            class: "absolute -top-3 -right-3 z-10 w-8 h-8 bg-white rounded-full shadow flex items-center justify-center text-slate-500 hover:text-slate-700 transition",
            data: { turbo_frame: "_top" } do %>
        <span class="material-symbols-outlined text-lg">close</span>
      <% end %>
      <div data-controller="carousel" data-carousel-length-value="<%= @pictures.count %>" data-carousel-index-value="<%= @index %>" class="p-4">
        <div class="relative flex items-center justify-center" style="max-width: 600px; max-height: 70vh;">
          <% @pictures.each_with_index do |pic, i| %>
            <div data-carousel-target="slide" class="relative <%= i == @index ? '' : 'hidden' %>">
              <%= image_tag pic, class: "max-w-full max-h-[70vh] object-contain" %>
              <% unless params[:return_to].present? %>
                <%= button_to delete_picture_item_path(@item, picture_id: pic.id, index: i),
                      method: :delete,
                      class: "absolute top-2 right-2 w-8 h-8 bg-red-500 text-white rounded-full flex items-center justify-center opacity-70 hover:opacity-100 transition shadow",
                      data: { turbo_confirm: "Rimuovere questa immagine?", turbo_frame: @pictures.count == 1 ? "_top" : "item_modal" } do %>
                  <span class="material-symbols-outlined text-base leading-none">delete</span>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
        <% if @pictures.count > 1 %>
          <div class="flex items-center justify-center gap-4 mt-3">
            <button type="button" data-action="carousel#prev"
                  class="p-2 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 transition">
              <span class="material-symbols-outlined text-base leading-none">chevron_left</span>
            </button>
            <span class="text-xs text-slate-500 tabular-nums" data-carousel-target="counter">1 / <%= @pictures.count %></span>
            <button type="button" data-action="carousel#next"
                  class="p-2 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 transition">
              <span class="material-symbols-outlined text-base leading-none">chevron_right</span>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
