<% content_for :page_header do %>
<div class="flex items-center gap-2 px-0 py-0.5">
  <h1 class="text-sm font-semibold text-slate-500 dark:text-slate-400 tracking-wide">
    Articoli / Dettaglio
  </h1>
</div>
<% end %>

<section class="<%= style_main_cnt %>">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-sm inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="max-w-3xl mx-auto">
    <%= render 'item_card', item: @item, show_actions: true %>
  </div>
</section>

<%= turbo_frame_tag "item_modal" %>
