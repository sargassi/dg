<% menu = mainware_menu(active: 'articoli') %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: { link: '/', label: 'Articoli / Dettaglio', menu: menu } %>
</div>

<section class="<%= style_main_cnt %>">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-sm inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="max-w-3xl mx-auto">
    <%= render 'item_card', item: @item, show_actions: true %>
  </div>
</section>

<%= turbo_frame_tag "item_modal" %>
