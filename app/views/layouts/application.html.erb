<!DOCTYPE html>
<html data-controller="theme">
  <head>
    <title>Ok'am Srl</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,100,0,-25" >
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 transition-colors">

    <% if controller_name == 'app' %>
      <%= yield %>

    <% elsif controller_name == 'sessions' %>
      <main class="min-h-screen flex items-center justify-center bg-slate-100 dark:bg-slate-900">
        <%= yield %>
      </main>

    <% else %>
        <main class="flex gap-4">
            <section class="w-16 fixed top-0 left-0 h-screen z-50">
            <%= render partial: '/layouts/menus/side/structure' %>
            </section>

            <section class="home px-4 my-2 ml-16 grow">
            <div class="flex items-center justify-between px-3 py-2.5 bg-slate-100 dark:bg-slate-700/80 border-b border-slate-300 dark:border-slate-600">
              <%= yield(:page_header) %>
              <% if current_user.present? %>
              <div class="flex items-center gap-1.5">
                <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium truncate max-w-28"><%= current_user.email %></span>
                <%= link_to edit_profile_path, data: { turbo_frame: "profile_modal" }, class: "w-6 h-6 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-accent dark:hover:text-accent-300 transition rounded-sm hover:bg-white/60 dark:hover:bg-slate-600" do %>
                  <span class="material-symbols-outlined text-sm">person</span>
                <% end %>
                <a href="#" data-action="click->theme#toggle" class="w-6 h-6 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-amber-500 dark:hover:text-amber-400 transition rounded-sm hover:bg-white/60 dark:hover:bg-slate-600">
                  <span class="material-symbols-outlined text-sm" data-theme-target="icon">light_mode</span>
                </a>
              </div>
              <% end %>
            </div>
            <%= render 'atoms/section_toolbar', items: section_toolbar_items %>
            <%= yield %>
            </section>
        </main>

    <% end %>

    <%= turbo_frame_tag 'success' %>
    <%= turbo_frame_tag 'profile_modal' %>

    <% if notice %>
      <div data-controller="notifications"
           data-notifications-auto-dismiss-value="4000"
           class="fixed bottom-4 right-4 z-50 max-w-sm w-full
                  translate-x-full opacity-0
                  transition-all duration-300 ease-out
                  bg-white dark:bg-slate-800 rounded-lg shadow-xl border-l-4 border-emerald-500 p-4
                  flex items-start gap-3">
        <span class="material-symbols-outlined text-emerald-500 text-xl flex-shrink-0">check_circle</span>
        <span class="text-sm text-slate-800 dark:text-slate-200 pt-0.5"><%= notice %></span>
      </div>
    <% end %>

    <% if alert %>
      <div data-controller="notifications"
           data-notifications-auto-dismiss-value="4000"
           class="fixed bottom-4 right-4 z-50 max-w-sm w-full
                  translate-x-full opacity-0
                  transition-all duration-300 ease-out
                  bg-white dark:bg-slate-800 rounded-lg shadow-xl border-l-4 border-red-500 p-4
                  flex items-start gap-3">
        <span class="material-symbols-outlined text-red-500 text-xl flex-shrink-0">error</span>
        <span class="text-sm text-slate-800 dark:text-slate-200 pt-0.5"><%= alert %></span>
      </div>
    <% end %>

    <script>
      function highlightRow() {
        // First try sessionStorage (set when modal opened)
        let anchor = sessionStorage.getItem('highlightRow')
        
        // Fall back to URL hash
        if (!anchor) {
          const match = location.href.match(/#prow-(\d+)/)
          anchor = match ? match[0] : null
        }
        
        if (anchor && anchor.startsWith('#prow-')) {
          const rowId = anchor.replace('#prow-', '')
          const row = document.getElementById('prow-' + rowId)
          
          if (row) {
            row.classList.add('border-4', 'border-blue-500')
            setTimeout(() => {
              row.classList.remove('border-4', 'border-blue-500')
              sessionStorage.removeItem('highlightRow')
            }, 3000)
          }
        }
      }

      // Listen to turbo frame loads
      document.addEventListener('turbo:frame-load', (event) => {
        console.log('[HIGHLIGHT] Frame loaded:', event.target.id)
        highlightRow()
      })

      document.addEventListener('turbo:load', highlightRow)
      window.addEventListener('load', highlightRow)
      
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        setTimeout(highlightRow, 100)
      }
    </script>
  </body>
</html>
