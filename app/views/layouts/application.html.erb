<!DOCTYPE html>
<html>
  <head>
    <title>Ok'am Srl</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,100,0,-25" >
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <main class="container mx-auto mt-16">
    <% if controller_name == 'app' %>

      <%= render partial: 'layouts/headers/app' %>

    <% else %>
        <%= render partial: 'layouts/headers/default' %>

    <% end %>
      <%= yield %>
    </main>
    <% if current_user.present? %>
    <div class="text-sm text-center">             <p class="fixed top-0 right-0 text-sm "><%= button_to "logout", destroy_user_session_path(current_user.id), method: :delete  %></p>
</div>
<% end %>


  </body>
</html>
