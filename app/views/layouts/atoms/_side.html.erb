<ul class="<%= style_side_ul %>">

    <%= render partial: "layouts/menus/side/home" %>

    <% if user_signed_in? %>
        <% if current_user.godlike? || current_user.can?('print_labels_proforma') || current_user.can?('manage_utilities_labels') %>
          <%= render partial: "/layouts/menus/side/utilities" %>
        <% end %>

        <% if current_user.godlike? || current_user.can?('manage_proformas') || current_user.can?('view_production') || current_user.can?('manage_mainware') || current_user.can?('manage_inventory') %>
          <%= render partial: "/layouts/menus/side/lab" %>
        <% end %>

        <% if current_user.godlike? || current_user.can?('manage_directory') || current_user.can?('manage_users') %>
          <%= render partial: "/layouts/menus/side/users" %>
        <% end %>

        <%= render partial: "layouts/menus/side/logout" %>

    <% end %>
</ul>
