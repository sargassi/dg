<%= form_with(model: location, class: "contents") do |form| %>
  <% if location.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium mt-3 border border-red-200">
      <h2><%= pluralize(location.errors.count, "error") %> prohibited this location from being saved:</h2>

      <ul>
        <% location.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :code, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
    <%= form.text_field :code, class: "border border-slate-300 outline-none px-3 py-2 mt-2 w-full text-sm" %>
  </div>

  <div class="my-5">
    <%= form.label :warehouse_id, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
    <%= form.collection_select :warehouse_id, Warehouse.all, :id, :code,
          { include_blank: true },
          class: "border border-slate-300 outline-none px-3 py-2 mt-2 w-full text-sm" %>
  </div>

  <div class="my-5">
    <label class="text-xs text-slate-400 uppercase tracking-wide block mb-1">
      <%= form.check_box :enabled, class: "mr-2" %>
      Abilitato
    </label>
  </div>

  <div>
    <%= form.submit  class: style_import_btn %>
  </div>
<% end %>
