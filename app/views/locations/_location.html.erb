<div id="<%= dom_id location %>" class="border border-slate-200 p-4">
  <div class="grid grid-cols-2 gap-4">
    <div>
      <span class="text-xs text-slate-400 uppercase tracking-wide">Codice</span>
      <p class="text-sm font-semibold text-slate-700"><%= location.code %></p>
    </div>
    <div>
      <span class="text-xs text-slate-400 uppercase tracking-wide">Magazzino</span>
      <p class="text-sm text-slate-700"><%= location.warehouse&.code || location.warehouse_id %></p>
    </div>
    <div>
      <span class="text-xs text-slate-400 uppercase tracking-wide">Abilitato</span>
      <p class="text-sm text-slate-700"><%= location.enabled ? 'Sì' : 'No' %></p>
    </div>
  </div>

  <% if action_name != "show" %>
    <div class="flex gap-2 mt-4 pt-4 border-t border-slate-200">
      <%= link_to "Mostra", location, class: "#{style_main_btn} bg-blue-500" %>
      <%= link_to "Modifica", edit_location_path(location), class: "#{style_main_btn} bg-slate-500" %>
    </div>
  <% end %>
</div>
