<% menu = [
  { label: 'Dashboard', path: mainware_dashboard_path, active: false, icon: 'dashboard' },
  { label: 'Articoli', path: mainware_index_path, active: false, icon: 'inventory_2' },
  { label: 'Magazzini', path: warehouses_path, active: false, icon: 'warehouse' },
  { label: 'Ubiche', path: locations_path, active: true, icon: 'location_on' },
] %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: {link: '/', label: 'Generale / Location', menu: menu} %>
</div>

<section class="<%= style_main_cnt %>">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="grid grid-cols-1 gap-8" style="grid-template-columns: 1fr auto;">
    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">location_on</span>
        Ubiche
        <span class="<%= style_main_card_badge %>"><%= @locations.count %></span>
      </h3>
      <div id="locations" class="space-y-0">
        <%= render @locations %>
        <% if @locations.empty? %>
          <div class="text-sm text-slate-400 italic py-4">Nessuna ubica configurata</div>
        <% end %>
      </div>
    </div>

    <div>
      <%= link_to "Nuova Ubica", new_location_path, class: "p-3 bg-accent inline-block tracking-wider rounded-sm uppercase text-xs cursor-pointer text-white" %>
    </div>
  </div>
</section>
