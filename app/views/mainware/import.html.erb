<% content_for :page_header do %>
<div class="flex items-center gap-2 px-0 py-0.5">
  <%= link_to mainware_dashboard_path, class: "text-sm font-semibold text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300 tracking-wide" do %>
    Articoli
  <% end %>
  <span class="text-slate-300 dark:text-slate-600">/</span>
  <h1 class="text-sm font-semibold text-slate-500 dark:text-slate-400 tracking-wide">
    Generale / Import
  </h1>
</div>
<% end %>

<section class="<%= style_main_cnt %> overflow-y-auto min-w-0" style="height: calc(100vh - 140px);">
  <% if @data.present? %>

    <h2 class="<%= style_main_sub_header %>">
      Anteprima importazione (<span id="import-count"><%= @data[:rows].size %></span> righe)
    </h2>

    <% coll_rows = @data[:rows].select { |r| r[:_collection_id] }.group_by { |r| [r[:_collection_id], r[:_collection_description], r[:_collection_new]] } %>

    <div id="import-summary" class="bg-slate-50 dark:bg-slate-800/50 rounded-lg p-4 mb-4 text-sm">
      <div class="font-semibold text-slate-700 dark:text-slate-300 mb-2">Riepilogo</div>
      <div>
        <div>
          <div class="text-xs text-slate-400 tracking-wide mb-1">Collection</div>
          <% coll_rows.each do |(id, desc, is_new), rows| %>
            <div class="<%= 'text-green-700 dark:text-green-400' if is_new %>">
              <%= "##{id} — #{desc}" %>
              <span class="text-slate-400">(<%= rows.size %> righe)</span>
              <% if is_new %><span class="text-green-600 font-bold"> [NUOVO]</span><% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <% if @data[:_collection_override_id].present? %>
      <p class="text-xs text-slate-500 dark:text-slate-400 mb-2">
        Collezione forzata: la colonna Note: è bloccata.
      </p>
    <% end %>

    <div class="bg-accent-50 dark:bg-accent-900/10 border border-accent-200 dark:border-accent-700 rounded-lg p-3 mb-4">
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 whitespace-nowrap">Collezione in massa:</span>
        <%= form_with url: mainware_import_bulk_collection_path, method: :post, class: "flex items-center gap-2" do |f| %>
          <%= f.collection_select :collection_id, @collections, :id, :description,
                { include_blank: "Scegli esistente" },
                class: "bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded px-2 py-1 text-xs w-36" %>
          <span class="text-xs text-slate-400 dark:text-slate-500 whitespace-nowrap">oppure</span>
          <%= f.text_field :new_collection_name,
                placeholder: "Crea nuova...",
                class: "border border-slate-300 dark:border-slate-600 rounded px-2 py-1 text-xs w-36 bg-white dark:bg-slate-700 dark:text-slate-200" %>
          <%= f.submit "Applica a tutte le righe",
                class: "inline-flex items-center px-3 py-1 rounded-md text-xs font-medium bg-accent-600 text-white hover:bg-accent-700 cursor-pointer transition whitespace-nowrap" %>
        <% end %>
      </div>
      <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Assegna una collezione a tutte le righe; la colonna Note: verrà bloccata.</p>
    </div>

    <div class="overflow-x-auto mb-4">
      <table class="min-w-full" data-controller="inline-edit">
        <thead>
          <tr>
            <th class="<%= style_table_th %> sticky top-0 z-10 w-12 text-center"></th>
            <th class="<%= style_table_th %> sticky top-0 z-10 w-16 text-center">Riga</th>
            <th class="<%= style_table_th %> sticky top-0 z-10 w-40">Gencode</th>
            <th class="<%= style_table_th %> sticky top-0 z-10 w-36">Collezione</th>
            <% @data[:headers].each do |h| %>
              <th class="<%= style_table_th %> sticky top-0 z-10"><%= h %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @data[:rows].each do |row| %>
            <% row_class = case @row_classes[row[:_index]] when :new then 'bg-green-50/40 dark:bg-green-900/10' when :update then 'bg-amber-50/40 dark:bg-amber-900/10' else '' end %>
            <% row_errors = @validation_details[row[:_index]] || {} %>
            <% has_row_error = row_errors.values.any?(&:any?) %>
             <tr id="row-<%= row[:_index] %>"
                 data-row-index="<%= row[:_index] %>"
                 data-inline-edit-target="row"
                 class="hover:bg-slate-50 <%= row_class %> <%= 'border-l-4 border-red-400' if has_row_error %>">

              <td class="<%= style_table_td %> text-center">
                <button type="button"
                        data-action="inline-edit#deleteRow"
                        class="text-red-500 hover:text-red-700 cursor-pointer">
                  <span class="material-symbols-outlined text-sm">delete</span>
                </button>
              </td>

              <td class="<%= style_table_td %> text-center text-xs text-slate-400">
                <%= row[:_index] %>
              </td>

              <td class="<%= style_table_td %> text-xs font-mono text-blue-600"
                  data-inline-edit-target="gencode"
                  title="<%= row_errors[:gencode]&.join(', ') %>">
                <%= row[:_gencode] %>
              </td>

              <td class="<%= style_table_td %> text-xs <%= 'text-red-600 dark:text-red-400 font-medium' if !(row[:_collection_id].present? || row[:_collection_description].present?) %>">
                <% if row[:_collection_id].present? %>
                  <span class="text-slate-400 dark:text-slate-500">#<%= row[:_collection_id] %></span>
                  <span class="text-slate-700 dark:text-slate-200"><%= row[:_collection_description] %></span>
                <% elsif row[:_collection_new] %>
                  <span class="text-green-600 dark:text-green-400 font-medium">Nuova:</span>
                  <%= row[:_collection_description] %>
                <% else %>
                  <span class="italic text-slate-400 dark:text-slate-500">— mancante —</span>
                <% end %>
              </td>

              <% @data[:headers].each do |header| %>
                <% note_locked = header == 'Note:' && @data[:_collection_override_id].present? %>
                <% cell_errors = row_errors[header] || [] %>
                <% has_cell_error = cell_errors.any? %>
                <td class="<%= style_table_td %> p-0 <%= 'bg-slate-100 dark:bg-slate-700/50' if note_locked %> <%= 'bg-red-50/60 dark:bg-red-900/30' if has_cell_error %>">
                  <input type="text"
                         value="<%= row[header] %>"
                         data-field="<%= header %>"
                         data-action="input->inline-edit#update"
                         data-inline-edit-target="input"
                         data-default="<%= row[header] %>"
                         <%= 'disabled' if note_locked %>
                         title="<%= [note_locked ? "Collezione bloccata dall'override" : nil, cell_errors.join(', ')].compact.join(' — ') %>"
                         class="w-full px-2 py-1 text-xs border-none bg-transparent outline-none focus:bg-accent-50 <%= 'cursor-not-allowed opacity-60' if note_locked %> <%= 'border-b-2 border-red-400' if has_cell_error %>">
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @warnings.any? %>
      <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 rounded-lg p-4 mb-4">
        <p class="text-sm font-semibold text-red-800 dark:text-red-300 mb-2">Correggi questi problemi prima di confermare:</p>
        <ul class="text-xs text-red-700 dark:text-red-400 space-y-1">
          <% @warnings.each do |warning| %>
            <li><%= warning %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="flex gap-4">
      <% if @warnings.any? %>
        <button type="button" disabled class="<%= style_import_btn %> bg-green-600 opacity-50 cursor-not-allowed">
          Conferma importazione (<span id="import-count-btn"><%= @data[:rows].size %></span>)
        </button>
      <% else %>
        <%= form_with url: mainware_import_confirm_path, method: :post, data: { turbo: false } do %>
          <button type="submit" class="<%= style_import_btn %> bg-green-600">
            Conferma importazione (<span id="import-count-btn"><%= @data[:rows].size %></span>)
          </button>
        <% end %>
      <% end %>

      <%= button_to "Annulla", mainware_import_cancel_path, method: :delete, class: "#{style_import_btn} bg-gray-400" %>
    </div>

  <% else %>

    <section class="bg-accent-50 p-6" data-controller="loader">
      <div data-loader-target="form">
        <%= form_with url: mainware_import_parse_path, method: :post, multipart: true, local: true,
                     data: { action: "submit->loader#show" } do |f| %>

          <div class="flex items-center gap-3 flex-wrap">
            <div class="w-72">
              <%= f.file_field :file,
                  class: style_import_field,
                  accept: ".xlsx",
                  required: true %>
            </div>
            <div class="w-56">
              <%= f.collection_select :collection_id, @collections, :id, :description,
                  { include_blank: "Usa Note: (da file)" },
                  class: "#{style_select_class} py-1.5" %>
            </div>
            <%= f.submit "Carica",
                class: style_import_btn %>
            <%= link_to "Scarica modello", mainware_import_template_path,
                class: "text-sm text-accent hover:underline" %>
          </div>
          <p class="text-xs text-slate-500 mt-2">File consentito: .xlsx, massimo 5 MB.</p>
        <% end %>
      </div>

      <div data-loader-target="spinner" class="hidden justify-center items-center py-12">
        <svg class="animate-spin h-10 w-10 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="ml-3 text-slate-600">Caricamento in corso...</span>
      </div>
    </section>

  <% end %>
</section>
