<% content_for :page_header do %>
<%= render "application/breadcrumb", dashboard_path: mainware_dashboard_path, section_name: "Articoli", page_title: "Generale / Import / Conferma" %>
<% end %>

<section class="<%= style_main_cnt %>">
  <div class="max-w-2xl mx-auto bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg p-8">
    <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 mb-2">Conferma importazione</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">Verifica il riepilogo prima di avviare l'importazione.</p>

    <div class="grid grid-cols-2 gap-4 mb-6">
      <div class="bg-slate-50 dark:bg-slate-700/50 p-4 rounded-lg text-center">
        <p class="text-3xl font-bold text-slate-700 dark:text-slate-200"><%= @summary[:total] %></p>
        <p class="text-xs text-slate-500 dark:text-slate-400 uppercase">Righe totali</p>
      </div>

      <div class="bg-green-50 dark:bg-green-900/20 p-4 rounded-lg text-center">
        <p class="text-3xl font-bold text-green-700 dark:text-green-400"><%= @summary[:new_items] %></p>
        <p class="text-xs text-green-600 dark:text-green-400 uppercase">Nuovi articoli</p>
      </div>

      <div class="bg-accent-50 dark:bg-blue-900/20 p-4 rounded-lg text-center">
        <p class="text-3xl font-bold text-blue-700 dark:text-blue-400"><%= @summary[:updated_items] %></p>
        <p class="text-xs text-blue-600 dark:text-blue-400 uppercase">Articoli aggiornati</p>
      </div>

      <div class="bg-slate-50 dark:bg-slate-700/50 p-4 rounded-lg text-center">
        <p class="text-3xl font-bold text-slate-700 dark:text-slate-200"><%= @summary[:new_collections].size %></p>
        <p class="text-xs text-slate-500 dark:text-slate-400 uppercase">Nuove anagrafiche</p>
      </div>
    </div>

    <% if @summary[:new_collections].any? %>
      <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-700 rounded-lg p-4 mb-6">
        <p class="text-sm font-semibold text-yellow-800 dark:text-yellow-300 mb-2">Verranno create le seguenti anagrafiche:</p>
        <div class="mb-2">
          <span class="text-xs font-semibold text-yellow-700 dark:text-yellow-400 uppercase">Collezioni</span>
          <p class="text-sm text-yellow-800 dark:text-yellow-300"><%= @summary[:new_collections].join(", ") %></p>
        </div>
      </div>
    <% end %>

    <%= form_with url: mainware_import_confirm_path, method: :post, data: { turbo: false } do %>
      <%= hidden_field_tag :confirmed, true %>
      <button type="submit" class="block w-full text-center <%= style_save_button %> px-4 py-1.5 tracking-wider rounded-sm uppercase text-xs cursor-pointer transition-colors mb-3">
        Conferma e avvia importazione
      </button>
    <% end %>

    <%= link_to "Torna alla revisione", mainware_import_path,
          class: "block w-full text-center #{style_import_btn} bg-gray-400" %>
  </div>
</section>
