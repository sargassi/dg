<% content_for :page_header do %>
<div class="flex items-center gap-2 px-0 py-0.5">
  <h1 class="text-sm font-semibold text-slate-500 dark:text-slate-400 tracking-wide">
    Generale / Import
  </h1>
</div>
<% end %>

<section class="<%= style_main_cnt %>" data-controller="import-progress"
         data-import-progress-url-value="<%= mainware_import_progress_path %>"
         data-import-progress-summary-value="<%= mainware_import_summary_path %>">
  <div class="max-w-md mx-auto bg-white border border-slate-200 rounded-lg p-8 text-center">
    <h2 class="text-2xl font-bold text-slate-800 mb-6">Importazione in corso...</h2>

    <div class="mb-6">
      <div class="flex justify-between text-sm text-slate-600 mb-2">
        <span data-import-progress-target="label">Elaborazione righe...</span>
        <span data-import-progress-target="percent">0%</span>
      </div>
      <div class="w-full bg-slate-200 rounded-full h-4 overflow-hidden">
        <div data-import-progress-target="bar"
             class="bg-blue-600 h-full rounded-full transition-all duration-500"
             style="width: 0%"></div>
      </div>
      <p class="text-xs text-slate-400 mt-2" data-import-progress-target="counter">0 / <%= @progress[:total] %></p>
    </div>

    <div data-import-progress-target="spinner" class="flex justify-center">
      <svg class="animate-spin h-8 w-8 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </div>

    <div data-import-progress-target="done" class="hidden">
      <p class="text-green-600 font-semibold mb-4">Importazione completata</p>
      <%= link_to "Vedi riepilogo", mainware_import_summary_path,
            class: "inline-block rounded-lg py-3 px-6 bg-green-600 text-white font-medium cursor-pointer" %>
    </div>
  </div>
</section>
