<% content_for :page_header do %>
<div class="flex items-center gap-2 px-0 py-0.5">
  <%= link_to mainware_index_path, class: "text-sm font-semibold text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300 tracking-wide" do %>
    Articoli
  <% end %>
  <span class="text-slate-300 dark:text-slate-600">/</span>
  <h1 class="text-sm font-semibold text-slate-500 dark:text-slate-400 tracking-wide">
    Generale / Import
  </h1>
</div>
<% end %>

<section class="<%= style_main_cnt %>">
  <div class="max-w-md mx-auto bg-white border border-slate-200 rounded-lg p-8 text-center">
    <h2 class="text-2xl font-bold text-slate-800 mb-6">Importazione completata</h2>

    <div class="grid grid-cols-2 gap-4 mb-8">
      <div class="bg-slate-50 p-4 rounded-lg">
        <p class="text-3xl font-bold text-slate-700"><%= @stats[:total] %></p>
        <p class="text-xs text-slate-500 uppercase">Righe processate</p>
      </div>

      <div class="bg-green-50 p-4 rounded-lg">
        <p class="text-3xl font-bold text-green-700"><%= @stats[:created] %></p>
        <p class="text-xs text-green-600 uppercase">Nuovi</p>
      </div>

      <div class="bg-accent-50 dark:bg-slate-800 p-4 rounded-lg">
        <p class="text-3xl font-bold text-blue-700"><%= @stats[:updated] %></p>
        <p class="text-xs text-blue-600 uppercase">Aggiornati</p>
      </div>

      <div class="<%= @stats[:errors].any? ? 'bg-red-50' : 'bg-slate-50' %> p-4 rounded-lg">
        <p class="text-3xl font-bold <%= @stats[:errors].any? ? 'text-red-700' : 'text-slate-300' %>"><%= @stats[:errors].size %></p>
        <p class="text-xs <%= @stats[:errors].any? ? 'text-red-600' : 'text-slate-400' %> uppercase">Errori</p>
      </div>
    </div>

    <% if @stats[:errors].any? %>
      <div class="text-left bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
        <div class="flex items-center justify-between mb-2">
          <p class="text-sm font-semibold text-red-800">Dettagli errori (<%= @stats[:errors].size %> righe):</p>
          <%= link_to "Scarica righe con errore", mainware_import_failed_rows_path,
                class: "text-xs text-red-700 hover:underline" %>
        </div>

        <% @stats[:errors].group_by { |err| err[:error] }.each do |message, group| %>
          <div class="mb-4 last:mb-0">
            <p class="text-xs font-semibold text-red-700 mb-1"><%= group.size %> × <%= message %></p>
            <div class="overflow-x-auto">
              <table class="min-w-full text-xs text-left">
                <thead>
                  <tr class="border-b border-red-200">
                    <th class="py-1 pr-3 font-semibold text-red-800">Riga</th>
                    <th class="py-1 pr-3 font-semibold text-red-800">Gencode</th>
                    <% group.first[:fields].keys.each do |header| %>
                      <th class="py-1 pr-3 font-semibold text-red-800"><%= header %></th>
                    <% end %>
                  </tr>
                </thead>
                <tbody>
                  <% group.each do |err| %>
                    <tr class="border-b border-red-100 last:border-b-0">
                      <td class="py-1 pr-3 whitespace-nowrap"><%= err[:row] %></td>
                      <td class="py-1 pr-3 font-mono text-red-700"><%= err[:gencode] %></td>
                      <% err[:fields].values.each do |value| %>
                        <td class="py-1 pr-3"><%= value %></td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= link_to mainware_index_path, class: "block w-full #{style_import_btn} bg-green-600 text-center cursor-pointer mb-3" do %>
      Vai alla lista articoli
    <% end %>

    <% if @import_log %>
      <%= link_to import_log_path(@import_log), class: "block w-full #{style_import_btn} bg-blue-600 text-center cursor-pointer mb-3" do %>
        Vedi dettaglio importazione
      <% end %>
    <% end %>

    <%= link_to import_logs_path, class: "block w-full text-center text-sm text-slate-500 hover:text-slate-700 mb-3" do %>
      Storico importazioni
    <% end %>

    <% if @stats[:created_ids]&.any? %>
      <%= button_to mainware_import_rollback_path, method: :delete,
            class: "block w-full #{style_import_btn} bg-red-600 text-center cursor-pointer",
            data: { confirm: "Annullare l'importazione? (#{@stats[:created_ids].size} articoli creati verranno eliminati. #{@stats[:updated_ids]&.size || 0} aggiornamenti non verranno ripristinati.)", turbo_submits_with: "Rollback in corso..." } do %>
        Rollback (<%= @stats[:created_ids].size %> nuovi)
      <% end %>
    <% end %>
  </div>
</section>
