<% content_for :page_header do %>
<div class="flex items-center gap-2 px-0 py-0.5">
  <%= link_to mainware_dashboard_path, class: "text-sm font-semibold text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300 tracking-wide" do %>
    Articoli
  <% end %>
  <span class="text-slate-300 dark:text-slate-600">/</span>
  <h1 class="text-sm font-semibold text-slate-500 dark:text-slate-400 tracking-wide">
    Ricerca
  </h1>
</div>
<% end %>

<% column_headers = %w[Gencode Item Fabric Var. Descrizione Tg Fabric Color Materiale Note Collezione Prezzo Showroom QR Immagini Azioni] %>

<section class="<%= style_main_cnt %> flex flex-col" style="height: calc(100vh - 110px);" data-controller="search-filter column-toggle" data-column-toggle-storage-key-value="mainware-index-hidden-columns">
  <div class="flex gap-4 items-center mb-4 flex-none">
    <%= form_with url: mainware_index_path, method: :get,
                  data: { search_filter_target: "form", turbo_frame: "items-table" },
                  class: "flex items-center gap-3" do |f| %>
      <div class="relative">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500 text-base pointer-events-none">search</span>
        <%= f.search_field :q,
              value: params[:q],
              placeholder: "Cerca in tutte le colonne",
              class: "#{style_search_input} rounded-lg pl-10 font-mono text-blue-600 dark:text-blue-400",
              data: { action: "input->search-filter#filter", search_filter_target: "input" } %>
      </div>
      <%= f.collection_select :collection_id, @collections, :id, :description,
            { include_blank: "-", selected: @collection_id },
            class: "border border-accent-100 outline-none p-2 text-xs bg-white dark:bg-slate-700 dark:text-slate-200 dark:border-slate-600 rounded-lg shadow-sm w-32",
            data: { search_filter_target: "select", action: "change->search-filter#filter", search_filter_active_class: "bg-blue-400 dark:bg-blue-600 text-white dark:text-white", search_filter_inactive_class: "bg-white dark:bg-slate-700 dark:text-slate-200" } %>
    <% end %>
    <span id="count-display" data-search-filter-target="count" class="text-sm font-bold text-slate-700 dark:text-slate-200 whitespace-nowrap border border-slate-300 dark:border-slate-600 dark:bg-slate-700 rounded-full px-3 py-1"><%= @pagy.count %> articoli</span>

    <div class="relative ml-auto">
      <button type="button"
              data-action="click->column-toggle#toggleMenu"
              class="inline-flex items-center gap-1 px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-600 text-xs font-medium text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 transition">
        <span class="material-symbols-outlined text-base">view_column</span>
        Colonne
      </button>
      <div data-column-toggle-target="menu"
           class="hidden absolute right-0 mt-2 w-48 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-lg z-20 p-2 max-h-80 overflow-y-auto">
        <% column_headers.each_with_index do |header, idx| %>
          <label class="flex items-center gap-2 px-2 py-1.5 text-xs text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 rounded cursor-pointer">
            <input type="checkbox"
                   checked
                   data-column-toggle-checkbox
                   data-index="<%= idx %>"
                   data-action="change->column-toggle#toggle"
                   class="rounded border-slate-300 text-accent focus:ring-accent">
            <%= header %>
          </label>
        <% end %>
      </div>
    </div>

    <%= link_to "Importa da Excel", mainware_import_path, class: "#{style_import_btn} ml-2" %>
  </div>

  <style>
    turbo-frame#items-table[busy] .items-table-content { display: none; }
    turbo-frame#items-table[busy] .items-table-loader { display: flex; }
    turbo-frame#items-table td svg { width: 100%; height: auto; display: block; }
  </style>
  <%= turbo_frame_tag "items-table", class: "flex flex-col flex-1 min-h-0", data: { action: "turbo:frame-load->search-filter#onFrameLoad" } do %>
    <div class="items-table-content flex flex-col flex-1 min-h-0">
      <span hidden data-filtered-count><%= @pagy.count %></span>
      <div class="overflow-x-auto flex-1 min-h-0 overflow-y-auto">
        <table class="min-w-full">
          <thead>
            <tr>
              <% column_headers.each do |h| %>
                <th class="<%= style_table_th %> sticky top-0 z-10"><%= h %></th>
              <% end %>
            </tr>
          </thead>
          <%= render partial: 'item_row', collection: @itemz, as: :item, locals: { siblings_by_parent: @siblings_by_parent } %>
        </table>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="flex-none flex items-center gap-0.5 justify-end pt-3 pb-1">
          <%# Previous %>
          <% if @pagy.prev %>
            <a href="<%= pagy_url_for(@pagy, @pagy.prev) %>"
               data-turbo-frame="items-table"
               class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
              <span class="material-symbols-outlined text-base">chevron_left</span>
            </a>
          <% else %>
            <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-300 dark:text-slate-500 pointer-events-none">
              <span class="material-symbols-outlined text-base">chevron_left</span>
            </span>
          <% end %>

          <%# Pages %>
          <% @pagy.series.each do |item| %>
            <% if item.is_a?(Integer) %>
              <a href="<%= pagy_url_for(@pagy, item) %>"
                 data-turbo-frame="items-table"
                 class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                <%= item %>
              </a>
            <% elsif item == :gap %>
              <span class="px-1 text-slate-400 dark:text-slate-500 text-xs">…</span>
            <% elsif item == @pagy.page %>
              <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm bg-accent text-white font-medium">
                <%= item %>
              </span>
            <% end %>
          <% end %>

          <%# Next %>
          <% if @pagy.next %>
            <a href="<%= pagy_url_for(@pagy, @pagy.next) %>"
               data-turbo-frame="items-table"
               class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
              <span class="material-symbols-outlined text-base">chevron_right</span>
            </a>
          <% else %>
            <span class="inline-flex items-center justify-center min-w-[2rem] h-8 text-xs rounded-sm text-slate-300 dark:text-slate-500 pointer-events-none">
              <span class="material-symbols-outlined text-base">chevron_right</span>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="items-table-loader hidden justify-center items-center py-12">
      <svg class="animate-spin h-10 w-10 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="ml-3 text-slate-600 dark:text-slate-300">Ricerca in corso...</span>
    </div>
  <% end %>
</section>

<%= turbo_frame_tag "item_modal" %>
