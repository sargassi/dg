<div id="<%= dom_id operationtype %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Code:</strong>
    <%= operationtype.code %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= operationtype.description %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this operationtype", operationtype, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to "Edit this operationtype", edit_operationtype_path(operationtype), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
