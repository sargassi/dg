<div id="<%= dom_id operationtype %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Code:</strong>
    <%= operationtype.code %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= operationtype.description %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this operationtype", operationtype, class: "#{style_btn(variant: :neutral)}" %>
    <%= link_to "Edit this operationtype", edit_operationtype_path(operationtype), class: "ml-2 #{style_btn(variant: :neutral)}" %>
    <hr class="mt-6">
  <% end %>
</div>
