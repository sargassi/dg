<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Operationtypes</h1>
    <%= link_to "New operationtype", new_operationtype_path, class: "#{style_btn(variant: :primary)}" %>
  </div>

  <div id="operationtypes" class="min-w-full">
    <%= render @operationtypes %>
  </div>
</div>
