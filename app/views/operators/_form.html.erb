<%= form_with(model: operator, class: form_container , data:{ turbo_frame: '_top'}) do |form| %>
  <div class="<%= style_form_group %>">
        <div class="w-1/2">
            <%= form.label 'Nome', class: label_class %>
            <%= form.text_field :name, class: input_class %>
        </div>

    <div class="w-1/2">
        <%= form.label 'Cognome', class: label_class %>
        <%= form.text_field :lastname, class: input_class %>
    </div>
  </div>
  <div class="<%= style_form_group %>">
    <div class="w-1/2">
        <%= form.label 'Ruolo', class: label_class %>
        <%= select_tag :role, options_for_select(Operator.roles), { class: select_class } %>
    </div>
  </div>

  <div class="<%= style_form_group %>">
    <div class="w-full text-end">
        <%= form.submit 'Crea', class: button_class %>
    </div>
  </div>
<% end %>
