<div class="<%= style_main_header_container %>">
    <%= render partial: 'atoms/header', locals: {link: '/', label: 'Operatori'} %>
</div>
<section class="<%= style_main_cnt %> flex gap-8">
    <div class="<%= style_main_lists_sub %> grow p-2 my-16">
        <%= render partial: 'atoms/ux/list', locals: {:data => @operators} %>
    </div>
    <div class="<%= style_main_lists_sub %> w-1/3">
        <div class="my-4">
          <%= turbo_frame_tag 'insidejoke' do %>
            <%= link_to "Nuovo operatore", new_operator_path, class: style_main_btn, data: {turbo_frame: 'insidejoke'} %>
            <% end %>
        </div>

      </div>
</section>
