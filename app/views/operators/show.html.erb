<%= turbo_frame_tag 'insidejoke' do %>
    <div class="flex gap-4">
    <%= link_to "Modifica", edit_operator_path(@operator), class: style_main_btn %>
    <%= button_to operator_path(@operator), method: :delete,
          class: "p-3 inline-flex items-center gap-1.5 tracking-wider rounded-sm uppercase text-xs cursor-pointer text-red-500 border border-red-500 hover:bg-red-50 transition",
          data: { turbo_frame: '_top', turbo_confirm: "Eliminare questo operatore?" } do %>
      <span class="material-symbols-outlined text-sm leading-none">delete</span>
      Elimina
    <% end %>
    </div>
    <div class="<%= form_container %>">
        <%= render @operator %>
    </div>
<% end %>
