<% menu = [
  { label: 'Dashboard', path: production_dashboard_path, active: true, icon: 'dashboard' },
  { label: 'Lanci', path: production_proformas_path, active: false, icon: 'checklist_rtl' },
  { label: 'Ricerca', path: production_research_path, active: false, icon: 'search_insights' },
] %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: { link: '/', label: 'Produzione / Dashboard', menu: menu } %>
</div>

<section class="<%= style_main_cnt %>">
  <div class="<%= style_main_card_grid %>">

    <div class="<%= style_main_card %> lg:col-span-2">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined text-slate-400">checklist_rtl</span>
        Ultimi Inserimenti
      </h3>
      <div class="divide-y divide-slate-100 -mx-6">
        <% @latest_proformas.each do |prof| %>
          <% varx = prof.prows.sum(:qty) %>
          <% totav = prof.prows.sum { |pr| GetAvanzamentoService.new.get(pr) } %>
          <%= link_to production_proforma_path(prof.id),
                class: "flex items-center justify-between px-6 py-3 hover:bg-slate-50 transition" do %>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium text-slate-800 truncate uppercase"><%= prof.customer %></div>
              <div class="text-xs text-slate-400">
                <%= prof.data_in&.strftime('%d-%m-%Y') %> · <%= varx %> articoli
              </div>
            </div>
            <div class="text-xs font-semibold text-indigo-700 ml-4 whitespace-nowrap">
              <%= varx > 0 ? calc_percentage(totav.to_f, varx.to_f) : 0 %>%
            </div>
          <% end %>
        <% end %>
        <% if @latest_proformas.empty? %>
          <div class="flex items-center justify-center h-32 text-sm text-slate-400 italic px-6">
            Nessun lancio aperto
          </div>
        <% end %>
      </div>
    </div>

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined text-slate-400">checklist_rtl</span>
        Lanci
      </h3>
      <div class="space-y-3">
        <%= link_to production_proformas_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700">Elenco Lanci</span>
          <span class="material-symbols-outlined text-slate-300 text-base">arrow_forward_ios</span>
        <% end %>
        <%= link_to production_research_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700">Ricerca Produzione</span>
          <span class="material-symbols-outlined text-slate-300 text-base">arrow_forward_ios</span>
        <% end %>
        <%= link_to production_research_qr_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700">Ricerca per QR</span>
          <span class="material-symbols-outlined text-slate-300 text-base">arrow_forward_ios</span>
        <% end %>
      </div>
    </div>

  </div>
</section>
