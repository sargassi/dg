<div id="<%= dom_id proforma %>" class="flex flex-col gap-4 p-4">
  <h3 class="font-bold">
    <%= proforma.customer %>
  </h3>
  <p>
    Proforma n. <%= proforma.id %> del <%= proforma.data_in.strftime('%d-%m-%Y') %>
  </p>
  <% if proforma.closed.present? %>
  <p>Chiusa: <%= proforma.data_out.strftime('%d-%m-%Y') %>
  </p>
    <% end %>
  <p>
    Note: <%= proforma.note %>
  </p>
</div>
