<% menu_research = [
  { label: 'Dashboard', path: production_dashboard_path, active: false, icon: 'dashboard' },
  { label: 'Lanci', path: production_proformas_path, active: false, icon: 'checklist_rtl' },
  { label: 'Ricerca', path: production_research_path, active: true, icon: 'search_insights' },
] %>
<div class="<%= style_main_header_container %>">
<%= render partial: 'atoms/header', locals: {link: '/', label: 'Produzione / Ricerca', menu: menu_research} %>
</div>

<section class="<%= style_main_cnt %> flex flex-col" style="height: calc(100vh - 140px);" data-controller="search-filter">
  <div class="flex gap-4 items-center mb-4 flex-none flex-wrap">
    <%= search_form_for @q, url: production_research_path, data: { search_filter_target: "form", turbo_frame: "rez" }, class: "contents" do |f| %>
      <div class="relative">
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-base pointer-events-none">search</span>
        <%= f.search_field :code_or_proforma_id_or_note_or_qr_or_materiale_or_color_or_origine_or_doe_cont,
              placeholder: "Cerca in tutte le colonne",
              data: { action: "input->search-filter#filter", search_filter_target: "input" },
              class: "#{style_search_input} rounded-lg pl-10 font-mono text-blue-600" %>
      </div>

      <span class="text-sm text-slate-500 whitespace-nowrap" data-search-filter-target="count"><%= @pagy.count if @pagy %> risultati</span>

      <% sel = params[:customer].presence || '' %>
      <%= select_tag 'customer', options_for_select(@profs.collect {|x| ["#{x.customer.upcase} - #{x.id} del #{x.data_in.strftime('%d-%m-%Y')}", x.id]}, sel), class: "w-80 bg-accent-100 uppercase text-xs border border-slate-300 outline-none px-3 py-2 text-sm ml-auto", include_blank: 'Tutti i lanci aperti', data: { action: 'change->search-filter#filter' } %>
    <% end %>
  </div>

  <style>
    turbo-frame#rez[busy] .items-table-content { display: none; }
    turbo-frame#rez[busy] .items-table-loader { display: flex; }
  </style>

  <%= turbo_frame_tag 'rez', class: "flex flex-col flex-1 min-h-0", data: { action: "turbo:frame-load->search-filter#onFrameLoad" } do %>
    <div class="items-table-content flex flex-col flex-1 min-h-0">
      <span hidden data-filtered-count><%= @pagy.count if @pagy %></span>
      <%= turbo_frame_tag 'prodside', class: "flex flex-col flex-1 min-h-0" do %>
        <%= render partial: 'atoms/search_rows' %>
        <%= render partial: 'atoms/ux/pagy' %>
      <% end %>
    </div>

    <div class="items-table-loader hidden justify-center items-center py-12">
      <svg class="animate-spin h-10 w-10 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span class="ml-3 text-slate-600">Ricerca in corso...</span>
    </div>
  <% end %>

  <%= render partial: 'atoms/ux/modal' %>
</section>
