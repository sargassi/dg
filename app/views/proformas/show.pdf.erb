<div id="et">
    <% counter = 0 %>
    <% i = 0 %>
        <% @rows.each do |product| %>

              <% qty = product.qty.to_i %>
               <% qty.times do %>
                   <div class="cell hor">

                   <div class="sub hor">
                    <% qr = CreateQrService.new %>
                    <%= image_tag(qr.call(product.qr).to_data_url) %>

                     <p>
                       <%= product.itemcode %> <%= product.fabricode %> <%= product.varcode %> <br>
                       <%= raw(product.description.gsub(/\R+/, '<br/>')) %>
                       <%= product.color %>
                       <%= product.materiale %>
                       tg <%= product.tg %>
                      </p>
                 </div>
                 <% counter = counter + 1 %>
                 </div>
           <% end %>
               <% if counter.modulo(24) == 0 %>
               <div style="clear:both; page-break-after: always;"></div>
               <% end %>

     <% end %>
</div>
