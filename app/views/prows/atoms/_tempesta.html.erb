<% queryx = {}
    if params[:q].is_a? String
        queryx = params[:q]
    else
        queryx = params[:q].to_unsafe_h if params[:q].present?
    end %>
<td class="<%= style_table_td_children %> w-1/6">
    <% qr = CreateQrService.new %>
    <%= image_tag(qr.call(tem.qrcode).to_data_url) if tem.qrcode.present? %>

</td>
<td class="<%= style_table_td_children %> w-1/6">
    <% if tem.f1 == true %>
    <% add_count_tempestas(chk, 1, 1) %>
    <% add_time_tempestas(chktime, tem.f1date, 1) %>
    <% end %>


    <%= turbo_frame_tag "temp-#{tem.id}" do %>
      <%= render partial: 'prows/atoms/state', locals:{tem:tem, chktime: chktime, chk: chk, dom: queryx, target: tem.f1 , stage: 'F1', temdate: tem.f1date , src:src } %>
    <% end %>
</td>
