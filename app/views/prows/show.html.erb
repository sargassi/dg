<% if params[:src].present? and params[:src] == 'fromapp' %>
x
<% else %>
  <script>
    document.addEventListener('turbo:load', () => {
      const urlParams = new URLSearchParams(window.location.search)
      const anchor = urlParams.get('row_anchor')
      if (anchor) {
        sessionStorage.setItem('highlightRow', anchor)
      }
    })
  </script>
  <%= turbo_frame_tag 'report' do %>
    <div class="fixed inset-0 bg-black/70 z-50 flex items-start justify-center pt-12 pb-8">
      <div class="relative bg-white rounded-sm shadow-lg w-[1200px] max-h-[90vh] overflow-y-auto p-6">

        <a href="#" onclick="document.querySelector('turbo-frame#report').innerHTML = ''; return false;"
           class="<%= style_close_btn(' absolute top-3 right-3 z-10 shadow') %>">
          <span class="material-symbols-outlined text-lg">close</span>
        </a>

        <% if params[:src].present? && params[:src] == 'searchplain' %>
          <%= render partial: 'atoms/actions', locals: {target: @prow, var: "prows", redir: "production/research", back: @proforma.id} %>

        <% elsif params[:src].present? and params[:src] == 'list' %>
          <%= render partial: 'atoms/actions', locals: {target: @prow, var: "prows", redir: "proformas/#{@proforma.id}", back: @proforma.id} %>
        <% end %>

        <%= render @prow %>
      </div>
    </div>
  <% end %>
<% end %>
