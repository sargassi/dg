<div class="mx-auto md:w-2/3 w-full flex">
  <div class="mx-auto">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
    <% end %>

    <%= render @rail %>

    <%= link_to 'Edit this rail', edit_rail_path(@rail), class: "mt-2 #{style_btn(variant: :neutral)}" %>
    <div class="inline-block ml-2">
      <%= button_to 'Destroy this rail', rail_path(@rail), method: :delete, class: "mt-2 #{style_btn(variant: :danger)}" %>
    </div>
    <%= link_to 'Back to rails', rails_path, class: "ml-2 #{style_btn(variant: :neutral)}" %>
  </div>
</div>
