<div id="<%= dom_id station %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= station.description %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Note:</strong>
    <%= station.note %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this station", station, class: "#{style_btn(variant: :neutral)}" %>
    <%= link_to "Edit this station", edit_station_path(station), class: "ml-2 #{style_btn(variant: :neutral)}" %>
    <hr class="mt-6">
  <% end %>
</div>
