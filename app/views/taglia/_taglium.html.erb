<div id="<%= dom_id taglium %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= taglium.description %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this taglium", taglium, class: "#{style_btn(variant: :neutral)}" %>
    <%= link_to 'Edit this taglium', edit_taglium_path(taglium), class: "ml-2 #{style_btn(variant: :neutral)}" %>
    <hr class="mt-6">
  <% end %>
</div>
