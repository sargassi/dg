<div id="<%= dom_id uom %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Code:</strong>
    <%= uom.code %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this uom", uom, class: "#{style_btn(variant: :neutral)}" %>
    <%= link_to "Edit this uom", edit_uom_path(uom), class: "ml-2 #{style_btn(variant: :neutral)}" %>
    <hr class="mt-6">
  <% end %>
</div>
