  <% i = 0 %>
  <% @etigroup.each do |craete, val| %>
    <% date = val.first.created_at if val.first.created_at.present? %>
    <% if i == 0 %>
      <h5 class="text-xs uppercase tracking-widest font-semibold text-slate-500 dark:text-slate-300 ml-2 -mt-4">
          Ultimo inserimento - <%= date.strftime('%d-%m-%Y') if defined?(date) %>
      </h5>
      <div class="w-full flex-wrap flex my-8">
        <% val.sort.each do |product| %>
          <%
            product.note.present? ? notez = 'notez' : notez = ''
            qty = product.qty.to_i
          %>
        <div class="cell w-1/3 h-64 py-4 overflow-hidden relative border border-slate-700 bg-white text-slate-800 mb-4 <%= notez %>" id="place-<%= product.id %>">
            <p> <%= product.itemcode %> <%= product.fabricode %><%= product.varcode %> </p>

            <p class="absolute top-2 right-4 rounded-full border border-slate-200 w-6 text-center text-slate-400"><%= qty %></p>

              <%= render partial: 'utilities/atoms/descr', locals: {product: product} %>

            <p>tg <%= product.tg %></p>

              <%= render partial: 'utilities/atoms/desc2', locals: {product: product} %>

            <p><%= product.materiale %></p>

                <%= render partial: 'utilities/atoms/notes', locals: {product: product, notez: notez} %>
            </div>
        <% end %>
      </div>
      <% i +=1 %>
    <% end %>
  <% end %>
