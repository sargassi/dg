  <% i = 0 %>
    <% @etigroup.each do |craete, val| %>
      <% date = val.first.created_at if val.first.created_at.present? %>
      <% if i == 0 %>
        <h5 class="mr-4  text-blue-900 text-xl">Ultimo inserimento - <%= date.strftime('%d-%m-%Y') if defined?(date) %></h5>
      <div class="w-full flex-wrap flex my-8">
        <% val.sort.each do |etilab| %>
            <div class="cell w-1/3 h-72 py-4 overflow-hidden relative border border-slate-700 mb-4" id="place-<%= etilab.id %>">
                <div class="absolute top-2 left-2 w-full">
                    <p class="flipV"> <%= etilab.itemcode %> <%= etilab.fabricode %><%= etilab.varcode %> </p>
                    <p class="flipV" style="text-align:right; margin-top: 3em"><%= etilab.season %></p>
                </div>
                <div class="absolute bottom-2 right-2 w-full">
                    <p style="text-align:right; margin-bottom: 3em"><%= etilab.season %></p>
                    <p> <%= etilab.itemcode %> <%= etilab.fabricode %><%= etilab.varcode %> </p>
                </div>
            </div>
        <% end %>
      </div>
      <% i +=1 %>
    <% end %>
    <% end %>
