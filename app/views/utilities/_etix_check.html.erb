<% counter = 1 %>
  <% i = 0 %>
  <% etix.each do |craete, val| %>

            <% if i == 0 %>
                <h5 class="mr-4  text-blue-900 text-xl">Ultimo inserimento</h5>
            <% i = i + 1 %>


             <div class="w-full flex-wrap flex my-8">
                 <% val.sort.each do |etilab| %>
                    <% if counter <= @etigroup.first[1].size %>
                   <%# vars %>
                   <% qty = etilab.qt.to_i %>

                 <div class="cell w-1/3 h-72 py-4 overflow-hidden relative border border-slate-700 mb-4" id="place-<%= etilab.id %>">
                     <div class="w-full text-end text-slate-400 relative">

                       <%= qty %>

                     </div>

                     <div class="m-0">
                         <div class="flex gap-4  mb-2 border-b">
                          <span class="font-semibold">articolo: </span>
                          <p><%= etilab.itemcode %>
                          <%= etilab.fabricode %>
                          <%= etilab.varcode %>
                          </p>
                         </div>
                         <div class="flex gap-4 w-full mb-2 border-b min-h-16">
                          <%= etilab.description %>

                           <%= etilab.fabric %>
                            <%= etilab.materiale %> <br>
                          <%= 'tg ' +  etilab.tg if etilab.tg.present? %>
                         </div>
                         </div>
                         <div class="flex gap-4 mb-2 border-b">
                          <span class="font-semibold">cliente: </span> <%= etilab.chi %>
                         </div>
                         <div class="flex gap-4 mb-2 border-b">
                          <span class="font-semibold">tagliato da: </span>
                         </div>
                         <div class="flex gap-4 mb-2 border-b">
                          <span class="font-semibold">cucito da: </span>
                         </div>
                         <div class="flex gap-4 mb-2 border-b">
                          <span class="font-semibold">lavato da: </span>
                         </div>
                         <div class="flex gap-4 mb-2 border-b">
                          <span class="font-semibold">controllato da: </span>
                         </div>
                     </div>

                 <% counter = counter + qty %>
                    <% end %>
                    <% end %>
             </div>


           <% end %>
    <% end %>
