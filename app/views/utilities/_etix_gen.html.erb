<% counter = 1 %>
  <% i = 0 %>
  <% etix.each do |craete, val| %>

            <% if i == 0 %>
                <h5 class="ml-2 -mt-4 text-xs uppercase tracking-widest font-semibold text-slate-500 dark:text-slate-300">Ultimo inserimento</h5>
            <% i = i + 1 %>


             <div class="w-full flex-wrap flex my-8">
                 <% val.sort.each do |etilab| %>
                    <% if counter <= @etigroup.first[1].size %>
                   <%# vars %>
                   <% qty = etilab.qty.to_i %>

                 <div class="cell w-1/3 h-72 py-4 overflow-hidden relative border border-slate-700 bg-white text-slate-800 mb-4" id="place-<%= etilab.id %>">
                     <div class="w-full text-end text-slate-400 relative">

                       <%= render partial: 'utilities/atoms/qty', locals: {etilab: etilab,  qty: qty} %>

                     </div>

                     <div class="mt-8">
                        <%= render partial: 'utilities/atoms/riga', locals: {etilab: etilab,  numero: 1} %>

                        <%= render partial: 'utilities/atoms/riga', locals: {etilab: etilab,  numero: 2} %>

                        <%= render partial: 'utilities/atoms/riga', locals: {etilab: etilab,  numero: 3} %>

                        <%= render partial: 'utilities/atoms/riga', locals: {etilab: etilab,  numero: 4} %>

                        <%= render partial: 'utilities/atoms/riga', locals: {etilab: etilab,  numero: 5} %>
                     </div>
                 </div>
                 <% counter = counter + qty %>
                    <% end %>
                    <% end %>
             </div>



           <% end %>
    <% end %>
