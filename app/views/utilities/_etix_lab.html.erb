  <% i = 0 %>
    <% @etigroup.each do |craete, val| %>
      <%  date = val.first.created_at if val.first.created_at.present?  %>
      <% if i == 0 %>

        <h5 class="mr-4  text-blue-900 text-xl">Ultimo inserimento - <%= date.strftime('%d-%m-%Y') if defined?(date) %></h5>

      <div class="w-full flex-wrap flex my-8">
        <% val.sort.each do |etilab| %>
          <% # vars
            etilab.note.present? ? notez = 'notez' : notez = ''
            qty = etilab.qty.to_i
          %>

            <div class="cell w-1/3 h-72 py-4 overflow-hidden relative border border-slate-700 mb-4 <%= notez %>" id="place-<%= etilab.id %>">

              <p> <%= etilab.itemcode %> <%= etilab.fabricode %><%= etilab.varcode %> </p>

              <p class="absolute top-2 right-4 rounded-full border border-slate-200 w-6 text-center text-slate-400"><%= qty %></p>

                <%= render partial: 'utilities/atoms/descr', locals: {product: etilab} %>

                <p>Cliente <%= etilab.p %></p>
                <p>Tg <%= etilab.tg %></p>

                <%= render partial: 'utilities/atoms/desc2', locals: {product: etilab} %>

                <p><%= etilab.materiale %>  </p>

                <%= render partial: 'utilities/atoms/desc3', locals: {product: etilab} %>

                <%= render partial: 'utilities/atoms/notes', locals: {product: etilab, notez: notez} %>


            </div>


        <% end %>
      </div>
      <% i +=1 %>
    <% end %>
    <% end %>
