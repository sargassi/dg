<%= turbo_frame_tag :color do  %>
 <% product.color.size > 50 ? alert = 'bg-amber-200' : alert = '' %>
  <div class="flex justify-between mb-2 border-b <%= alert %>">
    <span class="leading-tight  block mr-4"><%= raw(product.color.gsub(/\R+/, '<br/>')) %> </span> <%= link_to [:edit, product, attribute: :color ], class:"no-pdf text-end text-xs uppercase text-blue-500 font-bold" do %>

      <span class="material-symbols-outlined">
        edit
      </span>
      <% end %>
  </div>
<% end %>
