<%= turbo_frame_tag "color-#{product.id}" do  %>
 <% !product.color.nil? && ( product.color.size > 50)  ? alert = 'bg-amber-200' : alert = '' %>
  <div class="flex justify-between mb-2 border-b <%= alert %>">
    <span class="leading-tight  block mr-4"><%= raw(product.color.gsub(/\R+/, '<br/>')) if !product.color.nil? %> </span> <%= link_to [:edit, product, attribute: :color ], class:"no-pdf text-end text-xs uppercase text-accent-600 font-bold" do %>

      <%= icon_edit %>

      <% end %>
  </div>
<% end %>
