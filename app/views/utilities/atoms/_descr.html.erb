<%= turbo_frame_tag "description-#{product.id}" do  %>
  <div class="flex justify-between mb-2 border-b">
    <span class="leading-tight block"><%= raw(product.description.gsub(/\R+/, '<br/>')) if !product.description.nil? %> </span> <%= link_to [:edit, product, attribute: :description ], class:"no-pdf text-end text-xs uppercase text-accent-600 font-bold" do %>
      <%= icon_edit %>

      <% end %>
  </div>
<% end %>
