<% riga = "#{etilab.id}-riga#{numero.to_s}" if numero.present? %>
<%= turbo_frame_tag riga do  %>

  <div class="flex justify-between mb-2 border-b">
    <span class="leading-tight  block mr-4"><%= out_line(etilab, numero)  %> </span> <%= link_to [:edit, etilab, :numero => numero], class:"no-pdf text-end text-xs uppercase text-blue-500 font-bold" do %>

      <%= icon_edit %>

      <% end %>
  </div>
<% end %>
