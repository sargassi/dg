<% content_for :page_header do %>
<%= render "application/breadcrumb", dashboard_path: utilities_dashboard_path, section_name: "Utilità" %>
<% end %>

<section class="<%= style_main_cnt %> space-y-8">
  <div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <%= link_to utilities_etichette_path, class: "bg-blue-50 dark:bg-blue-900/20 p-4 card flex flex-col items-center justify-center text-center aspect-square shadow-md hover:bg-blue-100 dark:hover:bg-blue-900/40 transition" do %>
        <span class="material-symbols-outlined text-4xl text-blue-600 dark:text-blue-400 mb-2">bookmark_check</span>
        <span class="text-lg font-semibold text-slate-700 dark:text-slate-200">Etichette Proforma</span>
        <p class="text-muted text-xs mt-1">Stampa etichette proforma</p>
      <% end %>

      <%= link_to utilities_etichette_gen_path, class: "bg-blue-50 dark:bg-blue-900/20 p-4 card flex flex-col items-center justify-center text-center aspect-square shadow-md hover:bg-blue-100 dark:hover:bg-blue-900/40 transition" do %>
        <span class="material-symbols-outlined text-4xl text-blue-600 dark:text-blue-400 mb-2">print</span>
        <span class="text-lg font-semibold text-slate-700 dark:text-slate-200">Etichette Generiche</span>
        <p class="text-muted text-xs mt-1">Stampa etichette generiche</p>
      <% end %>

      <%= link_to utilities_etichette_lab_path, class: "bg-blue-50 dark:bg-blue-900/20 p-4 card flex flex-col items-center justify-center text-center aspect-square shadow-md hover:bg-blue-100 dark:hover:bg-blue-900/40 transition" do %>
        <span class="material-symbols-outlined text-4xl text-blue-600 dark:text-blue-400 mb-2">biotech</span>
        <span class="text-lg font-semibold text-slate-700 dark:text-slate-200">Etichette Laboratorio</span>
        <p class="text-muted text-xs mt-1">Stampa etichette laboratorio</p>
      <% end %>
    </div>
  </div>

  <div class="<%= style_main_card_grid %>">

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">bookmark_check</span>
        Etichette Ufficio
      </h3>
      <div class="space-y-3">
        <%= link_to utilities_etichette_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Etichette Proforma</span>
          <span class="material-symbols-outlined text-slate-400 dark:text-slate-300 text-base">arrow_forward_ios</span>
        <% end %>


        <%= link_to utilities_etichette_gen_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Etichette Generiche</span>
          <span class="material-symbols-outlined text-slate-400 dark:text-slate-300 text-base">arrow_forward_ios</span>
        <% end %>

      </div>
    </div>

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">description</span>
        Etichette Laboratorio
      </h3>
      <div class="space-y-3">
          <%= link_to utilities_etichette_lab_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Etichette Laboratorio</span>
          <span class="material-symbols-outlined text-slate-400 dark:text-slate-300 text-base">arrow_forward_ios</span>
          <% end %>
          <%= link_to utilities_etichette_camp_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Etichette Campione</span>
          <span class="material-symbols-outlined text-slate-400 dark:text-slate-300 text-base">arrow_forward_ios</span>
          <% end %>
          <%= link_to utilities_etichette_check_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Etichette Taglio</span>
          <span class="material-symbols-outlined text-slate-400 dark:text-slate-300 text-base">arrow_forward_ios</span>
          <% end %>

      </div>
    </div>

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">apps</span>
        Altre Sezioni
      </h3>
      <div class="flex items-center justify-center h-32 text-sm text-slate-400 dark:text-slate-300 italic">
        Da implementare...
      </div>
    </div>

  </div>
</section>
