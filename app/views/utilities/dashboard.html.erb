<% content_for :page_header do %>
<div class="flex items-center gap-2 px-0 py-0.5">
  <h1 class="text-sm font-semibold text-slate-500 dark:text-slate-400 tracking-wide">
    Utilità
  </h1>
</div>
<% end %>

<section class="<%= style_main_cnt %>">
  <div class="<%= style_main_card_grid %>">

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">bookmark_check</span>
        Etichette Ufficio
      </h3>
      <div class="space-y-3">
        <%= link_to utilities_etichette_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Etichette Proforma</span>
          <span class="material-symbols-outlined text-slate-400 dark:text-slate-300 text-base">arrow_forward_ios</span>
        <% end %>


        <%= link_to utilities_etichette_gen_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Etichette Generiche</span>
          <span class="material-symbols-outlined text-slate-400 dark:text-slate-300 text-base">arrow_forward_ios</span>
        <% end %>

      </div>
    </div>

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">description</span>
        Etichette Laboratorio
      </h3>
      <div class="space-y-3">
          <%= link_to utilities_etichette_lab_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Etichette Laboratorio</span>
          <span class="material-symbols-outlined text-slate-400 dark:text-slate-300 text-base">arrow_forward_ios</span>
          <% end %>
          <%= link_to utilities_etichette_camp_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Etichette Campione</span>
          <span class="material-symbols-outlined text-slate-400 dark:text-slate-300 text-base">arrow_forward_ios</span>
          <% end %>
          <%= link_to utilities_etichette_check_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700 dark:text-slate-200">Etichette Taglio</span>
          <span class="material-symbols-outlined text-slate-400 dark:text-slate-300 text-base">arrow_forward_ios</span>
          <% end %>

      </div>
    </div>

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">apps</span>
        Altre Sezioni
      </h3>
      <div class="flex items-center justify-center h-32 text-sm text-slate-400 dark:text-slate-300 italic">
        Da implementare...
      </div>
    </div>

  </div>
</section>
