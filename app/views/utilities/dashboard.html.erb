<% menu = [
  { label: 'Dashboard Etichette', path: utilities_dashboard_path, active: true, icon: 'dashboard' },
  { label: 'Proforma', path: utilities_etichette_path, active: false, icon: 'label' },
  { label: 'Generiche', path: utilities_etichette_gen_path, active: false, icon: 'description' },
  { label: 'Laboratorio', path: utilities_etichette_lab_path, active: false, icon: 'science' },
  { label: 'Campione', path: utilities_etichette_camp_path, active: false, icon: 'agriculture' },
  { label: 'Lavaggio etc', path: utilities_etichette_check_path, active: false, icon: 'agriculture' },
] %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: {link: '/', label: 'Utility / Dashboard', menu: menu} %>
</div>

<section class="<%= style_main_cnt %>">
  <div class="<%= style_main_card_grid %>">

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">bookmark_check</span>
        Etichette Ufficio
      </h3>
      <div class="space-y-3">
        <%= link_to utilities_etichette_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700">Etichette Proforma</span>
          <span class="material-symbols-outlined text-slate-400 text-base">arrow_forward_ios</span>
        <% end %>


        <%= link_to utilities_etichette_gen_path, class: style_main_card_link do %>
          <span class="text-sm text-slate-700">Etichette Generiche</span>
          <span class="material-symbols-outlined text-slate-400 text-base">arrow_forward_ios</span>
        <% end %>

      </div>
    </div>

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">description</span>
        Etichette Laboratorio
      </h3>
      <div class="space-y-3">
          <%= link_to utilities_etichette_lab_path, class: style_main_card_link do %>
            <span class="text-sm text-slate-700">Etichette Laboratorio</span>
            <span class="material-symbols-outlined text-slate-400 text-base">arrow_forward_ios</span>
          <% end %>
          <%= link_to utilities_etichette_camp_path, class: style_main_card_link do %>
            <span class="text-sm text-slate-700">Etichette Campione</span>
            <span class="material-symbols-outlined text-slate-400 text-base">arrow_forward_ios</span>
          <% end %>
          <%= link_to utilities_etichette_check_path, class: style_main_card_link do %>
            <span class="text-sm text-slate-700">Etichette Lavaggio etc</span>
            <span class="material-symbols-outlined text-slate-400 text-base">arrow_forward_ios</span>
          <% end %>

      </div>
    </div>

    <div class="<%= style_main_card %>">
      <h3 class="<%= style_main_card_header %>">
        <span class="material-symbols-outlined">apps</span>
        Altre Sezioni
      </h3>
      <div class="flex items-center justify-center h-32 text-sm text-slate-400 italic">
        Da implementare...
      </div>
    </div>

  </div>
</section>
