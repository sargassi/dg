<%= form_with(model: warehouse, class: "contents", data: { turbo_frame: "_top" }) do |form| %>
  <% if warehouse.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium mt-3 border border-red-200">
      <h2><%= pluralize(warehouse.errors.count, "error") %> prohibited this warehouse from being saved:</h2>

      <ul>
        <% warehouse.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :code, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
    <%= form.text_field :code, class: "border border-slate-300 outline-none px-3 py-2 mt-2 w-full text-sm" %>
  </div>

  <div class="my-5">
    <%= form.label :address, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
    <%= form.text_field :address, class: "border border-slate-300 outline-none px-3 py-2 mt-2 w-full text-sm" %>
  </div>

  <div class="my-5">
    <%= form.label :city, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
    <%= form.text_field :city, class: "border border-slate-300 outline-none px-3 py-2 mt-2 w-full text-sm" %>
  </div>

  <div class="my-5">
    <%= form.label :cap, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
    <%= form.text_field :cap, class: "border border-slate-300 outline-none px-3 py-2 mt-2 w-full text-sm" %>
  </div>

  <div class="my-5">
    <%= form.label :civic, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
    <%= form.text_field :civic, class: "border border-slate-300 outline-none px-3 py-2 mt-2 w-full text-sm" %>
  </div>

  <div class="my-5">
    <%= form.label :latitude, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
    <%= form.text_field :latitude, class: "border border-slate-300 outline-none px-3 py-2 mt-2 w-full text-sm" %>
  </div>

  <div class="my-5">
    <%= form.label :longitude, class: "text-xs text-slate-400 uppercase tracking-wide block mb-1" %>
    <%= form.text_field :longitude, class: "border border-slate-300 outline-none px-3 py-2 mt-2 w-full text-sm" %>
  </div>

  <% if warehouse.persisted? && warehouse.qrcode_svg.present? %>
    <div class="my-5 flex items-center gap-4 p-3 bg-slate-50 rounded-sm">
      <span class="inline-block w-12 h-12"><%= warehouse.qrcode_svg.html_safe %></span>
      <div>
        <div class="text-xs text-slate-400 uppercase tracking-wide mb-1">QR Code</div>
        <div class="text-xs font-mono text-slate-600"><%= warehouse.gencode %></div>
      </div>
    </div>
  <% end %>

  <div>
    <%= form.submit class: style_import_btn %>
  </div>
<% end %>
