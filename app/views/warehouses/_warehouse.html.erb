<div id="<%= dom_id warehouse %>" class="flex items-center justify-between py-2 px-3 border-b border-slate-200 hover:bg-slate-50">
  <div class="flex gap-3 items-baseline">
    <span class="text-sm font-semibold text-slate-800"><%= warehouse.code %></span>
    <span class="text-xs text-slate-400"><%= warehouse.city %></span>
  </div>
  <div class="flex gap-1 items-center">
    <%= link_to edit_warehouse_path(warehouse), data: { turbo_frame: "warehouse_modal" }, class: "p-2 text-blue-500 hover:text-blue-700" do %>
      <span class="material-symbols-outlined text-xl">edit</span>
    <% end %>
    <%= button_to warehouse_path(warehouse), method: :delete, data: { turbo_frame: "_top" }, class: "p-2 text-red-400 hover:text-red-600" do %>
      <span class="material-symbols-outlined text-xl">close</span>
    <% end %>
  </div>
</div>
