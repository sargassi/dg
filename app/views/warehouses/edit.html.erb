<%= turbo_frame_tag "warehouse_modal" do %>
  <div class="fixed inset-0 bg-black/40 z-50 flex items-center justify-center" data-controller="modal" data-action="keydown.esc->modal#close click->modal#backdropClose">
    <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between p-4 border-b border-slate-200">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-600">Modifica Magazzino</h2>
        <%= link_to warehouses_path, class: "text-slate-400 hover:text-slate-600", data: { turbo_frame: "_top" } do %>
          <span class="material-symbols-outlined text-base">close</span>
        <% end %>
      </div>
      <div class="p-4">
        <div class="bg-white border border-slate-200 shadow-sm p-6">
          <%= render 'form', warehouse: @warehouse %>
        </div>
      </div>
    </div>
  </div>
<% end %>
