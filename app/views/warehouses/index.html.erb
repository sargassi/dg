<% content_for :page_header do %>
<div class="flex items-center gap-2 px-0 py-0.5">
  <h1 class="text-sm font-semibold text-slate-500 dark:text-slate-400 tracking-wide">
    Magazzini
  </h1>
</div>
<% end %>

<section class="<%= style_main_cnt %>">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 text-green-500 font-medium rounded-lg inline-block mb-5" id="notice"><%= notice %></p>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

    <div>
      <div class="<%= style_main_card %>">
        <h3 class="<%= style_main_card_header %>">
          <span class="material-symbols-outlined">warehouse</span>
          Magazzini
          <span class="<%= style_main_card_badge %>"><%= @warehouses.count %></span>
        </h3>
        <div id="warehouses" class="space-y-0">
          <%= render @warehouses %>
          <% if @warehouses.empty? %>
            <div class="text-sm text-slate-400 italic py-4">Nessun magazzino configurato</div>
          <% end %>
        </div>
      </div>
    </div>

    <div>
      <div class="<%= style_main_card %> mb-8">

        <%= form_with(model: @warehouse, class: "contents") do |form| %>
          <% if @warehouse.errors.any? %>
            <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium mb-4 border border-red-200 text-sm">
              <h2><%= pluralize(@warehouse.errors.count, "error") %> impediscono il salvataggio:</h2>
              <ul class="mt-1 list-disc list-inside">
                <% @warehouse.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid grid-cols-[2fr_auto_auto] gap-6 items-end mb-4">
            <div>
              <%= form.label 'Descrizione magazzino', class: "text-xs text-slate-400 tracking-wide block mb-1" %>
              <%= form.text_field :code, class: "border border-slate-300 outline-none px-3 py-2 w-full text-sm", placeholder: "Descrizione magazzino", required: true %>
            </div>
            <div>
              <%= style_toggle_switch(form, :enabled, "Abilitato") %>
            </div>
            <div>
              <%= form.submit "Crea Magazzino", class: "p-3 #{style_save_button} inline-block tracking-wider rounded-sm text-xs cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="<%= style_main_card %>">

        <%= form_with(model: @location, url: locations_path, class: "contents") do |form| %>
          <% if @location.errors.any? %>
            <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium mb-4 border border-red-200 text-sm">
              <h2><%= pluralize(@location.errors.count, "error") %> impediscono il salvataggio:</h2>
              <ul class="mt-1 list-disc list-inside">
                <% @location.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid grid-cols-[1fr_1fr_auto_auto] gap-3 items-end mb-4">
            <div>
              <%= form.label "Descrizione ubica", class: "text-xs text-slate-400 tracking-wide block mb-1" %>
              <%= form.text_field :code, class: "border border-slate-300 outline-none px-3 py-2 w-full text-sm", placeholder: "Descrizione ubica", required: true %>
            </div>
            <div>
              <%= form.label :warehouse_id, "Magazzino", class: "text-xs text-slate-400 tracking-wide block mb-1" %>
              <%= form.collection_select :warehouse_id, Warehouse.all, :id, :code, { prompt: "Seleziona magazzino" }, class: "border border-slate-300 outline-none px-3 py-2 w-full text-sm", required: true %>
            </div>
            <div>
              <%= style_toggle_switch(form, :enabled, "Abilitata") %>
            </div>
            <div>
              <%= form.submit "Crea Ubica", class: "p-3 #{style_save_button} inline-block tracking-wider rounded-sm text-xs cursor-pointer" %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-10 flex justify-end mr-6 gap-3">
        <%= link_to merge_warehouses_path, class: "inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-sm transition-colors" do %>
          <span class="material-symbols-outlined text-base">merge</span>
          Unisci magazzini
        <% end %>
        <%= link_to qrcodes_warehouses_path, target: :_blank, class: "inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium text-white bg-red-600 hover:bg-red-700 rounded-sm transition-colors" do %>
          <span class="material-symbols-outlined text-base">qr_code</span>
          QR Resume
        <% end %>
      </div>

      <%= turbo_frame_tag "warehouse_modal" %>
    </div>

  </div>
</section>
