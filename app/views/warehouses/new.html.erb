<% menu = [
  { label: 'Dashboard', path: mainware_dashboard_path, active: false, icon: 'dashboard' },
  { label: 'Articoli', path: mainware_index_path, active: false, icon: 'inventory_2' },
  { label: 'Magazzini', path: warehouses_path, active: true, icon: 'warehouse' },
  { label: 'Ubiche', path: locations_path, active: false, icon: 'location_on' },
] %>
<div class="<%= style_main_header_container %>">
  <%= render partial: 'atoms/header', locals: {link: '/', label: 'Generale / Magazzini / Nuovo', menu: menu} %>
</div>
<section class="<%= style_main_cnt %>">
  <%= render "form", warehouse: @warehouse %>

  <div class="mt-4">
    <%= link_to "Indietro", warehouses_path, class: "#{style_import_btn} bg-gray-400" %>
  </div>
</section>
